---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Joain Monroy - Perfil Profesional">
	<main class="min-h-screen bg-white dark:bg-black text-gray-900 dark:text-white transition-colors duration-500">
		<!-- Header -->
		<section class="relative min-h-screen flex items-center justify-center px-4 md:px-8 py-20">
			<div class="max-w-4xl mx-auto w-full">
				<!-- Intro -->
				<div class="mb-20">
					<p class="text-sm font-mono uppercase tracking-widest text-gray-500 dark:text-gray-400 mb-4">Sobre mí</p>
					<h1 class="text-6xl md:text-7xl font-bold tracking-tight mb-8">
						Ingeniero en Informática
					</h1>
					<p class="text-xl text-gray-600 dark:text-gray-400 leading-relaxed max-w-2xl">
						Especializado en desarrollo full-stack, arquitectura de sistemas escalables y experiencias digitales modernas. Apasionado por soluciones innovadoras y código limpio.
					</p>
				</div>

				<!-- Bio -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-20">
					<div>
						<h3 class="text-sm font-mono uppercase tracking-widest text-gray-500 dark:text-gray-400 mb-4">Experiencia</h3>
						<ul class="space-y-4">
							<li class="border-l-2 border-gray-200 dark:border-gray-800 pl-4">
								<p class="font-semibold">Práctica Profesional</p>
								<p class="text-sm text-gray-600 dark:text-gray-400">Mar 2025 - Presente</p>
							</li>
							<li class="border-l-2 border-gray-200 dark:border-gray-800 pl-4">
								<p class="font-semibold">Desarrollo Full Stack</p>
								<p class="text-sm text-gray-600 dark:text-gray-400">Proyectos freelance</p>
							</li>
						</ul>
					</div>

					<div>
						<h3 class="text-sm font-mono uppercase tracking-widest text-gray-500 dark:text-gray-400 mb-4">Formación</h3>
						<ul class="space-y-4">
							<li class="border-l-2 border-gray-200 dark:border-gray-800 pl-4">
								<p class="font-semibold">Desarrollo Full Stack</p>
								<p class="text-sm text-gray-600 dark:text-gray-400">INACAP • 2025</p>
							</li>
							<li class="border-l-2 border-gray-200 dark:border-gray-800 pl-4">
								<p class="font-semibold">Git Fundamentals</p>
								<p class="text-sm text-gray-600 dark:text-gray-400">DataCamp • 2025</p>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<!-- Skills -->
		<section class="relative py-32 px-4 md:px-8 bg-gray-50 dark:bg-gray-950">
			<div class="max-w-4xl mx-auto">
				<h2 class="text-4xl font-bold mb-16">Habilidades Técnicas</h2>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<!-- Frontend -->
					<div class="p-6 rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800">
						<h3 class="text-xl font-semibold mb-4">Frontend</h3>
						<ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
							<li>• React / Next.js</li>
							<li>• Astro</li>
							<li>• Tailwind CSS</li>
							<li>• TypeScript</li>
							<li>• GSAP & Animations</li>
						</ul>
					</div>

					<!-- Backend -->
					<div class="p-6 rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800">
						<h3 class="text-xl font-semibold mb-4">Backend</h3>
						<ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
							<li>• Django / Python</li>
							<li>• Node.js</li>
							<li>• REST APIs</li>
							<li>• SQL & NoSQL</li>
							<li>• DevOps</li>
						</ul>
					</div>

					<!-- Tools -->
					<div class="p-6 rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800">
						<h3 class="text-xl font-semibold mb-4">Tools & Otros</h3>
						<ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
							<li>• Git & GitHub</li>
							<li>• Docker</li>
							<li>• AWS</li>
							<li>• Figma</li>
							<li>• Agile / Scrum</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA -->
		<section class="relative py-32 px-4 md:px-8">
			<div class="max-w-4xl mx-auto text-center">
				<h2 class="text-4xl font-bold mb-6">¿Quieres saber más?</h2>
				<p class="text-lg text-gray-600 dark:text-gray-400 mb-8">
					Descubre mis proyectos o ponte en contacto conmigo.
				</p>
				<div class="flex flex-col md:flex-row gap-4 justify-center">
					<a
						href="/"
						class="inline-block px-8 py-3 bg-gray-900 dark:bg-white text-white dark:text-black rounded-full font-semibold hover:shadow-lg transition-all"
					>
						Ver Proyectos
					</a>
					<a
						href="/contact"
						class="inline-block px-8 py-3 bg-gray-200 dark:bg-gray-900 text-gray-900 dark:text-white rounded-full font-semibold hover:shadow-lg transition-all"
					>
						Contactar
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>
