---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GSAP Text Rotate PoC</title>
</head>
<body class="overflow-x-hidden m-0 bg-gray-900">

<!-- CONTENEDOR PIN MASTER -->
<div id="pinMaster" class="h-screen w-full relative overflow-hidden bg-black flex items-center justify-center">
    
    <!-- Fondos de prueba -->
    <div class="bg absolute inset-0 z-10" style="background-color: #ef4444;"></div>
    <div class="bg absolute inset-0 z-20 opacity-0" style="background-color: #3b82f6;"></div>
    <div class="bg absolute inset-0 z-30 opacity-0" style="background-color: #10b981;"></div>
    <div class="bg absolute inset-0 z-40 opacity-0" style="background-color: #8b5cf6;"></div>

    <!-- Títulos superpuestos en el centro -->
    <div class="relative z-50 w-full h-full">
        <h1 class="title absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-8xl text-white font-bold whitespace-nowrap overflow-hidden py-4">PANEL UNO</h1>
        <h1 class="title absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-8xl text-white font-bold whitespace-nowrap overflow-hidden py-4 opacity-0">PANEL DOS</h1>
        <h1 class="title absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-8xl text-white font-bold whitespace-nowrap overflow-hidden py-4 opacity-0">PANEL TRES</h1>
        <h1 class="title absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-8xl text-white font-bold whitespace-nowrap overflow-hidden py-4 opacity-0">PANEL CUATRO</h1>
    </div>

</div>

<div class="h-screen bg-gray-900 flex items-center justify-center">
    <h2 class="text-white text-4xl">Fin de la animación</h2>
</div>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import Lenis from "lenis";

    gsap.registerPlugin(ScrollTrigger);

    let lenis: any;

    const init = () => {
        if (lenis) {
            lenis.destroy();
            ScrollTrigger.killAll();
        }

        lenis = new Lenis({
            duration: 1.2,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            smoothWheel: true,
        });

        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => {
            lenis.raf(time * 1000);
        });
        gsap.ticker.lagSmoothing(0);

        const bgs = gsap.utils.toArray(".bg") as HTMLElement[];
        const titles = gsap.utils.toArray(".title") as HTMLElement[];

        // 1. Dividir los textos en letras para poder hacer el "stagger"
        titles.forEach(title => {
            const text = title.textContent || "";
            title.innerHTML = ""; // Vaciamos
            text.split("").forEach(char => {
                const span = document.createElement("span");
                span.textContent = char === " " ? "\u00A0" : char;
                span.style.display = "inline-block";
                span.style.willChange = "transform, opacity";
                span.classList.add("char");
                title.appendChild(span);
            });
        });

        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: "#pinMaster",
                start: "top top",
                end: `+=${bgs.length * 100}%`,
                pin: true,
                scrub: 1, // Inertia enlazada a la rueda
                snap: {
                    snapTo: 1 / (bgs.length - 1),
                    duration: { min: 0.2, max: 0.5 },
                    ease: "power1.inOut"
                },
                markers: true
            }
        });

        bgs.forEach((bg, i) => {
            if (i === 0) {
                // El primer título es visible
                gsap.set(titles[i], { opacity: 1 });
                return;
            }

            const prevBg = bgs[i - 1];
            const prevTitle = titles[i - 1];
            const currTitle = titles[i];

            const prevChars = prevTitle.querySelectorAll('.char');
            const currChars = currTitle.querySelectorAll('.char');

            // Preparar los caracteres del nuevo título escondidos abajo
            gsap.set(currTitle, { opacity: 1 }); // Mostramos el contenedor
            gsap.set(currChars, { y: "120%", opacity: 0 }); // Escondemos las letras

            // Pequeña pausa antes de cambiar
            tl.to({}, { duration: 0.2 });

            // Animar las letras del título ANTERIOR saliendo hacia arriba
            tl.to(prevChars, {
                y: "-120%",
                opacity: 0,
                stagger: 0.02, // Retraso entre cada letra
                duration: 0.4,
                ease: "power2.inOut"
            }, `transition${i}`);

            // Cambiar el fondo
            tl.to(bg, {
                opacity: 1,
                duration: 0.6,
                ease: "power2.inOut"
            }, `transition${i}`);

            // Animar las letras del título NUEVO entrando desde abajo
            // Le damos un pequeño retraso (+=0.1) para que se crucen fluidamente
            tl.to(currChars, {
                y: "0%",
                opacity: 1,
                stagger: 0.02, // Retraso entre cada letra
                duration: 0.4,
                ease: "power2.out"
            }, `transition${i}+=0.1`);
        });

        // Pausa final
        tl.to({}, { duration: 0.2 });
    };

    document.addEventListener('astro:page-load', init);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
        init();
    } else {
        document.addEventListener('DOMContentLoaded', init);
    }
</script>
</body>
</html>
