---
import Layout from '../../layouts/Layout.astro';
import { getProjectById, getAllProjects } from '../../data/projects';

export function getStaticPaths() {
	const projects = getAllProjects();
	return projects.map((project) => ({
		params: { id: project.id },
	}));
}

const { id } = Astro.params;
const project = getProjectById(id);
const allProjects = getAllProjects();

if (!project) {
	return Astro.redirect('/404');
}
---

<Layout title={`${project.title} - Joain Monroy`} showHeader={true}>
	<main class="project-detail" style={`background-color: ${project.backgroundColor || 'var(--white)'}`}>
		
		<div class="header-spacer"></div>

		<div class="project-container">
			<!-- Sticky Info Sidebar -->
			<div class="project-info">
				<div class="info-inner">
					<header class="project-header">
						<h1>{project.title}</h1>
						<p class="subtitle">{project.subtitle}</p>
					</header>
					
					<div class="description">
						<p>{project.description}</p>
						{project.fullDescription && <p class="mt-4">{project.fullDescription}</p>}
					</div>
					
					<div class="tags">
						{project.tags.map(tag => (
							<span class="tag">{tag}</span>
						))}
					</div>
				</div>
			</div>
			
			<!-- Scrolling Gallery -->
			<div class="project-gallery">
				{project.images.map((img, idx) => (
					<div class="gallery-item">
						<img src={img} alt={`${project.title} - ${idx + 1}`} loading="lazy" />
					</div>
				))}
			</div>
		</div>
		
	</main>
</Layout>

<style>
	.project-detail {
		min-height: 100vh;
		width: 100%;
		/* The background color is set dynamically via inline style, ensuring it matches the project's theme */
		color: var(--black);
		padding: 0 50px 100px 50px;
		transition: background-color 0.5s ease;
	}
	
	.header-spacer {
		height: 150px;
	}

	.project-container {
		display: grid;
		grid-template-columns: 400px 1fr;
		gap: 100px;
		max-width: 1600px;
		margin: 0 auto;
		align-items: start; /* crucial for sticky to work */
	}
	
	/* Sticky Left Column */
	.project-info {
		position: sticky;
		top: 150px; /* Offset for the header */
		/* Ensure text color adapts correctly if the background is dark */
		mix-blend-mode: difference;
		color: var(--white);
	}
	
	.project-header {
		margin-bottom: 40px;
	}
	
	.project-header h1 {
		font-family: var(--font-sans);
		font-size: clamp(32px, 4vw, 56px);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.04em;
		text-transform: uppercase;
		margin-bottom: 12px;
	}
	
	.project-header .subtitle {
		font-family: var(--font-sans);
		font-size: 14px;
		font-weight: 500;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		opacity: 0.7;
	}
	
	.description {
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: 1.6;
		margin-bottom: 50px;
		font-weight: 400;
		opacity: 0.8;
	}
	
	.tags {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
	}
	
	.tag {
		font-family: var(--font-sans);
		font-size: 12px;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: 8px 16px;
		border: 1px solid rgba(255,255,255,0.3);
		border-radius: 30px;
	}
	
	/* Right Column Gallery */
	.project-gallery {
		display: flex;
		flex-direction: column;
		gap: 80px;
	}
	
	.gallery-item img {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 4px;
		box-shadow: 0 20px 40px rgba(0,0,0,0.1);
	}
	
	@media (max-width: 1024px) {
		.project-container {
			grid-template-columns: 300px 1fr;
			gap: 50px;
		}
	}
	
	@media (max-width: 768px) {
		.project-detail {
			padding: 0 24px 50px 24px;
		}
		
		.header-spacer {
			height: 100px;
		}

		.project-container {
			grid-template-columns: 1fr;
			gap: 60px;
		}
		
		.project-info {
			position: static;
			margin-bottom: 20px;
		}
	}
</style>