---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { getProjectById, getAllProjects } from '../../data/projects';

export function getStaticPaths() {
	const projects = getAllProjects();
	return projects.map((project) => ({
		params: { id: project.id },
	}));
}

const { id } = Astro.params;
const project = getProjectById(id);
const allProjects = getAllProjects();

if (!project) {
	return Astro.redirect('/404');
}

// Circular search for the next project
const currentIndex = allProjects.findIndex(p => p.id === id);
const nextProject = allProjects[(currentIndex + 1) % allProjects.length];

// Contrast calculations based on the brand color
const isDarkHero = project.backgroundColor === '#1c1c1c';
const textColorClass = isDarkHero ? 'text-white' : 'text-gray-900';
const textMutedClass = isDarkHero ? 'text-white/60' : 'text-gray-600';
const borderClass = isDarkHero ? 'border-white/10' : 'border-gray-900/10';
const badgeBgClass = isDarkHero ? 'bg-white/5 border-white/10 text-white hover:bg-white/10' : 'bg-gray-900/5 border-gray-900/10 text-gray-900 hover:bg-gray-900/10';
---

<Layout title={`${project.title} - Caso de Estudio - Joain Monroy`} showHeader={true}>
	<main class="relative bg-white text-gray-900 dark:bg-black dark:text-white min-h-screen overflow-hidden transition-colors duration-500">
		
		<!-- BRAND HERO BANNER -->
		<section 
			id="project-hero"
			data-is-dark={isDarkHero ? 'true' : 'false'}
			class="w-full relative pt-40 pb-32 md:pt-48 md:pb-40 transition-colors duration-500" 
			style={`background-color: ${project.backgroundColor}`}
		>
			<div class="max-w-7xl mx-auto px-6 sm:px-12 md:px-24">
				
				<!-- Go back button -->
				<a 
					href="/projects" 
					id="back-button"
					class={`inline-flex items-center gap-2 text-xs font-mono tracking-widest uppercase mb-12 group transition-transform hover:-translate-x-1 duration-300 ${textColorClass}`}
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<line x1="19" y1="12" x2="5" y2="12"></line>
						<polyline points="12 19 5 12 12 5"></polyline>
					</svg>
					Volver
				</a>

				<!-- Large Title Display -->
				<div class="mb-16">
					<h1 class={`text-6xl sm:text-8xl md:text-[100px] lg:text-[120px] font-bold tracking-tighter leading-[0.85] uppercase mb-4 project-title ${textColorClass}`}>
						{project.title}
					</h1>
					<p class={`text-xl sm:text-2xl font-light italic font-serif ${isDarkHero ? 'text-emerald-400' : 'text-emerald-600'}`}>
						{project.subtitle}
					</p>
				</div>

				<!-- Meta Specifications Grid -->
				<div class={`grid grid-cols-2 md:grid-cols-4 gap-8 pt-12 border-t ${borderClass} w-full`}>
					<div>
						<span class={`block font-mono text-[10px] tracking-widest uppercase mb-3 ${textMutedClass}`}>
							ROL
						</span>
						<span class={`text-sm sm:text-base font-medium ${textColorClass}`}>
							{project.role || 'Desarrollador'}
						</span>
					</div>
					<div>
						<span class={`block font-mono text-[10px] tracking-widest uppercase mb-3 ${textMutedClass}`}>
							CLIENTE
						</span>
						<span class={`text-sm sm:text-base font-medium ${textColorClass}`}>
							{project.client || 'Independiente'}
						</span>
					</div>
					<div>
						<span class={`block font-mono text-[10px] tracking-widest uppercase mb-3 ${textMutedClass}`}>
							AÑO
						</span>
						<span class={`text-sm sm:text-base font-medium ${textColorClass}`}>
							{project.year}
						</span>
					</div>
					<div>
						<span class={`block font-mono text-[10px] tracking-widest uppercase mb-3 ${textMutedClass}`}>
							TECNOLOGÍAS
						</span>
						<div class="flex flex-wrap gap-1.5">
							{project.tags.map((tag) => (
								<span class={`px-2.5 py-0.5 border rounded-full text-[10px] font-mono transition-colors duration-300 ${badgeBgClass}`}>
									{tag}
								</span>
							))}
						</div>
					</div>
				</div>

			</div>
		</section>

		<!-- HERO COVER SHOWCASE MOCKUP (Distributed Mockup 1 - Sand/White/Charcoal Canvas) -->
		<div class="max-w-7xl mx-auto px-6 sm:px-12 md:px-24 -mt-20 md:-mt-28 relative z-20 mb-20 md:mb-28">
			<div 
				class="w-full aspect-[16/9] sm:aspect-[21/9] rounded-[2.5rem] border border-gray-200/50 dark:border-white/5 flex flex-col overflow-hidden relative group hover:border-emerald-500/20 transition-all duration-500 shadow-2xl" 
				style={`background-color: ${project.backgroundColor}`}
			>
				<!-- Browser top bar -->
				<div class={`w-full h-11 border-b ${isDarkHero ? 'border-white/10' : 'border-gray-900/10'} px-5 flex items-center gap-2 bg-white/15 dark:bg-black/20 backdrop-blur-md relative z-20`}>
					<span class={`w-3 h-3 rounded-full ${isDarkHero ? 'bg-white/20' : 'bg-gray-950/20'}`}></span>
					<span class={`w-3 h-3 rounded-full ${isDarkHero ? 'bg-white/20' : 'bg-gray-950/20'}`}></span>
					<span class={`w-3 h-3 rounded-full ${isDarkHero ? 'bg-white/20' : 'bg-gray-950/20'}`}></span>
					<div class={`mx-auto text-[10px] font-mono tracking-widest uppercase ${isDarkHero ? 'text-white/40' : 'text-gray-500'}`}>
						{project.title.toLowerCase()}.dev
					</div>
				</div>
				<!-- Visual content area -->
				<div class="flex-1 w-full relative flex flex-col justify-center items-center overflow-hidden">
					{project.images && project.images[0] ? (
						<img 
							src={project.images[0]} 
							alt={`${project.title} Screenshot 1`} 
							class="w-full h-full object-cover object-top hover:scale-[1.02] transition-transform duration-700" 
						/>
					) : (
						<div class="p-8 flex flex-col items-center justify-center relative w-full h-full">
							<!-- Ambient tech grid overlay -->
							<div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(0,0,0,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(0,0,0,0.03)_1px,transparent_1px)] dark:bg-[linear-gradient(to_right,rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:32px_32px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)] pointer-events-none z-10"></div>
							
							<!-- Giant Outlined watermark -->
							<div class={`absolute text-[12vw] sm:text-[8vw] font-black tracking-tighter uppercase select-none font-sans z-0 pointer-events-none ${isDarkHero ? 'text-white/[0.02]' : 'text-gray-900/[0.04]'}`}>
								{project.title}
							</div>
							
							<!-- Centered minimal specifications block -->
							<div class="relative z-10 text-center flex flex-col items-center max-w-sm">
								<div class={`w-14 h-14 rounded-2xl ${isDarkHero ? 'bg-emerald-400/10 border-emerald-400/20' : 'bg-emerald-500/10 border-emerald-500/20'} border flex items-center justify-center mb-4 transition-transform duration-500 group-hover:scale-110`}>
									<span class={`font-mono text-sm font-bold ${isDarkHero ? 'text-emerald-400' : 'text-emerald-600'}`}>
										{project.title.slice(0,2).toUpperCase()}
									</span>
								</div>
								<span class={`text-sm font-mono tracking-widest uppercase mb-1 font-bold ${isDarkHero ? 'text-white' : 'text-gray-900'}`}>
									{project.title}
								</span>
								<span class={`text-xs font-mono tracking-wider ${isDarkHero ? 'text-white/40' : 'text-gray-500'}`}>
									{project.subtitle}
								</span>
							</div>
						</div>
					)}
				</div>
			</div>
		</div>

		<!-- CONTENT CANVAS (Light / Dark Mode Adaptive) -->
		<section class="w-full relative py-12 md:py-20 bg-white text-gray-900 dark:bg-black dark:text-white">
			
			<div class="max-w-7xl mx-auto px-6 sm:px-12 md:px-24">
				
				<!-- BENTO CHALLENGE & SOLUTION (Distributed Mockup 2 Embedded) -->
				<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 md:gap-10 mb-24 md:mb-32 items-stretch">
					
					<!-- Challenge Block -->
					<div class="bg-gray-50 dark:bg-zinc-900/40 border border-gray-100 dark:border-white/5 rounded-[2rem] p-8 md:p-10 flex flex-col justify-between transition-all duration-300 hover:border-emerald-500/10">
						<div>
							<span class="font-mono text-xs uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-6 block">
								EL DESAFÍO
							</span>
							<h2 class="text-2xl sm:text-3xl font-bold tracking-tight mb-5">
								¿Qué problema resolvimos?
							</h2>
							<p class="text-gray-600 dark:text-gray-400 font-light leading-relaxed text-sm sm:text-base">
								{project.challenge || project.description}
							</p>
						</div>
						<div class="mt-8 flex items-center gap-2 text-red-500 dark:text-red-400 font-mono text-[10px] uppercase tracking-wider">
							<span class="w-2 h-2 rounded-full bg-red-500 dark:bg-red-400 animate-pulse"></span>
							Complejidad Operativa
						</div>
					</div>

					<!-- Visual Showcase Mockup (Distributed Mockup 2) -->
					{project.id === 'tuki' ? (
						<div class="flex justify-center items-center py-4">
							<div class="relative group w-full max-w-[260px] sm:max-w-[280px]">
								<!-- Ambient glow -->
								<div class="absolute -inset-4 bg-gradient-to-tr from-emerald-500/10 via-purple-500/10 to-blue-500/10 rounded-[3.5rem] blur-2xl opacity-50 group-hover:opacity-100 transition-opacity duration-500"></div>
								
								<!-- iPhone Frame Container -->
								<div class="relative w-full aspect-[9/19] rounded-[2.8rem] sm:rounded-[3.2rem] bg-black p-3 border-[6px] sm:border-[8px] border-zinc-800 dark:border-zinc-700 shadow-xl transition-all duration-500 group-hover:-translate-y-2 group-hover:shadow-[0_25px_60px_-15px_rgba(16,185,129,0.25)] overflow-hidden flex flex-col">
									<!-- Dynamic Island -->
									<div class="absolute top-4 left-1/2 -translate-x-1/2 w-24 h-4 bg-black rounded-full z-30 flex items-center justify-end px-2 gap-1 border border-zinc-800/60">
										<span class="w-1.5 h-1.5 rounded-full bg-blue-900/40"></span>
									</div>

									<!-- Screen area -->
									<div class="w-full h-full rounded-[2.2rem] sm:rounded-[2.5rem] overflow-hidden relative bg-zinc-950 flex items-center justify-center">
										{project.images && project.images[1] ? (
											<img 
												src={project.images[1]} 
												alt={`${project.title} Screenshot 2`} 
												class="w-full h-full object-cover" 
											/>
										) : (
											<div class="p-6 text-center text-xs font-mono text-gray-500">Vista 2</div>
										)}
									</div>
								</div>
							</div>
						</div>
					) : (
						<div 
							class="border border-gray-200/50 dark:border-white/5 rounded-[2rem] overflow-hidden min-h-[320px] flex flex-col justify-between relative group hover:border-emerald-500/20 transition-all duration-300 shadow-md"
							style={`background-color: ${project.backgroundColor}`}
						>
							<!-- Browser top bar -->
							<div class={`w-full h-9 border-b ${isDarkHero ? 'border-white/10' : 'border-gray-900/10'} px-4 flex items-center gap-1.5 bg-white/15 dark:bg-black/20 backdrop-blur-md relative z-20`}>
								<span class={`w-2 h-2 rounded-full ${isDarkHero ? 'bg-white/20' : 'bg-gray-950/20'}`}></span>
								<span class={`w-2 h-2 rounded-full ${isDarkHero ? 'bg-white/20' : 'bg-gray-950/20'}`}></span>
								<span class={`w-2 h-2 rounded-full ${isDarkHero ? 'bg-white/20' : 'bg-gray-950/20'}`}></span>
							</div>
							<!-- Content -->
							<div class="flex-1 w-full relative flex flex-col justify-center items-center overflow-hidden">
								{project.images && project.images[1] ? (
									<img 
										src={project.images[1]} 
										alt={`${project.title} Screenshot 2`} 
										class="w-full h-full object-cover object-top hover:scale-[1.02] transition-transform duration-700" 
									/>
								) : (
									<div class="p-6 flex flex-col items-center justify-center relative w-full h-full">
										<div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(0,0,0,0.02)_1px,transparent_1px),linear-gradient(to_bottom,rgba(0,0,0,0.02)_1px,transparent_1px)] dark:bg-[linear-gradient(to_right,rgba(255,255,255,0.01)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.01)_1px,transparent_1px)] bg-[size:24px_24px] pointer-events-none"></div>
										
										<div class={`absolute text-[8vw] sm:text-[6vw] font-black tracking-tighter uppercase select-none font-sans z-0 pointer-events-none ${isDarkHero ? 'text-white/[0.015]' : 'text-gray-900/[0.03]'}`}>
											MOCKUP
										</div>

										<div class="relative z-10 text-center">
											<span class={`text-[10px] font-mono tracking-widest uppercase mb-1 block font-bold ${isDarkHero ? 'text-white/60' : 'text-gray-800'}`}>
												CONEXIÓN
											</span>
											<span class={`text-[9px] font-mono tracking-wider block ${isDarkHero ? 'text-white/40' : 'text-gray-500'}`}>
												ESTADO: ACTIVO
											</span>
										</div>
									</div>
								)}
							</div>
						</div>
					)}

					<!-- Solution Block -->
					<div class="bg-gray-50 dark:bg-zinc-900/40 border border-gray-100 dark:border-white/5 rounded-[2rem] p-8 md:p-10 flex flex-col justify-between transition-all duration-300 hover:border-emerald-500/10">
						<div>
							<span class="font-mono text-xs uppercase tracking-widest text-emerald-500 dark:text-emerald-400 mb-6 block">
								LA SOLUCIÓN
							</span>
							<h2 class="text-2xl sm:text-3xl font-bold tracking-tight mb-5">
								Arquitectura & Diseño
							</h2>
							<p class="text-gray-600 dark:text-gray-400 font-light leading-relaxed text-sm sm:text-base">
								{project.solution || project.fullDescription || 'Implementación de un sistema a medida, enfocado en rendimiento y estabilidad técnica.'}
							</p>
						</div>
						<div class="mt-8 flex items-center gap-2 text-emerald-500 dark:text-emerald-400 font-mono text-[10px] uppercase tracking-wider">
							<span class="w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400"></span>
							Estabilidad y Escalabilidad
						</div>
					</div>

				</div>

				<!-- ACTIONS BAR -->
				<div class="flex flex-wrap gap-4 justify-center md:justify-start mb-24 md:mb-32">
					{project.liveUrl ? (
						<a 
							href={project.liveUrl} 
							target="_blank" 
							rel="noopener noreferrer"
							class="px-8 py-3.5 bg-gray-900 dark:bg-white text-white dark:text-black rounded-full font-mono text-xs font-semibold uppercase tracking-widest hover:scale-105 transition-transform duration-300 flex items-center gap-2.5 shadow-lg shadow-black/5 dark:shadow-white/5 cursor-pointer"
						>
							Visitar Sitio Web
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
								<polyline points="15 3 21 3 21 9"></polyline>
								<line x1="10" y1="14" x2="21" y2="3"></line>
							</svg>
						</a>
					) : (
						<span 
							class="px-8 py-3.5 bg-gray-100 dark:bg-zinc-800/80 text-gray-400 dark:text-zinc-500 rounded-full font-mono text-xs font-semibold uppercase tracking-widest flex items-center gap-2.5 opacity-60 border border-gray-200 dark:border-white/5 select-none"
						>
							Sitio Web (No Disponible)
						</span>
					)}
					{project.githubUrl ? (
						<a 
							href={project.githubUrl} 
							target="_blank" 
							rel="noopener noreferrer"
							class="px-8 py-3.5 border border-gray-300 dark:border-white/10 hover:border-emerald-500/20 text-gray-700 dark:text-gray-300 rounded-full font-mono text-xs font-semibold uppercase tracking-widest hover:scale-105 transition-transform duration-300 flex items-center gap-2.5 cursor-pointer"
						>
							Código Fuente
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
							</svg>
						</a>
					) : (
						<span 
							class="px-8 py-3.5 border border-gray-200 dark:border-zinc-800 text-gray-400 dark:text-zinc-500 rounded-full font-mono text-xs font-semibold uppercase tracking-widest flex items-center gap-2.5 opacity-60 select-none"
						>
							Código (No Disponible)
						</span>
					)}
				</div>

				<!-- KEY FEATURES (With Distributed Mockup 3 alongside) -->
				{project.features && project.features.length > 0 && (
					<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start mb-24 md:mb-32 relative">
						
						<!-- Left features deck -->
						<div class="lg:col-span-7 flex flex-col justify-center">
							<header class="mb-12">
								<span class="font-mono text-xs uppercase tracking-widest text-emerald-500 dark:text-emerald-400 block mb-3">
									CONSTRUCCIÓN TÉCNICA
								</span>
								<h3 class="text-4xl md:text-5xl font-bold tracking-tight">
									Características <span class="font-light italic font-serif lowercase text-emerald-500 dark:text-emerald-400">clave</span> del sistema.
								</h3>
							</header>

							<div class="flex flex-col gap-5 w-full">
								{project.features.map((feature, idx) => (
									<div class="group bg-gray-50/50 dark:bg-[#0c0c0e]/30 border border-gray-100 dark:border-white/5 rounded-2xl p-6 flex gap-6 items-start transition-all duration-300 hover:border-emerald-500/20 hover:bg-white dark:hover:bg-zinc-950">
										<span class="font-mono text-sm font-bold text-emerald-500 dark:text-emerald-400 bg-emerald-500/5 dark:bg-emerald-400/5 px-3 py-1 rounded-lg">
											{String(idx + 1).padStart(2, '0')}
										</span>
										<p class="text-sm sm:text-base text-gray-700 dark:text-gray-300 font-light leading-relaxed">
											{feature}
										</p>
									</div>
								))}
							</div>
						</div>

						<!-- Sticky Right Image Showcase (Distributed Mockup 3) -->
						<div class="lg:col-span-5 lg:sticky lg:top-32 w-full flex justify-center">
							{project.id === 'tuki' ? (
								<div class="relative group w-full max-w-[280px] sm:max-w-[310px]">
									<!-- Ambient glow -->
									<div class="absolute -inset-4 bg-gradient-to-tr from-emerald-500/10 via-purple-500/10 to-blue-500/10 rounded-[3.5rem] blur-2xl opacity-50 group-hover:opacity-100 transition-opacity duration-500"></div>
									
									<!-- iPhone Frame Container -->
									<div class="relative w-full aspect-[9/19] rounded-[2.8rem] sm:rounded-[3.2rem] bg-black p-3 border-[6px] sm:border-[8px] border-zinc-800 dark:border-zinc-700 shadow-2xl transition-all duration-500 group-hover:-translate-y-2 group-hover:shadow-[0_35px_80px_-20px_rgba(16,185,129,0.25)] overflow-hidden flex flex-col">
										<!-- Dynamic Island -->
										<div class="absolute top-4 left-1/2 -translate-x-1/2 w-24 h-4 bg-black rounded-full z-30 flex items-center justify-end px-2 gap-1 border border-zinc-800/60">
											<span class="w-1.5 h-1.5 rounded-full bg-blue-900/40"></span>
										</div>

										<!-- Screen area -->
										<div class="w-full h-full rounded-[2.2rem] sm:rounded-[2.5rem] overflow-hidden relative bg-zinc-950 flex items-center justify-center">
											{project.images && project.images[2] ? (
												<img 
													src={project.images[2]} 
													alt={`${project.title} Screenshot 3`} 
													class="w-full h-full object-cover" 
												/>
											) : (
												<div class="p-6 text-center text-xs font-mono text-gray-500">Vista 3</div>
											)}
										</div>
									</div>
								</div>
							) : (
								<div 
									class="w-full aspect-[4/3] sm:aspect-square rounded-[2.5rem] border border-gray-200/50 dark:border-white/5 flex flex-col overflow-hidden relative group hover:border-emerald-500/20 transition-all duration-500 shadow-xl"
									style={`background-color: ${project.backgroundColor}`}
								>
									<!-- Browser top bar -->
									<div class={`w-full h-11 border-b ${isDarkHero ? 'border-white/10' : 'border-gray-900/10'} px-5 flex items-center gap-2 bg-white/15 dark:bg-black/20 backdrop-blur-md relative z-20`}>
										<span class={`w-3 h-3 rounded-full ${isDarkHero ? 'bg-white/20' : 'bg-gray-950/20'}`}></span>
										<span class={`w-3 h-3 rounded-full ${isDarkHero ? 'bg-white/20' : 'bg-gray-950/20'}`}></span>
										<span class={`w-3 h-3 rounded-full ${isDarkHero ? 'bg-white/20' : 'bg-gray-950/20'}`}></span>
									</div>
									<!-- Visual content area -->
									<div class="flex-1 w-full relative flex flex-col justify-center items-center overflow-hidden">
										{project.images && project.images[2] ? (
											<img 
												src={project.images[2]} 
												alt={`${project.title} Screenshot 3`} 
