---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { getAllProjects } from '../../data/projects';

const projects = getAllProjects();
---

<Layout title="Joain Monroy - Proyectos" showHeader={true}>
	<main class="relative bg-white text-gray-900 dark:bg-black dark:text-white min-h-screen overflow-hidden transition-colors duration-500">

		<div class="max-w-7xl mx-auto px-6 sm:px-10 md:px-20 pt-40 md:pt-48 pb-0">

			<!-- HEADER SECTION -->
			<div class="mb-16 md:mb-20 projects-title flex flex-col md:flex-row md:items-end justify-between gap-8 border-b border-gray-200/60 dark:border-white/10 pb-12">
				<div class="flex flex-col items-start max-w-2xl">
					<span class="text-xs font-mono font-bold tracking-widest uppercase text-emerald-500 dark:text-emerald-400 block mb-4 flex items-center gap-2">
						<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
						Portafolio de Ingeniería (2024 - 2026)
					</span>
					<h1 class="text-5xl md:text-7xl font-bold tracking-tighter text-gray-900 dark:text-white leading-[0.95]">
						Casos de Estudio & Proyectos.
					</h1>
					<p class="text-gray-500 dark:text-gray-400 text-lg font-light mt-6 leading-relaxed">
						Una selección de desarrollos web, plataformas SaaS e infraestructura DevOps diseñadas con enfoque en escalabilidad, arquitectura limpia y alto rendimiento.
					</p>
				</div>

				<!-- Info Badges on the Right -->
				<div class="flex flex-wrap md:flex-col items-start md:items-end gap-3 shrink-0 font-mono text-xs">
					<div class="px-4 py-2 rounded-full border border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-white/5 text-gray-700 dark:text-gray-300 flex items-center gap-2">
						<span class="font-bold text-emerald-500">04</span> Proyectos Seleccionados
					</div>
					<div class="px-4 py-2 rounded-full border border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-white/5 text-gray-500 dark:text-gray-400">
						Full-Stack • DevOps • GenAI
					</div>
				</div>
			</div>

			<!-- UNIFIED RESPONSIVE GRID -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 relative max-w-7xl mx-auto w-full mb-32 items-start" id="projects-grid">
				{projects.map((project, index) => {
					const isDark = project.backgroundColor === '#1c1c1c';
					const isEvenItem = index % 2 !== 0;
					return (
						<div
							class={`project-card-wrapper transition-all duration-500 ${isEvenItem ? 'md:mt-24' : ''}`}
							data-categories={(project.category || []).join(' ')}
							data-initial-offset={isEvenItem ? 'true' : 'false'}
						>
							<a href={`/projects/${project.id}`} class="project-card group block w-full no-underline cursor-none relative">

								{project.id === 'tuki' && (
									<div class="absolute -top-4 -right-4 md:-top-6 md:-right-6 z-20 bg-green-500 text-black text-xs md:text-sm font-bold px-4 py-2 rounded-full uppercase tracking-widest shadow-xl transform rotate-[12deg] border-4 border-white dark:border-black transition-colors duration-500">
										Nuevo
									</div>
								)}

								<!-- Mockup card -->
								<div
									class="w-full aspect-[16/9] rounded-[2rem] overflow-hidden relative mb-6 project-image-container transition-transform duration-500 group-hover:scale-[1.015] shadow-sm"
									style={`background-color: ${project.backgroundColor || '#111'};`}
								>
									<div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(0,0,0,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(0,0,0,0.04)_1px,transparent_1px)] bg-[size:28px_28px] pointer-events-none" />

									<div class={`absolute top-5 left-5 right-5 rounded-xl overflow-hidden shadow-xl transition-transform duration-500 group-hover:-translate-y-1 ${isDark ? 'bg-zinc-900/80' : 'bg-white/80'} backdrop-blur-md`}>
										<div class={`w-full h-8 border-b flex items-center px-3 gap-2 ${isDark ? 'border-white/10 bg-zinc-800/80' : 'border-gray-200/60 bg-gray-100/80'}`}>
											<span class={`w-2.5 h-2.5 rounded-full ${isDark ? 'bg-white/20' : 'bg-gray-300'}`}></span>
											<span class={`w-2.5 h-2.5 rounded-full ${isDark ? 'bg-white/20' : 'bg-gray-300'}`}></span>
											<span class={`w-2.5 h-2.5 rounded-full ${isDark ? 'bg-white/20' : 'bg-gray-300'}`}></span>
											<div class={`flex-1 mx-3 h-4 rounded-full text-[9px] flex items-center justify-center font-mono ${isDark ? 'bg-white/5 text-white/30' : 'bg-gray-200 text-gray-400'}`}>
												{project.title.toLowerCase()}.dev
											</div>
										</div>
										<div class={`p-4 min-h-[72px] ${isDark ? 'bg-zinc-900/60' : 'bg-white/60'}`}>
											<div class="flex gap-3 mb-3">
												<div class={`h-3 rounded-full flex-1 ${isDark ? 'bg-white/10' : 'bg-gray-200'}`} />
												<div class={`h-3 rounded-full w-1/3 ${isDark ? 'bg-white/5' : 'bg-gray-100'}`} />
											</div>
											<div class="flex gap-2 mb-3" style="opacity:0.6;">
												<div class={`h-2.5 rounded-full w-2/5 ${isDark ? 'bg-white/8' : 'bg-gray-200'}`} />
												<div class={`h-2.5 rounded-full flex-1 ${isDark ? 'bg-white/5' : 'bg-gray-100'}`} />
											</div>
											<div class="grid grid-cols-3 gap-2">
												<div class={`h-7 rounded-lg ${isDark ? 'bg-white/5' : 'bg-gray-100'}`} />
												<div class={`h-7 rounded-lg ${isDark ? 'bg-emerald-400/10' : 'bg-emerald-50'}`} />
												<div class={`h-7 rounded-lg ${isDark ? 'bg-white/5' : 'bg-gray-100'}`} />
											</div>
										</div>
									</div>

									<div class={`absolute bottom-4 left-0 right-0 flex justify-center ${isDark ? 'text-white/[0.05]' : 'text-gray-900/[0.06]'}`}>
										<span class="text-[52px] font-black tracking-tighter uppercase leading-none select-none pointer-events-none">{project.title}</span>
									</div>
								</div>

								<h3 class="text-2xl md:text-3xl font-medium tracking-tight mb-4 text-gray-900 dark:text-white group-hover:text-gray-500 dark:group-hover:text-gray-300 transition-colors">
									{project.title}
								</h3>
								<div class="flex justify-between items-center w-full">
									<div class="flex flex-wrap gap-2">
										{project.tags.map(tag => (
											<span class="px-4 py-1.5 border border-gray-300 dark:border-white/10 rounded-full text-xs font-medium text-gray-700 dark:text-gray-300 bg-gray-200 dark:bg-white/5 transition-colors duration-500">{tag}</span>
										))}
									</div>
									<span class="text-sm text-gray-500 font-mono">{project.subtitle || project.year}</span>
								</div>
							</a>
						</div>
					);
				})}
			</div>
		</div>

		<Footer />
	</main>
</Layout>

<script>
	import { gsap } from "gsap";

	document.addEventListener('astro:page-load', () => {
		// Title reveal
		gsap.from(".projects-title", {
			y: 50, opacity: 0, duration: 1.2, ease: "power4.out"
		});

		// Cards scroll-reveal
		gsap.from(".project-card-wrapper", {
			y: 40, opacity: 0, duration: 0.8, stagger: 0.1, ease: "power3.out", delay: 0.15,
			clearProps: "transform,opacity"
		});
	});
</script>
