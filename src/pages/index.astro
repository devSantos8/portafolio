---
// Layout
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";

// UI Components
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";

// Icons
import HTML from "../components/icons/HTML.astro";
import JavaScript from "../components/icons/JavaScript.astro";
import ReactIcon from "../components/icons/React.astro";
import Tailwind from "../components/icons/Tailwind.astro";
import AstroIcon from "../components/icons/Astro.astro";
import BootstrapIcon from "../components/icons/Bootstrap.astro";
import PythonIcon from "../components/icons/Python.astro";
import DjangoIcon from "../components/icons/Django.astro";
import APIIcon from "../components/icons/API.astro";
import PostgresIcon from "../components/icons/Postgres.astro";
import MongoIcon from "../components/icons/Mongo.astro";
import MariaIcon from "../components/icons/Maria.astro";

// Fonts
import "@fontsource/instrument-serif/400-italic.css";

const certificates = [
	{
		title: "Desarrollo Full Stack",
		issuer: "INACAP",
		year: "2025",
		description:
			"Desarrollo de aplicaciones web completas con frontend, backend y buenas prácticas de despliegue.",
		url: "",
		featured: true,
	},
	{
		title: "Git Fundamentals",
		issuer: "DataCamp",
		year: "2025",
		description:
			"Fundamentos de Git y GitHub para control de versiones, trabajo colaborativo y flujos de desarrollo modernos.",
		url: "",
		featured: true,
	},
	{
		title: "AWS Academy Graduate - AWS Academy Cloud Foundations",
		issuer: "AWS Academy",
		year: "2024",
		description:
			"Curso de fundamentos cloud en AWS: conceptos de nube, servicios principales, seguridad y buenas prácticas iniciales.",
		url: "",
		featured: true,
	},
	{
		title: "Soporte Computacional",
		issuer: "INACAP",
		year: "2023",
		description:
			"Diagnóstico, mantenimiento y resolución de incidencias en entornos de hardware y software.",
		url: "",
		featured: false,
	},
];

const featuredCertificates = certificates.filter(
	(certificate) => certificate.featured,
);
const linkedInCertificationsUrl =
	"https://www.linkedin.com/in/jmonroys17/details/certifications/";
const googleAccentClasses = [
	"bg-[#4285F4]",
	"bg-[#EA4335]",
	"bg-[#FBBC05]",
	"bg-[#34A853]",
];
---

<Layout title="Joain Monroy - Ingeniero en Informatica">
	<main class="relative isolate bg-[#FAFAFA] dark:bg-[#000000] text-gray-900 dark:text-gray-100 transition-colors duration-500 overflow-x-clip min-h-screen">
		<div class="fixed inset-0 pointer-events-none -z-10">
			<!-- Vercel-inspired subtle background -->
			<div class="absolute inset-0 bg-[radial-gradient(circle_500px_at_50%_200px,#E5E7EB,transparent)] dark:bg-[radial-gradient(circle_500px_at_50%_200px,#1F2937,transparent)] opacity-50"></div>
			<div class="absolute inset-0 bg-[radial-gradient(rgba(15,23,42,0.16)_0.45px,transparent_0.45px)] dark:bg-[radial-gradient(rgba(255,255,255,0.2)_0.45px,transparent_0.45px)] [background-size:3px_3px] opacity-[0.07] dark:opacity-[0.08]"></div>
		</div>
		<!-- Astro Hero Section -->
		<Hero />

		<!-- Experiencia Section - Premium Edition -->
		<SectionContainer
			id="Experiencia"
			class="py-24 md:py-32 lg:py-40 relative overflow-hidden"
			bg="bg-transparent"
		>
			<style is:inline>
				@keyframes trajectorySlideUp {
					from {
						opacity: 0;
						transform: translateY(48px);
					}
					to {
						opacity: 1;
						transform: translateY(0);
					}
				}

				.trajectory-item {
					animation: trajectorySlideUp 0.8s cubic-bezier(0.32, 0.72, 0.06, 1) backwards;
				}

				.trajectory-item:nth-child(1) { animation-delay: 0.05s; }
				.trajectory-item:nth-child(2) { animation-delay: 0.1s; }
				.trajectory-item:nth-child(3) { animation-delay: 0.15s; }

				.trajectory-card:hover .trajectory-surface {
					transform: translateY(-12px);
					box-shadow: var(--shadow-active);
					border-color: var(--accent-red-border);
				}

				.trajectory-surface {
					transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
								box-shadow 0.4s ease,
								border-color 0.3s ease;
					backdrop-filter: blur(8px);
				}

				.trajectory-node {
					transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
								box-shadow 0.3s ease;
				}

				.trajectory-card:hover .trajectory-node {
					transform: scale(1.1);
					box-shadow: 0 0 20px rgba(220, 38, 38, 0.3);
				}
			</style>

			<div class="fade-in-section relative z-10 w-full max-w-6xl mx-auto px-3 md:px-6">
				<div class="pointer-events-none absolute -top-20 -left-12 h-56 w-56 rounded-full bg-[#DC2626]/10 blur-[100px]"></div>
				<div class="pointer-events-none absolute -bottom-20 right-0 h-64 w-64 rounded-full bg-[#0F172A]/8 dark:bg-[#475569]/16 blur-[110px]"></div>

				<div class="relative mb-14 md:mb-20 grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-8 items-end">
					<div class="max-w-3xl">
						<span class="inline-block mb-3 text-[10px] font-semibold uppercase tracking-[0.28em] text-[#DC2626]">
							━ Trayectoria Profesional
						</span>
						<h2 class="text-4xl md:text-5xl lg:text-6xl font-semibold text-gray-900 dark:text-white leading-[1.04] mb-4 tracking-tight">
							Experiencia y <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] to-[#f87171]">Formación</span>
						</h2>
						<p class="text-sm md:text-base text-gray-600 dark:text-gray-300 leading-relaxed max-w-2xl">
							Un recorrido de impacto: desde soluciones backend complejas hasta formación en arquitectura de sistemas. Cada hito representa crecimiento en calidad, precisión y visión de negocio.
						</p>
					</div>
					<div class="flex items-center gap-2.5 rounded-full px-4 py-2 bg-gradient-to-r from-white/80 to-white/60 dark:from-white/8 dark:to-white/5 border border-gray-200/60 dark:border-white/15 backdrop-blur-md shadow-lg dark:shadow-xl">
						<div class="h-2 w-2 rounded-full bg-[#DC2626] animate-pulse"></div>
						<span class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gray-700 dark:text-gray-300">03 Hitos</span>
					</div>
				</div>

				<div class="relative">
					<div class="pointer-events-none absolute left-4 md:left-1/2 md:-translate-x-1/2 top-0 h-full w-0.5 md:w-1 bg-gradient-to-b from-[#DC2626]/0 via-[#DC2626]/40 to-[#DC2626]/0"></div>

					<!-- ITEM 1 -->
					<article class="trajectory-item trajectory-card relative flex flex-col md:flex-row md:items-center gap-6 md:gap-0 mb-12 md:mb-14 group">
						<div class="trajectory-node absolute left-0 md:left-1/2 md:-translate-x-1/2 top-0 md:top-1/2 md:-translate-y-1/2 z-10 h-7 w-7 md:h-8 md:w-8 rounded-full border-4 border-[#FAFAFA] dark:border-[#000000] bg-white dark:bg-slate-900 shadow-lg transition-all duration-300 group-hover:scale-125 group-hover:shadow-2xl">
							<span class="absolute inset-0 m-auto h-3 w-3 md:h-3.5 md:w-3.5 rounded-full bg-gradient-to-br from-[#DC2626] to-[#991b1b]"></span>
						</div>

						<div class="trajectory-surface relative overflow-hidden w-full md:w-[calc(50%-2rem)] ml-8 md:ml-0 rounded-2xl border border-gray-200/80 dark:border-slate-700/60 bg-gradient-to-br from-white/95 via-white/90 to-gray-50/85 dark:from-slate-900/95 dark:via-slate-900/90 dark:to-slate-800/85 p-6 md:p-7 shadow-[0_12px_36px_rgba(15,23,42,0.08)] dark:shadow-[0_14px_34px_rgba(0,0,0,0.35)] relative before:absolute before:inset-0 before:bg-gradient-to-br before:from-white/30 before:to-transparent before:rounded-2xl before:pointer-events-none">
							<div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-[#DC2626]/8 to-transparent rounded-full blur-2xl -mr-16 -mt-16"></div>
							<div class="relative z-10">
								<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
									<div class="flex items-center gap-3">
										<span class="inline-flex items-center rounded-full px-3 py-1.5 text-xs font-bold uppercase tracking-[0.15em] border border-[#DC2626]/40 bg-gradient-to-r from-[#DC2626]/15 to-[#DC2626]/5 text-[#DC2626] dark:from-red-500/20 dark:to-red-500/5 dark:text-red-300 shadow-sm">● Actual</span>
										<span class="text-xs font-medium uppercase tracking-[0.12em] text-gray-500 dark:text-slate-400">Mar 2025 - Presente</span>
									</div>
									<span class="text-2xl md:text-3xl font-light text-gray-300 dark:text-slate-600">01</span>
								</div>
								<h3 class="text-xl md:text-2xl font-semibold text-gray-900 dark:text-slate-50 mb-1 tracking-tight">Práctica Profesional</h3>
								<p class="text-xs font-semibold text-[#DC2626] mb-2 uppercase tracking-wider">Empresa / Institución</p>
								<p class="text-sm md:text-[15px] text-gray-700 dark:text-slate-300/95 leading-relaxed mb-4">Implementación de soluciones backend escalables, arquitectura de sistemas y optimización de rendimiento con foco en DevOps y buenas prácticas.</p>
								<div class="flex flex-wrap gap-2">
									<span class="px-3 py-1.5 rounded-full text-xs font-semibold text-gray-700 dark:text-gray-300 bg-gray-200/60 dark:bg-slate-700/60 border border-gray-300/40 dark:border-slate-600/40 backdrop-blur-sm">Backend</span>
									<span class="px-3 py-1.5 rounded-full text-xs font-semibold text-gray-700 dark:text-gray-300 bg-gray-200/60 dark:bg-slate-700/60 border border-gray-300/40 dark:border-slate-600/40 backdrop-blur-sm">DevOps</span>
									<span class="px-3 py-1.5 rounded-full text-xs font-semibold text-gray-700 dark:text-gray-300 bg-gray-200/60 dark:bg-slate-700/60 border border-gray-300/40 dark:border-slate-600/40 backdrop-blur-sm">Escalabilidad</span>
								</div>
							</div>
						</div>
					</article>

					<!-- ITEM 2 -->
					<article class="trajectory-item trajectory-card relative flex flex-col md:flex-row md:items-center gap-6 md:gap-0 mb-12 md:mb-14 md:flex-row-reverse group">
						<div class="trajectory-node absolute left-0 md:left-1/2 md:-translate-x-1/2 top-0 md:top-1/2 md:-translate-y-1/2 z-10 h-7 w-7 md:h-8 md:w-8 rounded-full border-4 border-[#FAFAFA] dark:border-[#000000] bg-white dark:bg-slate-900 shadow-lg transition-all duration-300 group-hover:scale-125 group-hover:shadow-2xl">
							<span class="absolute inset-0 m-auto h-3 w-3 md:h-3.5 md:w-3.5 rounded-full bg-gradient-to-br from-[#2563EB] to-[#1e40af]"></span>
						</div>

