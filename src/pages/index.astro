---
import Layout from '../layouts/Layout.astro';
import { getFeaturedProjects } from '../data/projects';

const projects = getFeaturedProjects();
---

<Layout title="Joain Monroy - Full-Stack Developer" showHeader={true}>
	<main id="main-container">
		
		<div id="pinned-container">
			
			{projects.map((project, idx) => (
				<section 
					class="project-section" 
					data-index={idx}
					style={`z-index: ${projects.length - idx}; background-color: ${project.backgroundColor};`}
				>
					<div class="project-content">
						
						<div class="patchwork">
							<div class="img-wrap img-1" data-speed="0.8">
								<img 
									src={project.images[0] || 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=400&h=600&fit=crop'} 
									alt=""
									loading={idx === 0 ? 'eager' : 'lazy'}
								/>
							</div>
							<div class="img-wrap img-2" data-speed="1.2">
								<img 
									src={project.images[1] || 'https://images.unsplash.com/photo-1517134191118-9d595e4c8c2b?w=400&h=600&fit=crop'} 
									alt=""
									loading="lazy"
								/>
							</div>
							<div class="img-wrap img-3" data-speed="1">
								<img 
									src={project.images[2] || 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=400&h=600&fit=crop'} 
									alt=""
									loading="lazy"
								/>
							</div>
						</div>
						
						<div class="title-wrap">
							<a href={`/projects/${project.id}`} class="title-link">
								<h2 class="title">{project.title}</h2>
							</a>
							<div class="subtitle-wrap">
								<span class="subtitle">{project.subtitle}</span>
							</div>
						</div>
						
					</div>
				</section>
			))}
			
		</div>
		
	</main>
</Layout>

<style>
	#main-container {
		background: #ffffff;
	}
	
	#pinned-container {
		position: relative;
		width: 100%;
		height: 100vh;
		background: #ffffff;
	}
	
	.project-section {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		background-color: #ffffff; /* FIXED: Solid white so mix-blend-mode works on the white areas */
		will-change: transform, opacity, filter;
	}
	
	.project-content {
		position: relative;
		width: 100%;
		height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}
	
	.patchwork {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	
	.img-wrap {
		position: absolute;
		overflow: hidden;
		will-change: transform;
	}
	
	.img-wrap img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	
	/* Layout matching the reference screenshots */
	.img-1 {
		top: 15%;
		left: 10%;
		width: 20vw;
		height: 30vw;
		z-index: 1; /* Always behind text */
	}
	
	.img-2 {
		bottom: 10%;
		right: 15%;
		width: 18vw;
		height: 25vw;
		z-index: 1; /* Always behind text */
	}
	
	.img-3 {
		top: 5%;
		right: 35%;
		width: 25vw;
		height: 35vw;
		z-index: 1; /* Always behind text */
	}
	
	/* We can use CSS nth-child to give different sections different image layouts for variety */
	.project-section:nth-child(even) .img-1 {
		top: 10%;
		left: 20%;
		width: 25vw;
		height: 25vw;
		z-index: 1;
	}
	
	.project-section:nth-child(even) .img-2 {
		bottom: 15%;
		right: 25%;
		width: 22vw;
		height: 32vw;
		z-index: 1;
	}
	
	.project-section:nth-child(even) .img-3 {
		top: 50%;
		left: 10%;
		width: 15vw;
		height: 20vw;
		z-index: 1;
	}
	
	.title-wrap {
		position: relative;
		z-index: 10; /* Always on top of everything */
		text-align: center;
		pointer-events: auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		mix-blend-mode: difference; /* This creates the translucent inverse effect over images! */
	}
	
	.title-link {
		display: inline-block;
		text-decoration: none;
		color: #fff;
	}
	
	.title {
		font-family: 'Playfair Display', Georgia, serif;
		font-size: clamp(80px, 15vw, 200px);
		font-weight: 400;
		line-height: 0.85;
		letter-spacing: -0.04em;
		color: #fff; /* White + Difference = Black on white BG, inverted on images */
		white-space: nowrap;
	}
	
	.subtitle-wrap {
		position: relative;
		z-index: 4; /* Always above everything */
		margin-top: 2rem;
		text-align: center;
	}
	
	.subtitle {
		font-family: var(--font-sans);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: #fff; /* Keep white for the subtitle as well inside the difference wrap */
	}
	
	@media (max-width: 1024px) {
		.img-1 { width: 28vw; height: 38vw; }
		.img-2 { width: 22vw; height: 30vw; }
		.img-3 { width: 30vw; height: 40vw; }
	}
	
	@media (max-width: 768px) {
		.img-1 { top: 10%; left: 5%; width: 45vw; height: 60vw; }
		.img-2 { bottom: 15%; right: 5%; width: 35vw; height: 45vw; z-index: 1; }
		.img-3 { display: none; }
		.title { font-size: clamp(50px, 15vw, 100px); white-space: normal; padding: 0 20px; }
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { Observer } from "gsap/Observer";
	import Lenis from "lenis";

	gsap.registerPlugin(ScrollTrigger, Observer);

	let lenis: any;
	let observer: any;

	document.addEventListener('astro:page-load', () => {
		// Clean up previous instances
		if (lenis) {
			lenis.destroy();
			ScrollTrigger.killAll();
		}
		if (observer) {
			observer.kill();
		}

		lenis = new Lenis({
			duration: 1.2,
			easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
			smoothWheel: true,
			wheelMultiplier: 0.9,
		});

		lenis.on('scroll', ScrollTrigger.update);

		gsap.ticker.add((time) => {
			lenis.raf(time * 1000);
		});
		gsap.ticker.lagSmoothing(0);

		// Get sections
		const sections = gsap.utils.toArray('.project-section') as HTMLElement[];
		
		if (sections.length === 0) return;

		// 1. Text Rotate Setup
		sections.forEach((section) => {
			const title = section.querySelector('.title');
			if (title) {
				const text = title.textContent || "";
				title.innerHTML = "";
				text.split("").forEach(char => {
					const span = document.createElement("span");
					span.textContent = char === " " ? "\u00A0" : char;
					span.style.display = "inline-block";
					span.style.willChange = "transform, opacity, visibility";
					span.classList.add("char");
					title.appendChild(span);
				});
			}
		});

		// Timeline for scrubbing through projects in place
		const tl = gsap.timeline({
			scrollTrigger: {
				trigger: "#pinned-container",
				start: "top top",
				end: `+=${sections.length * 100}%`,
				pin: true,
				scrub: 1.2, // Smooth interpolation when Lenis scrolls
				anticipatePin: 1,
				// We remove GSAP's native snap because Observer + Lenis will handle the exact snapping
			}
		});

		// 2. Initial Setup
		sections.forEach((section: HTMLElement, index: number) => {
			const chars = section.querySelectorAll('.title .char');
			const otherElements = section.querySelectorAll('.subtitle-wrap, .patchwork');

			gsap.set(section, { autoAlpha: 1 });

			if (index === 0) {
				gsap.set(chars, { y: "0%", autoAlpha: 1 });
			} else {
				gsap.set(chars, { y: "120%", autoAlpha: 0 }); 
			}
		});

		sections.forEach((section: HTMLElement, index: number) => {
			// Continuous subtle parallax effect to the images while scrolling
			const images = section.querySelectorAll('.img-wrap');
			images.forEach((el: Element) => {
				const imgWrap = el as HTMLElement;
				const speed = parseFloat(imgWrap.getAttribute('data-speed') || '1');
				const img = imgWrap.querySelector('img') as HTMLElement;
				
				gsap.fromTo(imgWrap, 
					{ y: `${(1 - speed) * 15}vh` },
					{
						y: `${(speed - 1) * 15}vh`,
						ease: "none",
						scrollTrigger: {
							trigger: "#pinned-container",
							start: "top top",
							end: `+=${sections.length * 100}%`,
							scrub: true
						}
					}
				);
				
				// Removed the inner image scaling (zoom effect) to keep it perfectly clean as requested
			});

			if (index === 0) return;

			const prevSection = sections[index - 1] as HTMLElement;
			const prevChars = prevSection.querySelectorAll('.title .char');
			const currChars = section.querySelectorAll('.title .char');
			// Seleccionamos las imágenes individualmente en vez del patchwork
			const prevOther = prevSection.querySelectorAll('.img-wrap, .subtitle-wrap');
			const currOther = section.querySelectorAll('.img-wrap, .subtitle-wrap');

			tl.to({}, { duration: 0.3 });

			tl.set(section, { autoAlpha: 1 }, `transition${index}`);

			tl.to(prevChars, {
				y: "-100%",
				autoAlpha: 0,
				stagger: 0.02,
				duration: 0.3,
				ease: "power2.in"
			}, `transition${index}`);

			// Desaparecen imágenes y subtitulo una por una, sin zoom
			tl.to(prevOther, {
				autoAlpha: 0,
				y: -20, // Ligero movimiento hacia arriba para fluidez
				stagger: 0.08,
				duration: 0.4,
				ease: "power2.inOut"
			}, `transition${index}`);

			// Fade de la sección se retrasa un pelín para que las fotos se vean desaparecer contra el fondo
			tl.to(prevSection, {
				autoAlpha: 0,
				duration: 0.5,
				ease: "power2.inOut"
			}, `transition${index}+=0.2`);

			tl.to(currChars, {
				y: "0%",
				autoAlpha: 1,
				stagger: 0.02,
				duration: 0.4,
				ease: "power2.out"
			}, `transition${index}+=0.4`);

			// Aparecen imágenes y subtitulo una por una, desde abajo
			tl.fromTo(currOther, 
				{ autoAlpha: 0, y: 30 },
				{ autoAlpha: 1, y: 0, stagger: 0.1, duration: 0.5, ease: "power2.out" },
				`transition${index}+=0.3`
			);
		});
		
		tl.to({}, { duration: 0.5 });

		// 3. Observer Implementation for 1-Scroll = 1-Slide behavior
		let currentIndex = 0;
		let isAnimating = false;

		function goToSlide(index: number) {
			if (isAnimating) return;
			isAnimating = true;
			currentIndex = index;
			
			const st = tl.scrollTrigger;
			if (!st) {
				isAnimating = false;
				return;
			}
			
			// Calculate exact scroll position for the target slide
			const totalScroll = st.end - st.start;
			const targetScroll = st.start + (totalScroll * (index / (sections.length - 1)));

			// Smoothly scroll using Lenis
			lenis.scrollTo(targetScroll, {
				duration: 1.5,
				easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
				onComplete: () => {
					// Add a small buffer to prevent accidental double-scrolling
					setTimeout(() => {
						isAnimating = false;
					}, 200);
				}
			});
		}

		observer = Observer.create({
			target: window,
			type: "wheel,touch,pointer",
			wheelSpeed: -1,
			tolerance: 30, // Requires a deliberate scroll/swipe
			preventDefault: true, // Hijack native scrolling
			onUp: () => { // Scroll down / Swipe up
				if (currentIndex < sections.length - 1) {
					goToSlide(currentIndex + 1);
				}
			},
			onDown: () => { // Scroll up / Swipe down
				if (currentIndex > 0) {
					goToSlide(currentIndex - 1);
				}
			}
		});
	});
</script>