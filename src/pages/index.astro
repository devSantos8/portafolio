									<span class="px-4 py-2 rounded-full text-xs font-mono text-gray-600 dark:text-white/60 bg-gray-100 dark:bg-white/[0.03] border border-gray-200 dark:border-white/5 group-hover:bg-gray-200 dark:group-hover:bg-white/[0.06] transition-colors">UX/UI</span>
									<span class="px-4 py-2 rounded-full text-xs font-mono text-gray-600 dark:text-white/60 bg-gray-100 dark:bg-white/[0.03] border border-gray-200 dark:border-white/5 group-hover:bg-gray-200 dark:group-hover:bg-white/[0.06] transition-colors">Performance</span>
								</div>
							</div>
						</div>
					</article>

					<!-- ITEM 3 -->
					<article class="trajectory-item rounded-[2rem] p-8 md:p-10 relative overflow-hidden group bg-white/70 dark:bg-[#0a0a0a]/90 border border-gray-100 dark:border-white/5 shadow-xl shadow-gray-200/50 dark:shadow-[0_20px_40px_-10px_rgba(0,0,0,0.5)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-gray-300 dark:hover:border-white/10 hover:shadow-2xl dark:hover:shadow-[0_30px_60px_-15px_rgba(0,0,0,0.6)]">
