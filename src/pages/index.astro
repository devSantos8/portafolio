		<!-- Projects Section -->
		<section id="Proyectos" class="px-4 md:px-8 lg:px-16 xl:px-24 py-32 md:py-44">
			<div class="max-w-7xl mx-auto">
				<!-- Header -->
				<div class="fade-in-section mb-20 md:mb-28">
					<div class="flex items-start gap-6 md:gap-10">
						<div class="flex flex-col items-center gap-3">
							<span class="text-[11px] font-bold tracking-[0.3em] text-[#DC2626]">01</span>
							<div class="w-px h-16 bg-gradient-to-b from-[#DC2626] to-transparent"></div>
						</div>
						<div>
							<p class="text-[10px] font-semibold uppercase tracking-[0.4em] text-gray-400 dark:text-gray-500 mb-3">
								Trabajos Recientes
							</p>
							<h2 class="text-4xl md:text-5xl font-medium text-gray-900 dark:text-white tracking-tight">
								Proyectos
							</h2>
						</div>
					</div>
				</div>

				<!-- Projects -->
				<div class="space-y-32">
					
					<!-- Proyecto 1: CommitFlow -->
					<article class="fade-in-section group">
						<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
							<div class="relative overflow-hidden rounded-2xl">
								<img src="../projects/workco.webp" alt="CommitFlow" class="w-full h-[280px] md:h-[360px] object-cover transition-transform duration-700 group-hover:scale-105" />
								<div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-500"></div>
							</div>
							<div class="space-y-6">
								<div class="flex items-center gap-4">
									<span class="text-[10px] font-mono text-[#DC2626]">01</span>
									<div class="flex-1 h-px bg-gray-200 dark:bg-white/10"></div>
									<span class="text-[10px] uppercase tracking-[0.2em] text-[#DC2626]">Destacado</span>
								</div>
								<h3 class="text-3xl md:text-4xl font-light text-gray-900 dark:text-white tracking-tight">CommitFlow</h3>
								<p class="text-[10px] uppercase tracking-[0.3em] text-gray-400 dark:text-gray-500">Proyecto de Título</p>
								<p class="text-base text-gray-500 dark:text-gray-400 leading-relaxed">Plataforma que conecta profesionales y empresas TI. Sistema de perfiles, búsqueda avanzada y gestión de ofertas laborales.</p>
								<div class="flex flex-wrap gap-2 pt-2">
									<span class="text-[10px] text-gray-500 dark:text-gray-400 px-4 py-2 bg-gray-100 dark:bg-white/5 rounded-full">Django</span>
									<span class="text-[10px] text-gray-500 dark:text-gray-400 px-4 py-2 bg-gray-100 dark:bg-white/5 rounded-full">Python</span>
									<span class="text-[10px] text-gray-500 dark:text-gray-400 px-4 py-2 bg-gray-100 dark:bg-white/5 rounded-full">PostgreSQL</span>
								</div>
							</div>
						</div>
					</article>

					<!-- Proyecto 2: Dashboard -->
					<article class="fade-in-section group">
						<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
							<div class="relative overflow-hidden rounded-2xl lg:order-2">
								<img src="../projects/dashboard.webp" alt="Dashboard E-commerce" class="w-full h-[280px] md:h-[360px] object-cover transition-transform duration-700 group-hover:scale-105" />
								<div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-500"></div>
							</div>
							<div class="space-y-6 lg:order-1">
								<div class="flex items-center gap-4">
									<span class="text-[10px] font-mono text-[#DC2626]/60">02</span>
									<div class="flex-1 h-px bg-gray-200 dark:bg-white/10"></div>
								</div>
								<h3 class="text-3xl md:text-4xl font-light text-gray-900 dark:text-white tracking-tight">Dashboard E-commerce</h3>
								<p class="text-[10px] uppercase tracking-[0.3em] text-gray-400 dark:text-gray-500">Panel de Control</p>
								<p class="text-base text-gray-500 dark:text-gray-400 leading-relaxed">Panel de control para análisis de usuarios registrados y gestión de usuarios con visualización de datos en tiempo real.</p>
								<div class="flex flex-wrap gap-2 pt-2">
									<span class="text-[10px] text-gray-500 dark:text-gray-400 px-4 py-2 bg-gray-100 dark:bg-white/5 rounded-full">Django</span>
									<span class="text-[10px] text-gray-500 dark:text-gray-400 px-4 py-2 bg-gray-100 dark:bg-white/5 rounded-full">Python</span>
									<span class="text-[10px] text-gray-500 dark:text-gray-400 px-4 py-2 bg-gray-100 dark:bg-white/5 rounded-full">JavaScript</span>
								</div>
							</div>
						</div>
					</article>

					<!-- Proyecto 3: Lubricentro -->
					<article class="fade-in-section group">
						<a href="https://lubricentro-la-esquina.vercel.app" target="_blank" rel="noopener" class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
							<div class="relative overflow-hidden rounded-2xl">
								<img src="../projects/lubricentro.webp" alt="Lubricentro La Esquina" class="w-full h-[280px] md:h-[360px] object-cover transition-transform duration-700 group-hover:scale-105" />
								<div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-500"></div>
							</div>
							<div class="space-y-6">
								<div class="flex items-center gap-4">
									<span class="text-[10px] font-mono text-[#DC2626]/40">03</span>
									<div class="flex-1 h-px bg-gray-200 dark:bg-white/10"></div>
									<span class="flex items-center gap-2 text-[10px] uppercase tracking-[0.2em] text-gray-400 group-hover:text-[#DC2626] transition-colors">
										Live
										<svg class="w-3 h-3 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H7M17 7v10"/></svg>
									</span>
								</div>
								<h3 class="text-3xl md:text-4xl font-light text-gray-900 dark:text-white tracking-tight group-hover:text-[#DC2626] transition-colors">Lubricentro La Esquina</h3>
								<p class="text-[10px] uppercase tracking-[0.3em] text-gray-400 dark:text-gray-500">Sitio Web</p>
								<p class="text-base text-gray-500 dark:text-gray-400 leading-relaxed">Sitio web informativo para un negocio de lubricantes y repuestos automotrices ubicado en Santiago.</p>
								<div class="flex flex-wrap gap-2 pt-2">
									<span class="text-[10px] text-gray-500 dark:text-gray-400 px-4 py-2 bg-gray-100 dark:bg-white/5 rounded-full">Astro</span>
									<span class="text-[10px] text-gray-500 dark:text-gray-400 px-4 py-2 bg-gray-100 dark:bg-white/5 rounded-full">Tailwind</span>
									<span class="text-[10px] text-gray-500 dark:text-gray-400 px-4 py-2 bg-gray-100 dark:bg-white/5 rounded-full">JavaScript</span>
								</div>
							</div>
						</a>
					</article>

				</div>

				<!-- Ver más -->
				<div class="fade-in-section mt-24 text-center">
					<a href="https://github.com/17santo" target="_blank" rel="noopener" class="group inline-flex items-center gap-4 text-gray-400 hover:text-[#DC2626] transition-colors duration-300">
						<span class="w-12 h-px bg-current"></span>
						<span class="text-sm uppercase tracking-[0.2em]">Ver más en GitHub</span>
						<span class="w-12 h-px bg-current"></span>
					</a>
				</div>
			</div>
		</section>

		<!-- About Section -->
		<SectionContainer id="Sobre-mi" class="py-32 md:py-40" bg="bg-slate-50/50 dark:bg-[#0F1115]">
			<div class="fade-in-section flex flex-col md:flex-row md:items-end gap-6 mb-20">
				<p class="text-[11px] font-semibold uppercase tracking-[0.3em] text-[#DC2626] md:pb-1">
					02
				</p>
				<h2 class="text-4xl md:text-5xl font-medium text-gray-900 dark:text-white tracking-tight">
					Sobre mí
				</h2>
				<span class="hidden md:block flex-1 h-[1px] bg-gray-200 dark:bg-gray-800 mb-3"></span>
			</div>
			
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-20 lg:gap-32">
				<div class="fade-in-section space-y-8">
					<p class="text-2xl md:text-3xl font-medium text-gray-900 dark:text-white leading-relaxed tracking-tight">
						Soy Joain Monroy Santos,<br/>
						<span class="text-gray-400 dark:text-gray-500">Ingeniero en Informática orientado al desarrollo de software y DevOps.</span>
					</p>
					<p class="text-base text-gray-600 dark:text-gray-400 leading-loose">
						Me especializo en crear soluciones web que combinan
						buenas prácticas de desarrollo con automatización.
						Cada proyecto es una oportunidad para escribir código
