---
// Layout
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";

// UI Components
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import SkillCard from "../components/SkillCard.astro";

// Icons
import HTML from "../components/icons/HTML.astro";
import JavaScript from "../components/icons/JavaScript.astro";
import ReactIcon from "../components/icons/React.astro";
import Tailwind from "../components/icons/Tailwind.astro";
import AstroIcon from "../components/icons/Astro.astro";
import BootstrapIcon from "../components/icons/Bootstrap.astro";
import PythonIcon from "../components/icons/Python.astro";
import DjangoIcon from "../components/icons/Django.astro";
import APIIcon from "../components/icons/API.astro";
import PostgresIcon from "../components/icons/Postgres.astro";
import MongoIcon from "../components/icons/Mongo.astro";
import MariaIcon from "../components/icons/Maria.astro";

// Fonts
import "@fontsource/barlow/300.css";
import "@fontsource/barlow/400.css";
import "@fontsource/barlow/500.css";
import "@fontsource/instrument-serif/400-italic.css";

const certificates = [
	{
		title: "Desarrollo Full Stack",
		issuer: "INACAP",
		year: "2025",
		description:
			"Desarrollo de aplicaciones web completas con frontend, backend y buenas prácticas de despliegue.",
		url: "",
		featured: true,
	},
	{
		title: "Git Fundamentals",
		issuer: "DataCamp",
		year: "2025",
		description:
			"Fundamentos de Git y GitHub para control de versiones, trabajo colaborativo y flujos de desarrollo modernos.",
		url: "",
		featured: true,
	},
	{
		title: "AWS Academy Graduate - AWS Academy Cloud Foundations",
		issuer: "AWS Academy",
		year: "2024",
		description:
			"Curso de fundamentos cloud en AWS: conceptos de nube, servicios principales, seguridad y buenas prácticas iniciales.",
		url: "",
		featured: true,
	},
	{
		title: "Soporte Computacional",
		issuer: "INACAP",
		year: "2023",
		description:
			"Diagnóstico, mantenimiento y resolución de incidencias en entornos de hardware y software.",
		url: "",
		featured: false,
	},
];

const featuredCertificates = certificates.filter(
	(certificate) => certificate.featured,
);
const linkedInCertificationsUrl =
	"https://www.linkedin.com/in/jmonroys17/details/certifications/";
const googleAccentClasses = [
	"bg-[#4285F4]",
	"bg-[#EA4335]",
	"bg-[#FBBC05]",
	"bg-[#34A853]",
];
---

<Layout title="Joain Monroy - Ingeniero en Informatica">
	<main>
		<!-- Astro Hero Section -->
		<Hero />

		<!-- ======================= -->
		<!-- Rediseño Trayectoria: Hover Accordion Cards (Estilo Japonés) -->
		<!-- ======================= -->
		<!-- EXPERIENCIA - Timeline Profesional -->
		<!-- ======================= -->
		<SectionContainer
			id="Experiencia"
			class="py-32 md:py-40 relative overflow-hidden"
			bg="bg-neutral-50/80 dark:bg-neutral-950"
		>
			<!-- Gradient Background -->
			<div class="absolute inset-0 pointer-events-none overflow-hidden">
				<div class="absolute top-0 right-1/4 w-96 h-96 bg-brand-primary/10 rounded-full blur-3xl opacity-20 dark:opacity-10"></div>
				<div class="absolute bottom-0 left-1/4 w-96 h-96 bg-brand-secondary/10 rounded-full blur-3xl opacity-20 dark:opacity-10"></div>
			</div>

			<div class="fade-in-section relative z-10 w-full max-w-5xl mx-auto px-4 md:px-8">
				<!-- Header -->
				<div class="mb-16 md:mb-20">
					<p class="text-[11px] font-semibold uppercase tracking-[0.3em] text-brand-primary mb-3">
						Recorrido Profesional
					</p>
					<div class="flex items-end justify-between gap-6">
						<div>
							<h2 class="text-4xl md:text-5xl font-medium text-neutral-900 dark:text-white tracking-tight">
								Trayectoria & Experiencia
							</h2>
							<p class="text-neutral-600 dark:text-neutral-400 mt-2 text-base md:text-lg">
								Mi evolución en desarrollo, tecnología e ingeniería
							</p>
						</div>
					</div>
				</div>

				<!-- Timeline Container -->
				<div class="relative">
					<!-- Central Line -->
					<div class="absolute left-0 md:left-1/2 md:-translate-x-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-brand-primary to-brand-primary/20 dark:from-brand-primary dark:to-brand-primary/20"></div>

					<!-- Timeline Items -->
					<div class="space-y-8 md:space-y-0 md:space-y-12">
						
						<!-- Item 1: Actual -->
						<div class="relative">
							<!-- Dot on timeline -->
							<div class="absolute left-0 md:left-1/2 md:-translate-x-1/2 -translate-x-1/2 top-2 w-4 h-4 bg-brand-primary rounded-full border-4 border-neutral-50 dark:border-neutral-950 shadow-lg z-20"></div>
							<div class="absolute left-0 md:left-1/2 md:-translate-x-1/2 -translate-x-1/2 top-2 w-4 h-4 bg-brand-primary rounded-full animate-pulse"></div>

							<!-- Content -->
							<div class="pl-12 md:pl-0 md:w-1/2 md:pr-12 md:ml-0" data-position="right">
								<div class="group relative p-6 md:p-8 rounded-2xl bg-white dark:bg-neutral-900/50 border border-neutral-200 dark:border-neutral-800 hover:border-brand-primary/40 dark:hover:border-brand-primary/40 transition-all duration-300 shadow-sm hover:shadow-lg hover:shadow-brand-primary/10 dark:hover:shadow-brand-primary/20">
									
									<!-- Status Badge -->
									<div class="mb-4 flex items-center gap-2">
										<span class="relative flex h-2 w-2">
											<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-primary opacity-75"></span>
											<span class="relative inline-flex rounded-full h-2 w-2 bg-brand-primary"></span>
										</span>
										<span class="text-[10px] font-bold uppercase tracking-wider text-brand-primary">En curso</span>
										<span class="text-[10px] font-medium text-neutral-500 dark:text-neutral-400">Mar 2025 — Presente</span>
									</div>

									<!-- Title & Company -->
									<h3 class="text-xl md:text-2xl font-semibold text-neutral-900 dark:text-white mb-1 group-hover:text-brand-primary transition-colors">
										Práctica Profesional
									</h3>
									<p class="text-sm md:text-base font-medium text-brand-primary mb-3">
										Empresa / Institución
									</p>

									<!-- Description -->
									<p class="text-neutral-600 dark:text-neutral-400 text-sm md:text-base leading-relaxed mb-4">
										Desarrollo e implementación de soluciones de software modernas. Contribución activa en arquitectura de sistemas, optimización de rendimiento y aplicación de buenas prácticas.
									</p>

									<!-- Skills -->
									<div class="flex flex-wrap gap-2">
										<span class="px-3 py-1 text-xs rounded-full bg-brand-primary/10 text-brand-primary border border-brand-primary/20 font-medium">Backend</span>
										<span class="px-3 py-1 text-xs rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20 font-medium">DevOps</span>
										<span class="px-3 py-1 text-xs rounded-full bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20 font-medium">APIs</span>
									</div>
								</div>
							</div>
						</div>

						<!-- Item 2: Freelance -->
						<div class="relative">
							<!-- Dot on timeline -->
							<div class="absolute left-0 md:left-1/2 md:-translate-x-1/2 -translate-x-1/2 top-2 w-3 h-3 bg-neutral-300 dark:bg-neutral-700 rounded-full border-4 border-neutral-50 dark:border-neutral-950 z-20"></div>

							<!-- Content -->
							<div class="pl-12 md:pl-0 md:w-1/2 md:pl-12 md:ml-auto" data-position="left">
								<div class="group relative p-6 md:p-8 rounded-2xl bg-white dark:bg-neutral-900/50 border border-neutral-200 dark:border-neutral-800 hover:border-brand-primary/40 dark:hover:border-brand-primary/40 transition-all duration-300 shadow-sm hover:shadow-lg hover:shadow-brand-primary/10 dark:hover:shadow-brand-primary/20">
									
									<!-- Status Badge -->
									<div class="mb-4 flex items-center gap-2">
										<span class="text-[10px] font-bold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Completado</span>
										<span class="text-[10px] font-medium text-neutral-500 dark:text-neutral-400">Ene — Feb 2025</span>
									</div>

									<!-- Title & Company -->
									<h3 class="text-xl md:text-2xl font-semibold text-neutral-900 dark:text-white mb-1 group-hover:text-brand-primary transition-colors">
										Desarrollo Web Freelance
									</h3>
									<p class="text-sm md:text-base font-medium text-brand-primary mb-3">
										Proyectos Independientes
									</p>

									<!-- Description -->
									<p class="text-neutral-600 dark:text-neutral-400 text-sm md:text-base leading-relaxed mb-4">
										Diseño y desarrollo de landing pages modernas y sistemas web para clientes. Enfoque en rendimiento, UX/UI minimalista, SEO técnico y buenas prácticas.
									</p>

									<!-- Skills -->
									<div class="flex flex-wrap gap-2">
										<span class="px-3 py-1 text-xs rounded-full bg-brand-primary/10 text-brand-primary border border-brand-primary/20 font-medium">Frontend</span>
										<span class="px-3 py-1 text-xs rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 font-medium">Diseño</span>
										<span class="px-3 py-1 text-xs rounded-full bg-green-500/10 text-green-600 dark:text-green-400 border border-green-500/20 font-medium">SEO</span>
									</div>
								</div>
							</div>
						</div>

						<!-- Item 3: Estudios -->
						<div class="relative">
							<!-- Dot on timeline -->
							<div class="absolute left-0 md:left-1/2 md:-translate-x-1/2 -translate-x-1/2 top-2 w-3 h-3 bg-neutral-300 dark:bg-neutral-700 rounded-full border-4 border-neutral-50 dark:border-neutral-950 z-20"></div>

							<!-- Content -->
							<div class="pl-12 md:pl-0 md:w-1/2 md:pr-12 md:ml-0" data-position="right">
								<div class="group relative p-6 md:p-8 rounded-2xl bg-white dark:bg-neutral-900/50 border border-neutral-200 dark:border-neutral-800 hover:border-brand-primary/40 dark:hover:border-brand-primary/40 transition-all duration-300 shadow-sm hover:shadow-lg hover:shadow-brand-primary/10 dark:hover:shadow-brand-primary/20">
									
									<!-- Status Badge -->
									<div class="mb-4 flex items-center gap-2">
										<span class="text-[10px] font-bold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Educación</span>
										<span class="text-[10px] font-medium text-neutral-500 dark:text-neutral-400">2022 — 2025</span>
									</div>

									<!-- Title & Company -->
									<h3 class="text-xl md:text-2xl font-semibold text-neutral-900 dark:text-white mb-1 group-hover:text-brand-primary transition-colors">
										Ingeniería en Informática
									</h3>
									<p class="text-sm md:text-base font-medium text-brand-primary mb-3">
										INACAP Santiago Centro
									</p>

									<!-- Description -->
									<p class="text-neutral-600 dark:text-neutral-400 text-sm md:text-base leading-relaxed mb-4">
										Formación integral en desarrollo de software, arquitecturas escalables, bases de datos relacional y NoSQL, metodologías ágiles y buenas prácticas DevOps.
									</p>

									<!-- Skills -->
									<div class="flex flex-wrap gap-2">
										<span class="px-3 py-1 text-xs rounded-full bg-brand-primary/10 text-brand-primary border border-brand-primary/20 font-medium">Full-Stack</span>
										<span class="px-3 py-1 text-xs rounded-full bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20 font-medium">DevOps</span>
										<span class="px-3 py-1 text-xs rounded-full bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20 font-medium">Agile</span>
									</div>
								</div>
							</div>
						</div>

					</div>
				</div>
			</div>
		</SectionContainer>

