			<div class="fade-in-section relative z-10 w-full max-w-6xl mx-auto px-2 md:px-6">
				<div class="pointer-events-none absolute -top-20 -left-10 h-56 w-56 rounded-full bg-[#DC2626]/16 blur-[90px]"></div>
				<div class="pointer-events-none absolute -bottom-20 right-0 h-64 w-64 rounded-full bg-[#0F172A]/12 dark:bg-[#475569]/22 blur-[110px]"></div>

