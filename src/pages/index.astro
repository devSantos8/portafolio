---
// Layout
import Layout from '../layouts/Layout.astro';
import SectionContainer from '../components/SectionContainer.astro';

// UI Components
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import SkillCard from '../components/SkillCard.astro';

// Icons
import HTML from '../components/icons/HTML.astro';
import JavaScript from '../components/icons/JavaScript.astro';
import ReactIcon from '../components/icons/React.astro';
import Tailwind from '../components/icons/Tailwind.astro';
import AstroIcon from '../components/icons/Astro.astro';
import BootstrapIcon from '../components/icons/Bootstrap.astro';
import PythonIcon from '../components/icons/Python.astro';
import DjangoIcon from '../components/icons/Django.astro';
import APIIcon from '../components/icons/API.astro';
import PostgresIcon from '../components/icons/Postgres.astro';
import MongoIcon from '../components/icons/Mongo.astro';
import MariaIcon from '../components/icons/Maria.astro';

// Fonts
import '@fontsource/barlow/300.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/instrument-serif/400-italic.css';

const certificates = [
	{
		title: 'Desarrollo Full Stack',
		issuer: 'INACAP',
		year: '2025',
		description: 'Desarrollo de aplicaciones web completas con frontend, backend y buenas prácticas de despliegue.',
		url: '',
		featured: true,
	},
	{
		title: 'Git Fundamentals',
		issuer: 'DataCamp',
		year: '2025',
		description: 'Fundamentos de Git y GitHub para control de versiones, trabajo colaborativo y flujos de desarrollo modernos.',
		url: '',
		featured: true,
	},
	{
		title: 'AWS Academy Graduate - AWS Academy Cloud Foundations',
		issuer: 'AWS Academy',
		year: '2024',
		description: 'Curso de fundamentos cloud en AWS: conceptos de nube, servicios principales, seguridad y buenas prácticas iniciales.',
		url: '',
		featured: true,
	},
	{
		title: 'Soporte Computacional',
		issuer: 'INACAP',
		year: '2023',
		description: 'Diagnóstico, mantenimiento y resolución de incidencias en entornos de hardware y software.',
		url: '',
		featured: false,
	},
];

const featuredCertificates = certificates.filter((certificate) => certificate.featured);
const linkedInCertificationsUrl = 'https://www.linkedin.com/in/jmonroys17/details/certifications/';
const googleAccentClasses = ['bg-[#4285F4]', 'bg-[#EA4335]', 'bg-[#FBBC05]', 'bg-[#34A853]'];
