---
// Layout
import Layout from '../layouts/Layout.astro';
import SectionContainer from '../components/SectionContainer.astro';

// UI Components
import Footer from '../components/Footer.astro';
---

<Layout title="Joain Monroy · Ingeniero en Informática">
	<main>
		<!-- Hero Section -->
		<section id="top" class="min-h-screen flex flex-col justify-center px-8 md:px-16 lg:px-24 xl:px-32 py-32 relative overflow-hidden">
			<!-- Círculo decorativo -->
			<div class="absolute right-[5%] md:right-[10%] lg:right-[15%] top-[15%] md:top-[18%] w-[280px] h-[280px] md:w-[400px] md:h-[400px] lg:w-[480px] lg:h-[480px] rounded-full bg-blue-400/40 dark:bg-blue-400/30 -z-10 animate-pulse-soft"></div>
			
			<div class="max-w-4xl mx-auto w-full">
				<p class="animate-fade-up text-[11px] font-semibold uppercase tracking-[0.3em] text-blue-600 dark:text-blue-400 mb-10">
					Ingeniero en Informática
				</p>
				<h1 class="animate-fade-up-delay-1 text-[clamp(2.5rem,8vw,4.5rem)] font-medium text-gray-900 dark:text-white leading-[1.1] mb-10 tracking-tight">
					Desarrollo de software<br/>
					<span class="text-gray-500 dark:text-gray-400">y soluciones DevOps</span>
				</h1>
				<p class="animate-fade-up-delay-2 text-base md:text-lg text-gray-700 dark:text-gray-300 max-w-lg leading-relaxed">
					Creo aplicaciones web eficientes y escalables,
					combinando código limpio con automatización de procesos.
				</p>
				
				<nav class="animate-fade-up-delay-3 flex flex-wrap gap-4 mt-16">
					<a href="https://github.com/17santo" target="_blank" rel="noopener" 
					   class="inline-flex items-center gap-2 px-5 py-3 bg-gray-900 dark:bg-white text-white dark:text-gray-900 text-sm font-medium rounded-full hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors duration-300">
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
						GitHub
					</a>
					<a href="https://www.linkedin.com/in/jmonroys17/" target="_blank" rel="noopener"
					   class="inline-flex items-center gap-2 px-5 py-3 bg-gray-900 dark:bg-white text-white dark:text-gray-900 text-sm font-medium rounded-full hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors duration-300">
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
						LinkedIn
					</a>
					<a href="mailto:joainmonroy12@gmail.com"
					   class="inline-flex items-center gap-2 px-5 py-3 bg-gray-900 dark:bg-white text-white dark:text-gray-900 text-sm font-medium rounded-full hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors duration-300">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
						Contacto
					</a>
				</nav>
			</div>
		</section>

		<!-- ======================= -->
		<!-- EJEMPLO 1: Timeline vertical elegante -->
		<!-- ======================= -->
		<SectionContainer class="py-32 md:py-40" bg="bg-gray-50 dark:bg-gray-900/30">
			<div class="fade-in-section">
				<div class="flex flex-col md:flex-row md:items-end gap-6 mb-20">
					<p class="text-[11px] font-semibold uppercase tracking-[0.3em] text-blue-600 dark:text-blue-400 md:pb-1">
						Trayectoria
					</p>
					<h2 class="text-4xl md:text-5xl font-medium text-gray-900 dark:text-white tracking-tight">
						Experiencia
					</h2>
					<span class="hidden md:block flex-1 h-[1px] bg-gray-200 dark:bg-gray-800 mb-3"></span>
				</div>
				
				<div class="relative">
					<!-- Línea vertical principal -->
					<div class="absolute left-6 md:left-8 top-0 bottom-0 w-[1px] bg-gradient-to-b from-blue-500 via-gray-200 to-transparent dark:via-gray-800"></div>
					
					<div class="space-y-16 md:space-y-20">
						<!-- Item 1: Práctica actual -->
						<div class="relative pl-16 md:pl-24 group">
							<!-- Círculo con animación -->
							<div class="absolute left-6 md:left-8 top-0 -translate-x-1/2">
								<div class="w-4 h-4 rounded-full border-2 border-blue-500 bg-white dark:bg-gray-900 group-hover:scale-125 transition-transform duration-300"></div>
								<div class="absolute inset-0 w-4 h-4 rounded-full bg-blue-500/20 animate-ping"></div>
							</div>
							
							<!-- Contenido -->
							<div class="pb-2">
								<div class="flex flex-wrap items-center gap-3 mb-4">
									<span class="text-xs font-medium px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400">
										Actual
									</span>
									<span class="text-sm text-gray-500 dark:text-gray-500">Mar 2025 — Presente</span>
								</div>
								<h3 class="text-2xl md:text-3xl font-medium text-gray-900 dark:text-white mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-300">
									Práctica Profesional
								</h3>
								<p class="text-lg text-gray-600 dark:text-gray-400 mb-4">
									Empresa
								</p>
								<p class="text-base text-gray-500 dark:text-gray-500 leading-relaxed max-w-2xl">
									Descripción de las tareas y responsabilidades en la práctica.
								</p>
							</div>
						</div>

						<!-- Item 2: Trabajo anterior -->
						<div class="relative pl-16 md:pl-24 group">
							<div class="absolute left-6 md:left-8 top-0 -translate-x-1/2">
								<div class="w-4 h-4 rounded-full border-2 border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 group-hover:border-blue-500 group-hover:scale-125 transition-all duration-300"></div>
							</div>
							
							<div class="pb-2">
								<div class="flex flex-wrap items-center gap-3 mb-4">
									<span class="text-xs font-medium px-3 py-1 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400">
										Experiencia
									</span>
									<span class="text-sm text-gray-500 dark:text-gray-500">Ene — Feb 2025</span>
								</div>
								<h3 class="text-2xl md:text-3xl font-medium text-gray-900 dark:text-white mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-300">
									Cargo
								</h3>
								<p class="text-lg text-gray-600 dark:text-gray-400 mb-4">
									Empresa
								</p>
								<p class="text-base text-gray-500 dark:text-gray-500 leading-relaxed max-w-2xl">
									Descripción de las tareas y responsabilidades en este puesto.
								</p>
							</div>
						</div>

						<!-- Item 3: Estudios -->
						<div class="relative pl-16 md:pl-24 group">
							<div class="absolute left-6 md:left-8 top-0 -translate-x-1/2">
								<div class="w-4 h-4 rounded-full border-2 border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 group-hover:border-blue-500 group-hover:scale-125 transition-all duration-300"></div>
							</div>
							
							<div class="pb-2">
								<div class="flex flex-wrap items-center gap-3 mb-4">
									<span class="text-xs font-medium px-3 py-1 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400">
										Educación
									</span>
									<span class="text-sm text-gray-500 dark:text-gray-500">2022 — 2025</span>
								</div>
								<h3 class="text-2xl md:text-3xl font-medium text-gray-900 dark:text-white mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-300">
									Ingeniería en Informática
								</h3>
								<p class="text-lg text-gray-600 dark:text-gray-400 mb-4">
									INACAP Santiago Centro
								</p>
								<p class="text-base text-gray-500 dark:text-gray-500 leading-relaxed max-w-2xl">
									Formación integral en desarrollo de software, bases de datos, redes, metodologías ágiles y DevOps. Orientado al desarrollo web y automatización de procesos.
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</SectionContainer>

