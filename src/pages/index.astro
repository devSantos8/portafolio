		<!-- Projects Section -->
		<section id="Proyectos" class="px-4 md:px-8 lg:px-16 xl:px-24 py-32 md:py-40">
			<div class="max-w-7xl mx-auto">
				<!-- Header -->
				<div class="fade-in-section flex flex-col md:flex-row md:items-end gap-6 mb-16 px-4">
					<p class="text-[11px] font-bold uppercase tracking-[0.3em] text-[#DC2626] md:pb-1">01</p>
					<h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white tracking-tighter">Proyectos</h2>
					<span class="hidden md:block flex-1 h-[1px] bg-gray-200 dark:bg-gray-800 mb-3"></span>
				</div>

				<!-- Projects Grid - 2x2 Softer Cards -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
					
					<!-- Proyecto 1: CommitFlow -->
					<article class="fade-in-section group relative rounded-[1.5rem] overflow-hidden bg-[#E0F2FE] dark:bg-[#1E3A5F] p-6 md:p-8 flex flex-col transition-all duration-500 hover:shadow-xl hover:shadow-sky-500/10 hover:-translate-y-1">
						<div class="flex items-center justify-between mb-4">
							<h3 class="text-gray-900 dark:text-white text-base md:text-lg font-bold tracking-tight">CommitFlow</h3>
							<span class="text-gray-500 dark:text-gray-400 text-[10px] font-semibold uppercase tracking-widest">Proyecto de Título</span>
						</div>
						<div class="rounded-xl overflow-hidden border border-black/5 dark:border-white/10 shadow-lg">
							<img src="../projects/workco.webp" alt="CommitFlow" class="w-full h-[160px] md:h-[200px] object-cover object-top transition-transform duration-700 group-hover:scale-[1.03]" />
						</div>
						<div class="mt-5 flex flex-wrap gap-2">
							<span class="text-[10px] font-semibold text-gray-600 dark:text-gray-300 bg-white/60 dark:bg-white/10 px-3 py-1.5 rounded-full">Django</span>
							<span class="text-[10px] font-semibold text-gray-600 dark:text-gray-300 bg-white/60 dark:bg-white/10 px-3 py-1.5 rounded-full">Python</span>
							<span class="text-[10px] font-semibold text-gray-600 dark:text-gray-300 bg-white/60 dark:bg-white/10 px-3 py-1.5 rounded-full">PostgreSQL</span>
						</div>
					</article>

					<!-- Proyecto 2: Dashboard -->
					<article class="fade-in-section group relative rounded-[1.5rem] overflow-hidden bg-[#EDE9FE] dark:bg-[#2D1B69] p-6 md:p-8 flex flex-col transition-all duration-500 hover:shadow-xl hover:shadow-violet-500/10 hover:-translate-y-1">
						<div class="flex items-center justify-between mb-4">
							<h3 class="text-gray-900 dark:text-white text-base md:text-lg font-bold tracking-tight">Dashboard E-commerce</h3>
							<span class="text-gray-500 dark:text-gray-400 text-[10px] font-semibold uppercase tracking-widest">Panel</span>
						</div>
						<div class="rounded-xl overflow-hidden border border-black/5 dark:border-white/10 shadow-lg">
							<img src="../projects/dashboard.webp" alt="Dashboard E-commerce" class="w-full h-[160px] md:h-[200px] object-cover object-top transition-transform duration-700 group-hover:scale-[1.03]" />
						</div>
						<div class="mt-5 flex flex-wrap gap-2">
							<span class="text-[10px] font-semibold text-gray-600 dark:text-gray-300 bg-white/60 dark:bg-white/10 px-3 py-1.5 rounded-full">Django</span>
							<span class="text-[10px] font-semibold text-gray-600 dark:text-gray-300 bg-white/60 dark:bg-white/10 px-3 py-1.5 rounded-full">Python</span>
							<span class="text-[10px] font-semibold text-gray-600 dark:text-gray-300 bg-white/60 dark:bg-white/10 px-3 py-1.5 rounded-full">JavaScript</span>
						</div>
					</article>

					<!-- Proyecto 3: Lubricentro -->
					<article class="fade-in-section group relative rounded-[1.5rem] overflow-hidden bg-[#FEF3C7] dark:bg-[#5C3D0E] p-6 md:p-8 flex flex-col transition-all duration-500 hover:shadow-xl hover:shadow-amber-500/10 hover:-translate-y-1">
						<div class="flex items-center justify-between mb-4">
							<h3 class="text-gray-900 dark:text-white text-base md:text-lg font-bold tracking-tight">Lubricentro La Esquina</h3>
							<a href="https://lubricentro-la-esquina.vercel.app" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-gray-500 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white text-[10px] font-semibold uppercase tracking-widest transition-colors duration-300">
								Live
								<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
							</a>
						</div>
						<div class="rounded-xl overflow-hidden border border-black/5 dark:border-white/10 shadow-lg">
							<img src="../projects/lubricentro.webp" alt="Lubricentro La Esquina" class="w-full h-[160px] md:h-[200px] object-cover object-top transition-transform duration-700 group-hover:scale-[1.03]" />
						</div>
						<div class="mt-5 flex flex-wrap gap-2">
							<span class="text-[10px] font-semibold text-gray-600 dark:text-gray-300 bg-white/60 dark:bg-white/10 px-3 py-1.5 rounded-full">Astro</span>
							<span class="text-[10px] font-semibold text-gray-600 dark:text-gray-300 bg-white/60 dark:bg-white/10 px-3 py-1.5 rounded-full">Tailwind</span>
							<span class="text-[10px] font-semibold text-gray-600 dark:text-gray-300 bg-white/60 dark:bg-white/10 px-3 py-1.5 rounded-full">JavaScript</span>
						</div>
					</article>

					<!-- Card 4: Ver más -->
					<a href="https://github.com/17santo" target="_blank" rel="noopener" class="fade-in-section group relative rounded-[1.5rem] overflow-hidden bg-gray-100 dark:bg-[#18181B] border-2 border-dashed border-gray-300 dark:border-gray-700 p-6 md:p-8 flex flex-col items-center justify-center min-h-[280px] md:min-h-[340px] transition-all duration-500 hover:border-[#DC2626] hover:bg-red-50/50 dark:hover:bg-[#DC2626]/5 hover:-translate-y-1 cursor-pointer">
						<div class="w-16 h-16 rounded-full bg-gray-200 dark:bg-gray-800 flex items-center justify-center mb-6 group-hover:bg-[#DC2626]/10 dark:group-hover:bg-[#DC2626]/20 transition-colors duration-300">
							<svg class="w-7 h-7 text-gray-400 dark:text-gray-500 group-hover:text-[#DC2626] transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"/>
							</svg>
						</div>
						<p class="text-lg font-bold text-gray-400 dark:text-gray-500 group-hover:text-[#DC2626] transition-colors duration-300 tracking-tight">Ver más proyectos</p>
						<p class="text-xs text-gray-400 dark:text-gray-600 mt-2 group-hover:text-gray-500 dark:group-hover:text-gray-400 transition-colors">en GitHub</p>
					</a>

				</div>
			</div>
		</section>

		<!-- About Section -->
		<SectionContainer id="Sobre-mi" class="py-32 md:py-40" bg="bg-slate-50/50 dark:bg-[#0F1115]">
			<div class="fade-in-section flex flex-col md:flex-row md:items-end gap-6 mb-20">
				<p class="text-[11px] font-semibold uppercase tracking-[0.3em] text-[#DC2626] md:pb-1">
					02
				</p>
				<h2 class="text-4xl md:text-5xl font-medium text-gray-900 dark:text-white tracking-tight">
					Sobre mí
				</h2>
				<span class="hidden md:block flex-1 h-[1px] bg-gray-200 dark:bg-gray-800 mb-3"></span>
			</div>
			
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-20 lg:gap-32">
				<div class="fade-in-section space-y-8">
					<p class="text-2xl md:text-3xl font-medium text-gray-900 dark:text-white leading-relaxed tracking-tight">
						Soy Joain Monroy Santos,<br/>
						<span class="text-gray-400 dark:text-gray-500">Ingeniero en Informática orientado al desarrollo de software y DevOps.</span>
					</p>
					<p class="text-base text-gray-600 dark:text-gray-400 leading-loose">
						Me especializo en crear soluciones web que combinan
						buenas prácticas de desarrollo con automatización.
						Cada proyecto es una oportunidad para escribir código
						limpio y construir sistemas escalables.
					</p>
					<p class="text-base text-gray-600 dark:text-gray-400 leading-loose">
						Egresado de INACAP Santiago Centro, donde desarrollé
						habilidades en desarrollo full stack, diseño de sistemas
						y gestión de bases de datos.
					</p>
				</div>

				<div class="fade-in-section space-y-14">
					<div>
						<p class="text-[11px] font-semibold uppercase tracking-[0.3em] text-[#DC2626] mb-5">
							Educación
						</p>
						<p class="text-lg font-medium text-gray-900 dark:text-white tracking-tight">Ingeniería en Informática</p>
						<p class="text-sm text-gray-500 dark:text-gray-500 mt-1">INACAP Santiago Centro · 2022 — 2025</p>
					</div>

					<div>
						<p class="text-[11px] font-semibold uppercase tracking-[0.3em] text-[#DC2626] mb-5">
							Certificaciones
						</p>
						<ul class="space-y-3 text-sm text-gray-600 dark:text-gray-400">
							<li class="hover:text-gray-900 dark:hover:text-white transition-colors duration-300">Desarrollo Full Stack</li>
