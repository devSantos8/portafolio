							02
						</div>
						<div class="relative">
							<div class="flex flex-wrap items-center gap-3 mb-6">
								<span class="text-xs font-medium px-3 py-1 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400">
									Proyecto de Título
								</span>
								<span class="text-sm text-gray-500 dark:text-gray-500">2024</span>
							</div>
							<h3 class="text-2xl md:text-3xl font-medium text-gray-900 dark:text-white mb-3 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-300">
								CommitFlow
							</h3>
							<p class="text-lg text-gray-600 dark:text-gray-400 mb-6">
								Desarrollo Full-Stack
							</p>
							<p class="text-base text-gray-500 dark:text-gray-500 leading-relaxed">
								Plataforma de conexión laboral para profesionales TI desarrollada con Django, Python y PostgreSQL.
							</p>
						</div>
					</div>
				</div>
			</div>
		</SectionContainer>
