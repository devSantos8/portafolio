		<!-- Projects Section - Premium Edition -->
		<section
			id="Proyectos"
			class="relative px-4 md:px-8 lg:px-16 xl:px-24 py-32 md:py-44 bg-transparent overflow-hidden"
		>
			<style is:inline>
				@keyframes projectSlideUp {
					from { opacity: 0; transform: translateY(40px) scale(0.95); }
					to { opacity: 1; transform: translateY(0) scale(1); }
				}

				.project-premium-card {
					opacity: 0;
					animation: projectSlideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
					transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
				}

				.project-premium-card:nth-child(1) { animation-delay: 0.1s; }
				.project-premium-card:nth-child(2) { animation-delay: 0.2s; }
				.project-premium-card:nth-child(3) { animation-delay: 0.3s; }

				.project-premium-card:hover {
					transform: translateY(-8px);
				}

				.project-image-wrapper {
					overflow: hidden;
					transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
				}

				.project-image-wrapper img {
					transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), filter 0.6s ease;
					will-change: transform;
					filter: brightness(0.95) saturate(1.05);
				}

				.project-premium-card:hover .project-image-wrapper img {
					transform: scale(1.08) rotate(-1deg);
					filter: brightness(1.05) saturate(1.1);
				}
				
				.project-glow {
					transition: opacity 0.6s ease;
				}
				.project-premium-card:hover .project-glow {
					opacity: 1;
				}
			</style>

			<div class="relative z-10 max-w-7xl mx-auto">
				<!-- Header -->
				<div class="flex flex-col md:flex-row md:items-end gap-6 mb-24 relative fade-in-section">
