---
// Layout
import Layout from '../layouts/Layout.astro';
import SectionContainer from '../components/SectionContainer.astro';

// UI Components
import Badge from '../components/Badge.astro';
import SocialPill from '../components/SocialPill.astro';
import Projects from '../components/Projects.astro';
import Stack from '../components/Stack.astro';
import Footer from '../components/Footer.astro';

// Icons
import LinkedInIcon from '../components/icons/LinkedIn.astro';
import GithubIcon from '../components/icons/Github.astro';
import CodeIcon from '../components/icons/Code.astro';
import MeIcon from '../components/icons/Me.astro';
import Postgres from '../components/icons/Postgres.astro';
import MariaIcon from '../components/icons/Maria.astro';
import Mail from '../components/icons/Mail.astro';
import DjangoIcon from '../components/icons/Django.astro';
import MongoIcon from '../components/icons/Mongo.astro';
import AstroIcon from '../components/icons/Astro.astro';
import ReactIcon from '../components/icons/React.astro';
import BootstrapIcon from '../components/icons/Bootstrap.astro';
---

<Layout title="Portafolio de joain monroy">
	<main class="pt-20">
		<SectionContainer class="py-24 sm:py-44 pb-22">
			<h1 class="text-black dark:text-white text-3xl sm:text-5xl font-bold flex flex-row gap-x-4 pb-8 flex-wrap">
				Hola, <span class="underline underline-offset-3 decoration-5 decoration-blue-400 dark:decoration-blue-600">Soy devSantos</span>
				<div class="flex justify-center items-center">
					<Badge>Desarrollador</Badge>
				</div>
			</h1>
			<h2 class="text-lg sm:text-xl text-black/80 dark:text-white/80 max-w-[700px]">
				<span>Desarrollador </span>
				<span class="text-blue-400">Full Stack</span>
				<span> en Santiago, Chile.</span>
				Especializado en crear soluciones web innovadoras y experiencias digitales excepcionales. 
				Estudiante de último año en <span class="text-blue-400/90">Ingeniería en Informática</span>.
			</h2>

			<p class="text-lg italic mt-4 text-black/60 dark:text-white/60 max-w-[700px]">
				Me apasiona transformar ideas en aplicaciones web funcionales y elegantes, 
				combinando diseño intuitivo con código limpio y eficiente.
			</p>

			<nav class="flex flex-wrap gap-4 mt-8">
				<SocialPill href="https://www.linkedin.com/in/jmonroys17/">
					<LinkedInIcon class="size-6"/>
				LinkedIn
				</SocialPill>
				<SocialPill href="https://github.com/17santo">
					<GithubIcon class="size-6"/>
				GitHub
				</SocialPill>
			</nav>
		</SectionContainer>

		<SectionContainer id="Proyectos" class="py-20 pb-10" >
			<h2 class="text-2xl font-semibold mb-6 flex items-center gap-x-3 text-black dark:text-white">
				<CodeIcon class="size-7" /> 
				<span class="flex-shrink-0">Proyectos</span>
				<span class="h-[1px] w-full bg-black/20 dark:bg-white/20"></span>
			</h2>
				<Projects />
		</SectionContainer>

		<SectionContainer id="Sobre-mi" class="py-20 pb-10">
			<h2 class="text-2xl font-semibold mb-12 flex items-center gap-x-3 text-black dark:text-white">
				<MeIcon class="size-7" /> 
				<span class="flex-shrink-0">Sobre mi</span>
				<span class="h-[1px] w-full bg-black/20 dark:bg-white/20"></span>
			</h2>
			
			<div class="grid grid-cols-1 md:grid-cols-[1fr,400px] gap-x-8 gap-y-10">
				{/* Columna Principal */}
				<div class="flex flex-col gap-6">
					<div class="relative">
						<div class="absolute -left-2 top-0 h-full w-1 bg-gradient-to-b from-blue-500 to-blue-800 rounded-full"></div>
						<p class="text-pretty text-black/80 dark:text-white/80 leading-relaxed pl-4">
							Mi Nombre es Joain Monroy Santos, tengo 21 años y Soy un Desarrollador Web Full Stack con un enfoque en crear experiencias digitales excepcionales. 
							Mi pasión por la tecnología me llevó a estudiar Ingeniería en Informática, 
							donde actualmente curso mi último año.
						</p>
					</div>

					<article class="bg-black/5 dark:bg-white/5 rounded-lg p-6 transition hover:bg-black/10 dark:hover:bg-white/10">
						<h3 class="text-lg font-semibold text-black dark:text-white mb-4 flex items-center gap-x-2">
							<svg 
								class="size-5 text-blue-500"
								xmlns="http://www.w3.org/2000/svg" 
								fill="none" 
								viewBox="0 0 24 24" 
								stroke-width="1.5" 
								stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />
							</svg>
							Educación y Certificados
						</h3>
						<ul class="text-sm text-black/70 dark:text-white/70 space-y-2 list-disc list-inside">
							<li>Ingeniería en Informática - INACAP (2022 - 2025)</li>
							<div class="border-t border-gray-200 dark:border-gray-700 my-2"></div>
							<li>Desarrollo Full Stack</li>
							<li>Diseño Ágil de Sistemas</li>
							<li>Soporte Computacional</li>
							<li>Desarrollo de Aplicaciones Básicas</li>
							<li>Diseño y Gestión de BDD</li>
						</ul>
					</article>

					<article class="bg-black/5 dark:bg-white/5 rounded-lg p-6 transition hover:bg-black/10 dark:hover:bg-white/10">
						<h3 class="text-lg font-semibold text-black dark:text-white mb-4 flex items-center gap-x-2">
							<svg 
								class="size-5 text-blue-500"
								xmlns="http://www.w3.org/2000/svg" 
								width="24" 
								height="24" 
								viewBox="0 0 24 24" 
								fill="none" 
								stroke="currentColor" 
								stroke-width="1.5" 
								stroke-linecap="round" 
								stroke-linejoin="round">
								<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
								<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
							</svg>
							Objetivos Profesionales
						</h3>
						<p class="text-black/70 dark:text-white/70">
							Aspiro a ser un Profesional capaz de crear soluciones tecnológicas innovadoras y de alto impacto,
							con cada progreso y aprendizaje, busco mejorar mis habilidades y conocimientos como Ingeniero en Informática.
						</p>
					</article>
				</div>

				{/* Panel Lateral */}
				<aside class="flex flex-col gap-6">
					{/* Card de Skills */}
					<article class="bg-black/5 dark:bg-white/5 rounded-lg p-6 sticky top-24 min-w-[300px] max-w-[400px] w-full mx-auto">
						<h3 class="text-lg font-semibold text-black dark:text-white mb-4">Habilidades Técnicas</h3>
						<div class="flex flex-wrap gap-2 mb-4">
							<span class="bg-gray-200 text-gray-800 text-sm font-medium px-2.5 py-0.5 rounded-full dark:bg-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">Desarrollo Frontend</span>
							<span class="bg-gray-200 text-gray-800 text-sm font-medium px-2.5 py-0.5 rounded-full dark:bg-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">Desarrollo Backend</span>
							<span class="bg-gray-200 text-gray-800 text-sm font-medium px-2.5 py-0.5 rounded-full dark:bg-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">Bases de Datos</span>
							<span class="bg-gray-200 text-gray-800 text-sm font-medium px-2.5 py-0.5 rounded-full dark:bg-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">Hardware y Software</span>
						</div>

						<div class="border-t border-gray-200 dark:border-gray-700 my-4"></div>

						<h3 class="text-lg font-semibold text-black dark:text-white mb-4">Habilidades Blandas</h3>
						<div class="flex flex-wrap gap-2 mb-4">
							<span class="bg-gray-200 text-gray-800 text-sm font-medium px-2.5 py-0.5 rounded-full dark:bg-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">Comunicación Efectiva</span>
							<span class="bg-gray-200 text-gray-800 text-sm font-medium px-2.5 py-0.5 rounded-full dark:bg-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">Resolución de Problemas</span>
							<span class="bg-gray-200 text-gray-800 text-sm font-medium px-2.5 py-0.5 rounded-full dark:bg-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">Trabajo en Equipo</span>
							<span class="bg-gray-200 text-gray-800 text-sm font-medium px-2.5 py-0.5 rounded-full dark:bg-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">Pensamiento Crítico</span>
							<span class="bg-gray-200 text-gray-800 text-sm font-medium px-2.5 py-0.5 rounded-full dark:bg-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">Adaptabilidad</span>
						</div>

						<div class="border-t border-gray-200 dark:border-gray-700 my-4"></div>

						<h3 class="text-lg font-semibold text-black dark:text-white mb-4">Idiomas</h3>
						<div class="flex flex-wrap gap-2">
							<span class="bg-gray-200 text-gray-800 text-sm font-medium px-2.5 py-0.5 rounded-full dark:bg-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">Español (Nativo)</span>
							<span class="bg-gray-200 text-gray-800 text-sm font-medium px-2.5 py-0.5 rounded-full dark:bg-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">Inglés (Intermedio)</span>
						</div>
					</article>

					{/* Separador después del inglés */}
					<div class="border-t border-gray-200 dark:border-gray-700 mt-3 pt-4">
						<div class="flex items-center justify-between text-sm">
							<span class="text-black/70 dark:text-white/70">Contacto Rápido:</span>
							<div class="flex gap-3">
								<a href="https://github.com/devSantos8"
									class="text-black/60 hover:text-black dark:text-white/60 dark:hover:text-white transition"
									target="_blank"
									rel="noopener"
								>
									<GithubIcon class="size-5" />
								</a>
								<a href="https://www.linkedin.com/in/jmonroys17/"
									class="text-black/60 hover:text-black dark:text-white/60 dark:hover:text-white transition"
									target="_blank"
									rel="noopener"
								>
									<LinkedInIcon class="size-5" />
								</a>
								<a href="mailto:joainmonroy12@gmail.com"
									class="text-black/60 hover:text-black dark:text-white/60 dark:hover:text-white transition"
								>
									<Mail class="size-5" />
								</a>
							</div>
						</div>
					</article>
				</aside>
			</div>
		</SectionContainer>

		<SectionContainer id="Habilidades" class="py-20 pb-10">
			<h2 class="text-2xl font-semibold mb-6 flex items-center gap-x-3 text-black dark:text-white">
				<MeIcon class="size-7" /> 
				<span class="flex-shrink-0">Habilidades</span>
				<span class="h-[1px] w-full bg-black/20 dark:bg-white/20"></span>
			</h2>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {/* Desarrollo Frontend */}
                <article class="rounded-xl p-6 bg-black/5 dark:bg-white/5 border-black/10 dark:border-white/10 hover:bg-black/10 dark:hover:bg-white/10 transition">
                    <h3 class="text-lg font-semibold text-black dark:text-white mb-4">Desarrollo Frontend</h3>
                    <ul class="flex flex-wrap gap-2">
                        <SocialPill class="bg-orange-100/10 text-orange-400 hover:bg-orange-100/20 dark:bg-orange-900/10 dark:hover:bg-orange-900/20">
                            <svg class="size-4" viewBox="0 0 24 24"><path fill="currentColor" d="M1.5 0h21l-1.91 21.563L11.977 24l-8.564-2.438L1.5 0zm7.031 9.75l-.232-2.718 10.059.003.23-2.622L5.412 4.41l.698 8.01h9.126l-.326 3.426-2.91.804-2.955-.81-.188-2.11H6.248l.33 4.171L12 19.351l5.379-1.443.744-8.157H8.531z"/></svg>
                            HTML
                        </SocialPill>
                        <SocialPill class="bg-blue-100/10 text-blue-400 hover:bg-blue-100/20 dark:bg-blue-900/10 dark:hover:bg-blue-900/20">
                            <svg class="size-4" viewBox="0 0 24 24"><path fill="currentColor" d="M1.5 0h21l-1.91 21.563L11.977 24l-8.565-2.438L1.5 0zm17.09 4.413L5.41 4.41l.213 2.622 10.125.002-.255 2.716h-6.64l.24 2.573h6.182l-.366 3.523-2.91.804-2.956-.81-.188-2.11h-2.61l.29 3.855L12 19.288l5.373-1.53L18.59 4.414z"/></svg>
                            CSS
                        </SocialPill>
                        <SocialPill class="bg-yellow-100/10 text-yellow-400 hover:bg-yellow-100/20 dark:bg-yellow-900/10 dark:hover:bg-yellow-900/20">
                            <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path fill="currentColor" d="M0 32v448h448V32H0zm243.8 349.4c0 43.6-25.6 63.5-62.9 63.5-33.7 0-53.2-17.4-63.2-38.5l34.3-20.7c6.6 11.7 12.6 21.6 27.1 21.6 13.8 0 22.6-5.4 22.6-26.5V237.7h42.1v143.7zm99.6 63.5c-39.1 0-64.4-18.6-76.7-43l34.3-19.8c9 14.7 20.8 25.6 41.5 25.6 17.4 0 28.6-8.7 28.6-20.8 0-14.4-11.4-19.5-30.7-28l-10.5-4.5c-30.4-12.9-50.5-29.2-50.5-63.5 0-31.6 24.1-55.6 61.6-55.6 26.8 0 46 9.3 59.8 33.7L368 290c-7.2-12.9-15-18-27.1-18-12.3 0-20.1 7.8-20.1 18 0 12.6 7.8 17.7 25.9 25.6l10.5 4.5c35.8 15.3 55.9 31 55.9 66.2 0 37.8-29.8 58.6-69.7 58.6z"/></svg>
                            JavaScript
                        </SocialPill>
                        <SocialPill class="bg-blue-100/10 text-blue-400 hover:bg-blue-100/20 dark:bg-blue-900/10 dark:hover:bg-blue-900/20">
                            <ReactIcon /></svg>
                            React
                        </SocialPill>
                        <SocialPill class="bg-cyan-100/10 text-cyan-400 hover:bg-cyan-100/20 dark:bg-cyan-900/10 dark:hover:bg-cyan-900/20">
                            <svg class="size-4" viewBox="0 0 24 24"><path fill="currentColor" d="M12.001 4.8c-3.2 0-5.2 1.6-6 4.8c1.2-1.6 2.6-2.2 4.2-1.8c.913.228 1.565.89 2.288 1.624C13.666 10.618 15.027 12 18.001 12c3.2 0 5.2-1.6 6-4.8c-1.2 1.6-2.6 2.2-4.2 1.8c-.913-.228-1.565-.89-2.288-1.624C16.337 6.182 14.976 4.8 12.001 4.8zm-6 7.2c-3.2 0-5.2 1.6-6 4.8c1.2-1.6 2.6-2.2 4.2-1.8c.913.228 1.565.89 2.288 1.624c1.177 1.194 2.538 2.576 5.512 2.576c3.2 0 5.2-1.6 6-4.8c-1.2 1.6-2.6 2.2-4.2 1.8c-.913-.228-1.565-.89-2.288-1.624C10.337 13.382 8.976 12 6.001 12z"/></svg>
                            TailwindCSS
                        </SocialPill>
                        <SocialPill class="bg-purple-100/10 text-purple-400 hover:bg-purple-100/20 dark:bg-purple-900/10 dark:hover:bg-purple-900/20">
                            <svg class="size-4" viewBox="0 0 16 16">
                                <BootstrapIcon />
                            </svg>
                            Bootstrap
                        </SocialPill>
                        <SocialPill class="bg-purple-100/10 text-purple-400 hover:bg-purple-100/20 dark:bg-purple-900/10 dark:hover:bg-purple-900/20">
                            <AstroIcon /> 
                            Astro
                        </SocialPill>
                    </ul>
                </article>

                {/* Desarrollo Backend */}
                <article class="rounded-xl p-6 bg-black/5 dark:bg-white/5 border-black/10 dark:border-white/10 hover:bg-black/10 dark:hover:bg-white/10 transition">
                    <h3 class="text-lg font-semibold text-black dark:text-white mb-4">Desarrollo Backend</h3>
                    <ul class="flex flex-wrap gap-2">
                        <SocialPill class="bg-green-100/10 text-green-400 hover:bg-green-100/20 dark:bg-green-900/10 dark:hover:bg-green-900/20">
                            <svg class="size-4" viewBox="0 0 24 24"><path fill="currentColor" d="M14 18.594v-3.725c0-.237.192-.432.432-.432h3.725L14 18.594zM13 16c-.545 0-1 .455-1 1v4H6.455C5.65 21 5 20.35 5 19.545V4.455C5 3.65 5.65 3 6.455 3h11.09C18.35 3 19 3.65 19 4.455V15h-5c-.545 0-1 .455-1 1zm-2-7c0-.275.225-.5.5-.5h5c.275 0 .5.225.5.5v1c0 .275-.225.5-.5.5h-5c-.275 0-.5-.225-.5-.5V9zm0-3c0-.275.225-.5.5-.5h5c.275 0 .5.225.5.5v1c0 .275-.225.5-.5.5h-5c-.275 0-.5-.225-.5-.5V6zm-2 6c0-.275.225-.5.5-.5h7c.275 0 .5.225.5.5v1c0 .275-.225.5-.5.5h-7c-.275 0-.5-.225-.5-.5v-1z"/></svg>
                            Python
                        </SocialPill>
                        <SocialPill class="bg-emerald-100/10 text-emerald-400 hover:bg-emerald-100/20 dark:bg-emerald-900/10 dark:hover:bg-emerald-900/20">
                            <DjangoIcon />
                            Django
                        </SocialPill>
                    </ul>
                </article>

				{/* Bases de Datos y Otros */}
				<article class="rounded-xl p-6 bg-black/5 dark:bg-white/5 border-black/10 dark:border-white/10 hover:bg-black/10 dark:hover:bg-white/10 transition">
					<h3 class="text-lg font-semibold text-black dark:text-white mb-4">Bases de Datos & Otros</h3>
					<ul class="flex flex-wrap gap-2">
					  <SocialPill class="bg-blue-100/10 text-blue-400 hover:bg-blue-100/20 dark:bg-blue-900/10 dark:hover:bg-blue-900/20">
						<Postgres alt="PostgreSQL" class="w-4 h-4 mr-2"/> PostgreSQL
					  </SocialPill>
					  <SocialPill class="bg-green-100/10 text-green-400 hover:bg-green-100/20 dark:bg-green-900/10 dark:hover:bg-green-900/20">
						<MongoIcon alt="MongoDB" class="w-4 h-4 mr-2"/> MongoDB
					  </SocialPill>
					  <SocialPill class="bg-red-100/10 text-red-400 hover:bg-red-100/20 dark:bg-red-900/10 dark:hover:bg-red-900/20">
						<MariaIcon alt="MariaDB" class="w-4 h-4 mr-2"/> MariaDB
					  </SocialPill>
					  <SocialPill class="bg-purple-100/10 text-purple-400 hover:bg-purple-100/20 dark:bg-purple-900/10 dark:hover:bg-purple-900/20">
						<Mail /> APIs REST
					  </SocialPill>
					</ul>
				  </article>
			</div>

			<div class="mt-10">
			</div>
		</SectionContainer>

		<Stack />
		
		<SectionContainer>
			<Footer />

		</SectionContainer>
	</main>
</Layout>
