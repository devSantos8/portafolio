---
import Layout from "../layouts/Layout.astro";
import { getFeaturedProjects } from "../data/projects";

const projects = getFeaturedProjects();
const heroProject = projects[0];
---

<Layout title="Joain Monroy - Proyectos y Portfolio">
	<main class="min-h-screen bg-white dark:bg-black text-gray-900 dark:text-white transition-colors duration-500">
		<section class="js-hero relative min-h-screen flex flex-col justify-center overflow-hidden px-4 md:px-8 lg:px-16 cinematic-noise">
			<div class="absolute inset-0 pointer-events-none -z-10">
				<div class="js-hero-orb absolute top-1/2 left-1/2 h-[30rem] w-[30rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-red-500/15 blur-[140px] opacity-40 dark:opacity-20"></div>
			</div>

			<div class="mx-auto w-full max-w-6xl">
				<p class="js-hero-kicker mb-5 text-[11px] font-semibold uppercase tracking-[0.34em] text-gray-500 dark:text-gray-400">
					Portfolio / 2026
				</p>
				<h1 class="js-hero-title js-split-words max-w-5xl text-balance text-[clamp(2.8rem,9vw,8.2rem)] font-semibold uppercase leading-[0.9] tracking-[-0.05em]">
					Diseño y desarrollo experiencias web que se sienten vivas
				</h1>
				<p class="js-hero-subtitle mt-8 max-w-2xl text-base leading-relaxed text-gray-600 dark:text-gray-300 md:text-xl">
					Construyo productos digitales con arquitectura sólida, motion cuidado y dirección visual intencional.
				</p>
				<div class="mt-10 flex flex-wrap gap-4">
					<a
						href="#featured"
						class="js-depth-hover js-hero-cta inline-flex items-center gap-2 rounded-full bg-gray-900 px-7 py-3 text-sm font-semibold uppercase tracking-[0.12em] text-white transition-all duration-300 hover:shadow-xl dark:bg-white dark:text-black"
					>
						Ver trabajos
						<span aria-hidden="true">→</span>
					</a>
					{heroProject && (
						<a
							href={`/projects/${heroProject.id}`}
							class="js-depth-hover inline-flex items-center gap-2 rounded-full border border-gray-300 px-7 py-3 text-sm font-semibold uppercase tracking-[0.12em] text-gray-700 transition-all duration-300 hover:border-gray-900 hover:text-gray-900 dark:border-gray-700 dark:text-gray-200 dark:hover:border-white dark:hover:text-white"
						>
							Proyecto destacado
							<span aria-hidden="true">↗</span>
						</a>
					)}
				</div>
			</div>

			<div class="js-scroll-indicator pointer-events-none absolute bottom-7 left-1/2 -translate-x-1/2 text-gray-500 dark:text-gray-400">
				<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3v18M12 21l6-6M12 21l-6-6" />
				</svg>
			</div>
		</section>

		<section class="js-manifesto relative px-4 pb-24 pt-8 md:px-8 md:pb-32 lg:px-16">
			<div class="mx-auto max-w-6xl border-t border-gray-200 pt-10 dark:border-gray-800">
				<p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.28em] text-gray-500 dark:text-gray-400">
					Dirección creativa
				</p>
				<h2 class="js-manifesto-title js-split-words max-w-5xl text-balance text-[clamp(2rem,6.5vw,5rem)] font-medium leading-[0.95] tracking-[-0.04em] text-gray-900 dark:text-gray-100">
					Sistemas visuales claros, interacciones fluidas y performance real en cada detalle.
				</h2>
			</div>
		</section>

		<section id="featured" class="js-horizontal-pin relative overflow-hidden px-4 pb-20 md:px-8 lg:h-screen lg:px-0 lg:pb-0">
			<div class="js-project-rail lg:absolute lg:inset-0 lg:flex lg:items-center">
				<div class="js-project-rail-track flex flex-col gap-8 lg:flex-row lg:gap-10 lg:px-[8vw]">
					{projects.map((project, idx) => (
						<article class="js-rail-panel js-depth-hover group relative min-h-[70vh] overflow-hidden rounded-3xl border border-gray-200 bg-gray-100 dark:border-gray-800 dark:bg-gray-900 lg:w-[72vw] xl:w-[62vw]">
							<img
								src={project.image}
								alt={project.title}
								class="absolute inset-0 h-full w-full object-cover"
								loading="lazy"
							/>
							<div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/40 to-black/80"></div>
							<div class="relative z-10 flex h-full flex-col justify-between p-7 md:p-10">
								<div class="flex items-center justify-between gap-4">
									<span class="rounded-full border border-white/35 bg-white/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-white backdrop-blur-sm">
										0{idx + 1}
									</span>
									<div class="flex flex-wrap gap-2">
										{project.tags.slice(0, 3).map((tag) => (
											<span class="rounded-full border border-white/25 bg-black/20 px-3 py-1 text-[11px] font-medium uppercase tracking-[0.12em] text-white/90 backdrop-blur-sm">
												{tag}
											</span>
										))}
									</div>
								</div>
								<div class="max-w-2xl">
									<h3 class="text-balance text-[clamp(1.8rem,4.5vw,3.9rem)] font-semibold leading-[0.92] tracking-[-0.04em] text-white">
										{project.title}
									</h3>
									<p class="mt-4 max-w-xl text-sm leading-relaxed text-gray-100/90 md:text-base">
										{project.description}
									</p>
									<a
										href={`/projects/${project.id}`}
										class="mt-8 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.12em] text-white"
									>
										Ver caso
										<span aria-hidden="true">→</span>
									</a>
								</div>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="relative px-4 py-24 md:px-8 lg:px-16">
			<div class="mx-auto max-w-7xl">
				<div class="mb-12 flex flex-wrap items-end justify-between gap-6">
					<div>
						<p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.3em] text-gray-500 dark:text-gray-400">Archivo</p>
						<h2 class="text-4xl font-semibold tracking-[-0.03em] md:text-6xl">Más proyectos</h2>
					</div>
				</div>

				<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
					{projects.map((project) => (
						<a
							href={`/projects/${project.id}`}
							class="js-project-card js-depth-hover group relative overflow-hidden rounded-2xl border border-gray-200 bg-gray-100 dark:border-gray-800 dark:bg-gray-900"
						>
							<img
								src={project.image}
								alt={project.title}
								class="h-80 w-full object-cover transition-transform duration-700 group-hover:scale-105"
								loading="lazy"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/35 to-transparent"></div>
							<div class="absolute bottom-0 left-0 right-0 p-6">
								<h3 class="text-2xl font-semibold tracking-[-0.02em] text-white">{project.title}</h3>
								<p class="mt-2 line-clamp-2 text-sm text-white/85">{project.description}</p>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="js-cta-section relative py-32 px-4 md:px-8 lg:px-16 bg-gray-50 dark:bg-gray-950">
			<div class="max-w-4xl mx-auto text-center">
				<h2 class="text-4xl md:text-5xl font-bold mb-6">¿Te interesa colaborar?</h2>
				<p class="text-gray-600 dark:text-gray-400 text-lg mb-8">
					Tengo experiencia en desarrollo full-stack, arquitectura de sistemas y diseño de experiencias digitales modernas.
				</p>
				<a
					href="/contact"
					class="js-depth-hover inline-block px-8 py-4 bg-gray-900 dark:bg-white text-white dark:text-black rounded-full font-semibold hover:shadow-lg transition-all duration-300 hover:scale-105"
				>
					Contáctame
				</a>
			</div>
		</section>
	</main>
</Layout>
