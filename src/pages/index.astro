---
import Layout from '../layouts/Layout.astro';
import ColorBends from '../components/react/ColorBends.jsx';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Joain Monroy - Full-Stack Developer" showHeader={true}>
	<main id="main-container" class="relative bg-white text-gray-900 dark:bg-black dark:text-white w-full overflow-hidden transition-colors duration-500">
		
		<!-- Color Bends fijo en el fondo (Solo en Dark Mode) -->
		<div class="hidden dark:block">
			<ColorBends client:load colors={['#1a1a1a', '#333333', '#000000']} intensity={0.8} />
		</div>

		<div class="relative z-10 w-full flex flex-col">
			
			<Hero />
			<About />
			<Projects />
			<Footer />

		</div>
	</main>
</Layout>

<style>
	/* Optimizaciones para scroll suave y animaciones */
	html {
		scroll-behavior: smooth;
	}
	body {
		background-color: #000;
	}
	.project-card {
		will-change: transform;
	}
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import SplitType from 'split-type';
    import Lenis from 'lenis';

    gsap.registerPlugin(ScrollTrigger);

    // 1. Lenis Smooth Scroll
    const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        gestureOrientation: 'vertical',
        smoothWheel: true,
        wheelMultiplier: 1,
        touchMultiplier: 2,
    });

    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
    });
    gsap.ticker.lagSmoothing(0);

    // 2. Hero Animations
    const heroTl = gsap.timeline();
    heroTl.from(".hero-element", {
        y: 80,
        opacity: 0,
        duration: 1.2,
        stagger: 0.15,
        ease: "power4.out",
        delay: 0.2
    });

    // 3. About Text Reveal (Awwwards Style)
    // Dividimos el texto en palabras y caracteres
    const aboutText = new SplitType('.about-text', { types: 'words,chars' });
    
    // Animamos la opacidad de cada caracter mientras se hace scroll
    gsap.fromTo(aboutText.chars, 
        { opacity: 0.1 },
        {
            opacity: 1,
            stagger: 0.1,
            scrollTrigger: {
                trigger: "#about",
                start: "top 60%",
                end: "bottom 70%",
                scrub: 1,
            }
        }
    );

    // 4. Project Cards Animations & Color Bends Sync
    const cards = document.querySelectorAll('.project-card');
    
    cards.forEach((card, index) => {
        // Revelación de la tarjeta al hacer scroll
        gsap.fromTo(card,
            { y: 100, opacity: 0 },
            {
                y: 0,
                opacity: 1,
                duration: 1,
                ease: "power3.out",
                scrollTrigger: {
                    trigger: card,
                    start: "top 85%",
                }
            }
        );
        
        // Sincronización con el Color Bends de fondo
        const imgContainer = card.querySelector('.project-image-container') as HTMLElement;
        if (imgContainer) {
            ScrollTrigger.create({
                trigger: card,
                start: "top 60%",
                end: "bottom 40%",
                onEnter: () => updateColorBends(imgContainer),
                onEnterBack: () => updateColorBends(imgContainer),
            });
        }
    });

    function updateColorBends(element: HTMLElement) {
        const bgColor = element.style.backgroundColor;
        if (bgColor && bgColor !== 'rgb(17, 17, 17)' && bgColor !== '#111') {
            window.dispatchEvent(new CustomEvent('projectColorChange', { detail: { color: bgColor } }));
        }
    }

    // Limpieza de recursos al desmontar si es necesario (Astro Transitions)
    document.addEventListener('astro:before-swap', () => {
        ScrollTrigger.getAll().forEach(t => t.kill());
        lenis.destroy();
        aboutText.revert();
    });
</script>
