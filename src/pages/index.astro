		<!-- Projects Section -->
		<section id="Proyectos" class="px-8 md:px-16 lg:px-24 xl:px-32 py-32 md:py-40">
			<div class="max-w-7xl mx-auto">
				<!-- Header -->
				<div class="fade-in-section flex flex-col md:flex-row md:items-end gap-6 mb-20">
					<p class="text-[11px] font-semibold uppercase tracking-[0.3em] text-blue-600 dark:text-blue-400 md:pb-1">01</p>
					<h2 class="text-4xl md:text-5xl font-medium text-gray-900 dark:text-white tracking-tight">Proyectos</h2>
					<span class="hidden md:block flex-1 h-[1px] bg-gray-200 dark:bg-gray-800 mb-3"></span>
				</div>

				<!-- Projects Grid -->
				<div class="space-y-24 md:space-y-32">
					<!-- Proyecto 1 -->
					<article class="slide-in-left group">
						<div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
							<div class="overflow-hidden rounded-2xl scale-in">
								<img src="../projects/workco.webp" alt="CommitFlow" class="w-full h-[240px] md:h-[300px] object-cover transition-transform duration-700 group-hover:scale-[1.03]" />
							</div>
							<div class="space-y-5">
								<p class="text-[11px] font-semibold uppercase tracking-[0.3em] text-blue-600 dark:text-blue-400">Proyecto de Título</p>
								<h3 class="text-2xl md:text-3xl font-medium text-gray-900 dark:text-white tracking-tight">CommitFlow</h3>
								<p class="text-base text-gray-500 dark:text-gray-500 leading-relaxed">Plataforma que conecta profesionales y empresas TI. Sistema de perfiles, búsqueda avanzada y gestión de ofertas laborales.</p>
								<div class="flex flex-wrap gap-3 pt-2">
									<span class="text-xs text-gray-500 dark:text-gray-500 px-4 py-2 border border-gray-200 dark:border-gray-800 rounded-full">Django</span>
									<span class="text-xs text-gray-500 dark:text-gray-500 px-4 py-2 border border-gray-200 dark:border-gray-800 rounded-full">Python</span>
									<span class="text-xs text-gray-500 dark:text-gray-500 px-4 py-2 border border-gray-200 dark:border-gray-800 rounded-full">PostgreSQL</span>
								</div>
							</div>
						</div>
					</article>

					<!-- Proyecto 2 -->
					<article class="slide-in-right group">
						<div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
							<div class="overflow-hidden rounded-2xl lg:order-2 scale-in">
								<img src="../projects/dashboard.webp" alt="Dashboard E-commerce" class="w-full h-[240px] md:h-[300px] object-cover transition-transform duration-700 group-hover:scale-[1.03]" />
							</div>
							<div class="space-y-5 lg:order-1">
								<h3 class="text-2xl md:text-3xl font-medium text-gray-900 dark:text-white tracking-tight">Dashboard E-commerce</h3>
								<p class="text-base text-gray-500 dark:text-gray-500 leading-relaxed">Panel de control para análisis de usuarios registrados y gestión de usuarios con visualización de datos en tiempo real.</p>
								<div class="flex flex-wrap gap-3 pt-2">
									<span class="text-xs text-gray-500 dark:text-gray-500 px-4 py-2 border border-gray-200 dark:border-gray-800 rounded-full">Django</span>
									<span class="text-xs text-gray-500 dark:text-gray-500 px-4 py-2 border border-gray-200 dark:border-gray-800 rounded-full">Python</span>
									<span class="text-xs text-gray-500 dark:text-gray-500 px-4 py-2 border border-gray-200 dark:border-gray-800 rounded-full">JavaScript</span>
								</div>
							</div>
						</div>
					</article>

					<!-- Proyecto 3 -->
					<article class="slide-in-left group">
						<div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
							<div class="overflow-hidden rounded-2xl scale-in">
								<img src="../projects/lubricentro.webp" alt="Lubricentro La Esquina" class="w-full h-[240px] md:h-[300px] object-cover transition-transform duration-700 group-hover:scale-[1.03]" />
							</div>
							<div class="space-y-5">
								<h3 class="text-2xl md:text-3xl font-medium text-gray-900 dark:text-white tracking-tight">Lubricentro La Esquina</h3>
								<p class="text-base text-gray-500 dark:text-gray-500 leading-relaxed">Sitio web informativo para un negocio de lubricantes y repuestos automotrices en San Joaquín, Santiago.</p>
								<div class="flex flex-wrap gap-3 pt-2">
									<span class="text-xs text-gray-500 dark:text-gray-500 px-4 py-2 border border-gray-200 dark:border-gray-800 rounded-full">Astro</span>
									<span class="text-xs text-gray-500 dark:text-gray-500 px-4 py-2 border border-gray-200 dark:border-gray-800 rounded-full">Tailwind</span>
