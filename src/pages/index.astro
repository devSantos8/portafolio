---
// Layout
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";

// UI Components
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";

// Icons
import HTML from "../components/icons/HTML.astro";
import JavaScript from "../components/icons/JavaScript.astro";
import ReactIcon from "../components/icons/React.astro";
import Tailwind from "../components/icons/Tailwind.astro";
import AstroIcon from "../components/icons/Astro.astro";
import BootstrapIcon from "../components/icons/Bootstrap.astro";
import PythonIcon from "../components/icons/Python.astro";
import DjangoIcon from "../components/icons/Django.astro";
import APIIcon from "../components/icons/API.astro";
import PostgresIcon from "../components/icons/Postgres.astro";
import MongoIcon from "../components/icons/Mongo.astro";
import MariaIcon from "../components/icons/Maria.astro";

// Fonts
import "@fontsource/instrument-serif/400-italic.css";

const certificates = [
	{
		title: "Desarrollo Full Stack",
		issuer: "INACAP",
		year: "2025",
		description:
			"Desarrollo de aplicaciones web completas con frontend, backend y buenas prácticas de despliegue.",
		url: "",
		featured: true,
	},
	{
		title: "Git Fundamentals",
		issuer: "DataCamp",
		year: "2025",
		description:
			"Fundamentos de Git y GitHub para control de versiones, trabajo colaborativo y flujos de desarrollo modernos.",
		url: "",
		featured: true,
	},
	{
		title: "AWS Academy Graduate - AWS Academy Cloud Foundations",
		issuer: "AWS Academy",
		year: "2024",
		description:
			"Curso de fundamentos cloud en AWS: conceptos de nube, servicios principales, seguridad y buenas prácticas iniciales.",
		url: "",
		featured: true,
	},
	{
		title: "Soporte Computacional",
		issuer: "INACAP",
		year: "2023",
		description:
			"Diagnóstico, mantenimiento y resolución de incidencias en entornos de hardware y software.",
		url: "",
		featured: false,
	},
];

const featuredCertificates = certificates.filter(
	(certificate) => certificate.featured,
);
const linkedInCertificationsUrl =
	"https://www.linkedin.com/in/jmonroys17/details/certifications/";
const googleAccentClasses = [
	"bg-[#4285F4]",
	"bg-[#EA4335]",
	"bg-[#FBBC05]",
	"bg-[#34A853]",
];
---

<Layout title="Joain Monroy - Ingeniero en Informatica">
	<main class="relative isolate bg-[#FAFAFA] dark:bg-[#000000] text-gray-900 dark:text-gray-100 transition-colors duration-500 overflow-x-clip min-h-screen">
		<div class="fixed inset-0 pointer-events-none -z-10">
			<!-- Vercel-inspired subtle background -->
			<div class="absolute inset-0 bg-[radial-gradient(circle_500px_at_50%_200px,#E5E7EB,transparent)] dark:bg-[radial-gradient(circle_500px_at_50%_200px,#1F2937,transparent)] opacity-50"></div>
			<div class="absolute inset-0 bg-[radial-gradient(rgba(15,23,42,0.16)_0.45px,transparent_0.45px)] dark:bg-[radial-gradient(rgba(255,255,255,0.2)_0.45px,transparent_0.45px)] [background-size:3px_3px] opacity-[0.07] dark:opacity-[0.08]"></div>
		</div>
		<!-- Astro Hero Section -->
		<Hero />

		<!-- Experiencia Section - Premium Edition -->
		<SectionContainer
			id="Experiencia"
			class="py-32 md:py-44 relative overflow-hidden"
			bg="bg-transparent"
		>
			<style is:inline>
				@keyframes trajectorySlideUp {
					from { opacity: 0; transform: translateY(40px) scale(0.95); }
					to { opacity: 1; transform: translateY(0) scale(1); }
				}
				@keyframes glowPulse {
					0%, 100% { opacity: 0.5; transform: scale(1); }
					50% { opacity: 0.8; transform: scale(1.1); }
				}
				.trajectory-item {
					opacity: 0;
					animation: trajectorySlideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
				}
				.trajectory-item:nth-child(1) { animation-delay: 0.1s; }
				.trajectory-item:nth-child(2) { animation-delay: 0.2s; }
				.trajectory-item:nth-child(3) { animation-delay: 0.3s; }
			</style>

			<div class="fade-in-section relative z-10 w-full max-w-5xl mx-auto px-4 md:px-8">
				
				<div class="flex flex-col md:flex-row md:items-end gap-6 mb-24 relative">
					<div class="absolute -top-32 -left-32 w-96 h-96 bg-gray-900/[0.02] dark:bg-white/[0.02] rounded-full blur-[100px] pointer-events-none"></div>
					<div class="flex-1">
						<p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-gray-500 dark:text-white/50 md:pb-2 mb-2 font-mono">
							[ Registro de Evolución ]
						</p>
						<h2 class="text-5xl md:text-7xl font-semibold text-gray-900 dark:text-white tracking-tighter leading-none">
							Experiencia
						</h2>
					</div>
					<span class="hidden md:block flex-1 h-[1px] bg-gradient-to-r from-transparent via-gray-200 dark:via-white/10 to-transparent mb-3"></span>
				</div>

				<div class="space-y-6">
					
					<!-- ITEM 1 -->
					<article class="trajectory-item rounded-[2rem] p-8 md:p-10 relative overflow-hidden group bg-white/70 dark:bg-[#0a0a0a]/90 border border-gray-100 dark:border-white/5 shadow-xl shadow-gray-200/50 dark:shadow-[0_20px_40px_-10px_rgba(0,0,0,0.5)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-gray-300 dark:hover:border-white/10 hover:shadow-2xl dark:hover:shadow-[0_30px_60px_-15px_rgba(0,0,0,0.6)]">
						<div class="absolute right-0 top-0 w-64 h-64 bg-gray-900/[0.02] dark:bg-white/[0.02] rounded-full blur-[80px] group-hover:bg-gray-900/[0.04] dark:group-hover:bg-white/[0.04] transition-colors duration-700"></div>
						
						<div class="grid grid-cols-1 md:grid-cols-[200px_1fr] gap-8 md:gap-12 relative z-10">
							<div class="flex flex-col gap-2 border-l-2 border-gray-200 dark:border-white/10 pl-6 h-fit group-hover:border-gray-300 dark:group-hover:border-white/20 transition-colors">
								<span class="text-sm font-mono text-gray-500 dark:text-white/40 tracking-wider">Mar 2025 — Presente</span>
								<span class="text-xs font-bold px-3 py-1 rounded-full bg-gray-900 text-white dark:bg-white/10 dark:text-white w-fit mt-1">ACTUAL</span>
							</div>
							
							<div>
								<div class="flex flex-col gap-1.5 mb-6">
									<h3 class="text-2xl md:text-3xl font-medium text-gray-900 dark:text-white tracking-tight">Práctica Profesional</h3>
									<p class="text-base text-gray-500 dark:text-white/50">Empresa / Institución</p>
								</div>
								
								<p class="text-base leading-relaxed text-gray-600 dark:text-white/70 mb-8 max-w-2xl font-light">
									Implementación de soluciones backend escalables, arquitectura de sistemas y optimización de rendimiento con foco en DevOps y buenas prácticas de despliegue continuo.
								</p>
								
								<div class="flex flex-wrap gap-2">
									<span class="px-4 py-2 rounded-full text-xs font-mono text-gray-600 dark:text-white/60 bg-gray-100 dark:bg-white/[0.03] border border-gray-200 dark:border-white/5 group-hover:bg-gray-200 dark:group-hover:bg-white/[0.06] transition-colors">Backend</span>
