---
// Layout
import Layout from '../layouts/Layout.astro';
import SectionContainer from '../components/SectionContainer.astro';

// UI Components
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';

// Fonts
import '@fontsource/barlow/300.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/instrument-serif/400-italic.css';
---

<Layout title="Joain Monroy - Ingeniero en Informatica">
	<main>
		<!-- Astro Hero Section -->
		<Hero />

		<!-- ======================= -->
		<!-- EJEMPLO 1: Timeline vertical elegante -->
		<!-- ======================= -->
		<SectionContainer class="py-32 md:py-40" bg="bg-slate-50/50 dark:bg-[#0F1115]">
			<div class="fade-in-section">
				<div class="flex flex-col md:flex-row md:items-end gap-6 mb-20">
					<p class="text-[11px] font-semibold uppercase tracking-[0.3em] text-[#DC2626] md:pb-1">
						Trayectoria
					</p>
					<h2 class="text-4xl md:text-5xl font-medium text-gray-900 dark:text-white tracking-tight">
						Experiencia
					</h2>
					<span class="hidden md:block flex-1 h-[1px] bg-gray-200 dark:bg-gray-800 mb-3"></span>
				</div>
				
				<div class="relative">
					<!-- Línea vertical principal -->
					<div class="absolute left-6 md:left-8 top-0 bottom-0 w-[1px] bg-gradient-to-b from-blue-500 via-gray-200 to-transparent dark:via-gray-800"></div>
					
					<div class="space-y-16 md:space-y-20">
						<!-- Item 1: Práctica actual -->
						<div class="relative pl-16 md:pl-24 group">
							<!-- Círculo con animación -->
							<div class="absolute left-6 md:left-8 top-0 -translate-x-1/2">
								<div class="w-4 h-4 rounded-full border-2 border-blue-500 bg-white dark:bg-gray-900 group-hover:scale-125 transition-transform duration-300"></div>
								<div class="absolute inset-0 w-4 h-4 rounded-full bg-blue-500/20 animate-ping"></div>
							</div>
							
							<!-- Contenido -->
							<div class="pb-2">
								<div class="flex flex-wrap items-center gap-3 mb-4">
									<span class="text-xs font-medium px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-900/20 text-[#DC2626]">
										Actual
									</span>
									<span class="text-sm text-gray-500 dark:text-gray-500">Mar 2025 — Presente</span>
								</div>
								<h3 class="text-2xl md:text-3xl font-medium text-gray-900 dark:text-white mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-300">
									Práctica Profesional
								</h3>
								<p class="text-lg text-gray-600 dark:text-gray-400 mb-4">
									Empresa
								</p>
								<p class="text-base text-gray-500 dark:text-gray-500 leading-relaxed max-w-2xl">
									Descripción de las tareas y responsabilidades en la práctica.
								</p>
							</div>
						</div>

						<!-- Item 2: Trabajo anterior -->
						<div class="relative pl-16 md:pl-24 group">
							<div class="absolute left-6 md:left-8 top-0 -translate-x-1/2">
								<div class="w-4 h-4 rounded-full border-2 border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 group-hover:border-blue-500 group-hover:scale-125 transition-all duration-300"></div>
							</div>
							
							<div class="pb-2">
								<div class="flex flex-wrap items-center gap-3 mb-4">
									<span class="text-xs font-medium px-3 py-1 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400">
										Experiencia
									</span>
									<span class="text-sm text-gray-500 dark:text-gray-500">Ene — Feb 2025</span>
								</div>
								<h3 class="text-2xl md:text-3xl font-medium text-gray-900 dark:text-white mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-300">
									Cargo
								</h3>
								<p class="text-lg text-gray-600 dark:text-gray-400 mb-4">
									Empresa
								</p>
								<p class="text-base text-gray-500 dark:text-gray-500 leading-relaxed max-w-2xl">
									Descripción de las tareas y responsabilidades en este puesto.
								</p>
							</div>
						</div>

						<!-- Item 3: Estudios -->
						<div class="relative pl-16 md:pl-24 group">
							<div class="absolute left-6 md:left-8 top-0 -translate-x-1/2">
								<div class="w-4 h-4 rounded-full border-2 border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 group-hover:border-blue-500 group-hover:scale-125 transition-all duration-300"></div>
							</div>
							
							<div class="pb-2">
								<div class="flex flex-wrap items-center gap-3 mb-4">
									<span class="text-xs font-medium px-3 py-1 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400">
										Educación
									</span>
									<span class="text-sm text-gray-500 dark:text-gray-500">2022 — 2025</span>
								</div>
								<h3 class="text-2xl md:text-3xl font-medium text-gray-900 dark:text-white mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-300">
									Ingeniería en Informática
								</h3>
								<p class="text-lg text-gray-600 dark:text-gray-400 mb-4">
									INACAP Santiago Centro
								</p>
								<p class="text-base text-gray-500 dark:text-gray-500 leading-relaxed max-w-2xl">
									Formación integral en desarrollo de software, bases de datos, redes, metodologías ágiles y DevOps. Orientado al desarrollo web y automatización de procesos.
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</SectionContainer>

