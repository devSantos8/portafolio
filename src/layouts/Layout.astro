---
import { ViewTransitions } from 'astro:transitions';
// @ts-ignore
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	showHeader?: boolean;
}

const { title, showHeader = true } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Portfolio of Joain Monroy - Ingeniero en Informática y DevOps" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ViewTransitions />
	</head>
	<body class="bg-[#FAFAFA] dark:bg-[#0A0A0A] selection:bg-red-500/20 selection:text-red-900 dark:selection:text-red-100 font-['Inter_Variable',sans-serif] antialiased text-gray-900 dark:text-gray-100 transition-colors duration-500">
		<div class="js-page-preloader fixed inset-0 z-[10050] flex items-center justify-center bg-[#F6F6F3] dark:bg-[#070707]">
			<p class="js-page-preloader-label text-sm font-semibold uppercase tracking-[0.35em] text-gray-700 dark:text-gray-300">
				Loading Portfolio
			</p>
		</div>
		{showHeader && <Header />}
		<slot />

		<!-- Custom Cursor -->
		<div id="glow-cursor" class="pointer-events-none fixed left-0 top-0 z-[9999] hidden h-8 w-8 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-gray-400/50 bg-white/10 opacity-0 mix-blend-difference backdrop-blur-[2px] transition-opacity duration-300 md:flex dark:border-white/30 dark:bg-white/5"></div>
		<div id="glow-cursor-dot" class="pointer-events-none fixed left-0 top-0 z-[10000] hidden h-1.5 w-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-gray-900 opacity-0 mix-blend-difference transition-opacity duration-300 md:block dark:bg-white"></div>
	</body>
</html>

<script>
	// Función para cargar y ejecutar las animaciones
	const setupAnimations = async () => {
		try {
			const module = await import('../scripts/animations.js');
			if (module.initAnimations) {
				module.initAnimations();
			}
		} catch (error) {
			console.error('Error loading animations:', error);
		}
	};

	// Custom Cursor Logic
	const initCursor = () => {
		const cursor = document.getElementById('glow-cursor');
		const dot = document.getElementById('glow-cursor-dot');
		
		if (!cursor || !dot || window.matchMedia('(max-width: 768px)').matches) return;

		let mouseX = window.innerWidth / 2;
		let mouseY = window.innerHeight / 2;
		let cursorX = mouseX;
		let cursorY = mouseY;
		
		// Animación suave del borde exterior (lerp)
		const loop = () => {
			cursorX += (mouseX - cursorX) * 0.15;
			cursorY += (mouseY - cursorY) * 0.15;
			
			cursor.style.transform = `translate3d(${cursorX}px, ${cursorY}px, 0) translate(-50%, -50%)`;
			dot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0) translate(-50%, -50%)`;
			
			requestAnimationFrame(loop);
		};
		requestAnimationFrame(loop);

		window.addEventListener('mousemove', (e) => {
			mouseX = e.clientX;
			mouseY = e.clientY;
			
			if (cursor.style.opacity === '0') {
				cursor.style.opacity = '1';
				dot.style.opacity = '1';
			}
		});

		window.addEventListener('mouseout', () => {
			cursor.style.opacity = '0';
			dot.style.opacity = '0';
		});

		// Efecto Hover en elementos clickeables
		const interactables = document.querySelectorAll('a, button, input, textarea, select, .skill-card, .about-panel, .project-card');
		interactables.forEach(el => {
			el.addEventListener('mouseenter', () => {
				cursor.style.transform = `translate3d(${cursorX}px, ${cursorY}px, 0) translate(-50%, -50%) scale(1.8)`;
				cursor.style.backgroundColor = 'rgba(255, 255, 255, 0.15)';
			});
			el.addEventListener('mouseleave', () => {
				cursor.style.transform = `translate3d(${cursorX}px, ${cursorY}px, 0) translate(-50%, -50%) scale(1)`;
				cursor.style.backgroundColor = 'var(--tw-bg-opacity)'; // restaura la clase de tailwind
			});
		});
	};

	// Ejecutar en la carga inicial y en cada navegación de astro:transitions
	document.addEventListener('astro:page-load', () => {
		setupAnimations();
		initCursor();
	});
</script>

<style is:global>
	:root {
		color-scheme: light dark;
		--color-primary: #1a1a1a;
		--color-secondary: #666666;
		--color-muted: #999999;
		--color-accent: #2563eb;
	}

	:root.dark {
		--bg-color: #0a0a0a;
		--text-color: #fafafa;
	}

	:root:not(.dark) {
		--bg-color: #fafafa;
		--text-color: #171717;
	}

	html {
		font-family: "Inter Variable", system-ui, -apple-system, sans-serif;
		scroll-behavior: smooth;
		overflow-x: clip;
		letter-spacing: -0.01em;
	}

	body {
		background: var(--bg-color);
		color: var(--text-color);
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		overflow-x: clip;
		line-height: 1.6;
	}

	/* Animaciones de scroll */
	.fade-in-section {
		opacity: 1;
		transform: none;
		transition: opacity 0.8s ease-out, transform 0.8s ease-out;
	}

	.fade-in-section.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	/* Animación de slide desde izquierda */
	.slide-in-left {
		opacity: 1;
		transform: none;
		transition: opacity 0.8s ease-out, transform 0.8s ease-out;
	}

	.slide-in-left.is-visible {
		opacity: 1;
		transform: translateX(0);
	}

	/* Animación de slide desde derecha */
	.slide-in-right {
		opacity: 1;
		transform: none;
		transition: opacity 0.8s ease-out, transform 0.8s ease-out;
	}

	.slide-in-right.is-visible {
		opacity: 1;
		transform: translateX(0);
	}

	/* Animación de scale */
	.scale-in {
		opacity: 1;
		transform: none;
		transition: opacity 0.8s ease-out, transform 0.8s ease-out;
	}

	.scale-in.is-visible {
		opacity: 1;
		transform: scale(1);
	}

	/* Animación de entrada inicial - Deshabilitada para GSAP */
	/*
	@keyframes fadeUp {
		from { opacity: 0; transform: translateY(40px); }
		to { opacity: 1; transform: translateY(0); }
	}
	*/

	@keyframes fadeIn {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	@keyframes slideInLeft {
		from {
			opacity: 0;
			transform: translateX(-40px);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}

	@keyframes float {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-10px); }
	}

	@keyframes pulse-soft {
		0%, 100% { opacity: 0.15; transform: scale(1); }
		50% { opacity: 0.25; transform: scale(1.02); }
	}

	/* CSS classes ahora manejadas por GSAP al cargar: 
	.animate-fade-up, .animate-fade-up-delay-X etc... */

	.animate-float {
		animation: float 6s ease-in-out infinite;
	}

	.animate-pulse-soft {
		animation: pulse-soft 4s ease-in-out infinite;
	}

	/* Stagger children animation */
	.stagger-children > * {
		opacity: 1;
		transform: none;
		transition: opacity 0.5s ease-out, transform 0.5s ease-out;
	}

	.stagger-children.is-visible > *:nth-child(1) { transition-delay: 0.1s; opacity: 1; transform: translateY(0); }
	.stagger-children.is-visible > *:nth-child(2) { transition-delay: 0.2s; opacity: 1; transform: translateY(0); }
	.stagger-children.is-visible > *:nth-child(3) { transition-delay: 0.3s; opacity: 1; transform: translateY(0); }
	.stagger-children.is-visible > *:nth-child(4) { transition-delay: 0.4s; opacity: 1; transform: translateY(0); }
	.stagger-children.is-visible > *:nth-child(5) { transition-delay: 0.5s; opacity: 1; transform: translateY(0); }
	.stagger-children.is-visible > *:nth-child(6) { transition-delay: 0.6s; opacity: 1; transform: translateY(0); }

	/* Skills container animation */
	.skills-container .skill-category {
		opacity: 1;
		transform: none;
		transition: opacity 0.6s ease-out, transform 0.6s ease-out;
	}

	.skills-container.is-visible .skill-category:nth-child(1) {
		transition-delay: 0.1s;
		opacity: 1;
		transform: translateY(0);
	}
	.skills-container.is-visible .skill-category:nth-child(2) {
		transition-delay: 0.25s;
		opacity: 1;
		transform: translateY(0);
	}
	.skills-container.is-visible .skill-category:nth-child(3) {
		transition-delay: 0.4s;
		opacity: 1;
		transform: translateY(0);
	}

	/* Horizontal Scrolling Gallery */
	.horizontal-scroll-gallery {
		display: flex;
		flex-direction: column;
		width: 100%;
		gap: 2rem;
	}

	.carousel-item {
		flex-shrink: 0;
		width: 100%;
	}

	/* Selection */
	::selection {
		background: rgba(37, 99, 235, 0.2);
	}

	/* Scrollbar minimalista */
	::-webkit-scrollbar {
		width: 8px;
	}

	::-webkit-scrollbar-track {
		background: transparent;
	}

	::-webkit-scrollbar-thumb {
		background: rgba(150, 150, 150, 0.3);
		border-radius: 4px;
	}

	::-webkit-scrollbar-thumb:hover {
		background: rgba(150, 150, 150, 0.5);
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
		.fade-in-section,
		.slide-in-left,
		.slide-in-right,
		.scale-in,
		.animate-fade-up,
		.animate-fade-up-delay-1,
		.animate-fade-up-delay-2,
		.animate-fade-up-delay-3,
		.animate-float,
		.stagger-children > * {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}

	/* Responsive: Mobile horizontal gallery becomes vertical */
	@media (max-width: 768px) {
		.horizontal-scroll-gallery {
			flex-direction: column;
			gap: 2rem;
		}

		.carousel-item {
			width: 100%;
		}
	}
</style>
