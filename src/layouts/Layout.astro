---
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import '@fontsource-variable/onest';
import '@fontsource-variable/inter';
import '@fontsource/instrument-serif';
import '@fontsource/barlow';
import '../styles/global.css';

interface Props {
	title: string;
	showHeader?: boolean;
}

const { title, showHeader = true } = Astro.props;
---

<!doctype html>
<html lang="es-CL">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Joain Monroy - Full-Stack Developer & DevOps Engineer basado en Santiago, Chile" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;600&display=swap" rel="stylesheet">
		
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'dark'; // Default to dark for this portfolio
			})();
		
			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
			window.localStorage.setItem('theme', theme);
		</script>
		
		<ViewTransitions />
	</head>
	<body>
		
		{showHeader && <Header transition:persist transition:name="header" />}
		
		<slot />
		
		<div class="cursor" id="cursor" transition:persist transition:name="cursor">
			<div class="cursor-dot"></div>
			<div class="cursor-ring">
				<span>Explore</span>
			</div>
		</div>
		
	</body>
</html>

<style is:global>
	:root {
		--font-sans: 'Onest Variable', 'Inter Variable', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
		--font-serif: 'Instrument Serif', Georgia, serif;
		--black: #000;
		--white: #fff;
		--gray: #666;
	}
	
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}
	
	html {
		font-family: var(--font-sans);
		font-size: 14px;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		text-rendering: optimizeLegibility;
		background-color: var(--black); /* Background for when page scales down */
	}
	
	body {
		background: var(--white);
		color: var(--black);
		overflow-x: hidden;
		min-height: 100vh;
	}
	
	html.dark body {
		background: var(--black);
		color: var(--white);
	}
	
	/* Prevent header and cursor from animating with the page */
	::view-transition-group(header),
	::view-transition-old(header),
	::view-transition-new(header),
	::view-transition-group(cursor),
	::view-transition-old(cursor),
	::view-transition-new(cursor) {
		animation: none !important;
	}

	/* Card Slide View Transition — Rápido y fluido */
	::view-transition-old(root) {
		animation: fadeOld 0.35s cubic-bezier(0.25, 0, 0.35, 1) forwards;
	}

	::view-transition-new(root) {
		animation: slideUp 0.35s cubic-bezier(0.25, 0, 0.35, 1) forwards;
		z-index: 9999;
	}

	@keyframes slideUp {
		from {
			transform: translateY(30px);
			opacity: 0;
		}
		to {
			transform: translateY(0);
			opacity: 1;
		}
	}

	@keyframes fadeOld {
		from {
			opacity: 1;
		}
		to {
			opacity: 0;
		}
	}
	
	.laura-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		padding: 35px 50px;
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		color: var(--white);
		mix-blend-mode: difference;
		pointer-events: none; /* Let clicks pass through except on links */
	}
	
	.laura-header a {
		color: var(--white);
		text-decoration: none;
		pointer-events: auto;
	}
	
	.logo-wrap {
		flex: 1;
	}
	
	.logo {
		font-family: var(--font-sans);
		font-size: 22px;
		font-weight: 500; /* Reducido de 700 a 500 para un look más limpio */
		letter-spacing: -0.05em;
		text-transform: uppercase;
	}
	
	.center-info {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		font-family: var(--font-sans);
		font-size: 13px;
		font-weight: 400; /* Reducido de 600 a 400 (Regular) */
		letter-spacing: -0.02em;
		line-height: 1.4;
		text-transform: uppercase;
		pointer-events: auto;
	}
	
	.contact-line a {
		transition: opacity 0.3s;
	}
	
	.contact-line a:hover {
		opacity: 0.6;
	}
	
	.nav-links {
		flex: 1;
		display: flex;
		justify-content: flex-end;
		gap: 32px;
		font-family: var(--font-sans);
		font-size: 14px;
		font-weight: 400; /* Reducido de 600 a 400 (Regular) */
		letter-spacing: -0.02em;
		text-transform: uppercase;
		pointer-events: auto;
	}
	
	.nav-links a {
		transition: opacity 0.3s;
	}
	
	.nav-links a:hover {
		opacity: 0.6;
	}
	
	.burger {
		display: none;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 8px;
		position: absolute;
		right: 48px;
	}
	
	.burger span {
		display: block;
		width: 20px;
		height: 1px;
		background: currentColor;
	}
	
	.burger span:nth-child(2) {
		width: 14px;
	}
	
	.burger span:nth-child(3) {
		width: 10px;
	}
	
	.mobile-menu {
		position: fixed;
		inset: 0;
		z-index: 99;
		background: var(--white);
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s;
	}
	
	.mobile-menu.active {
		opacity: 1;
		pointer-events: auto;
	}
	
	.mobile-menu nav {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 24px;
	}
	
	.mobile-menu a {
		font-family: var(--font-serif);
		font-size: 42px;
		font-weight: 400;
		text-decoration: none;
		color: var(--black);
		font-style: italic;
	}
	
	.cursor {
		position: fixed;
		top: 0;
		left: 0;
		pointer-events: none;
		z-index: 99999;
		color: var(--white);
	}
	
	.cursor-dot {
		position: absolute;
		width: 8px;
		height: 8px;
		background: var(--white);
		border-radius: 50%;
		transform: translate(-50%, -50%);
		box-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
	}
	
	.cursor-ring {
		position: absolute;
		width: 40px;
		height: 40px;
		border: 1px solid rgba(255, 255, 255, 0.4);
		background: rgba(255, 255, 255, 0.05);
		backdrop-filter: blur(2px);
		border-radius: 50%;
		transform: translate(-50%, -50%);
		opacity: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: opacity 0.3s, width 0.3s, height 0.3s, background 0.3s;
	}
	
	.cursor-ring span {
		font-size: 8px;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		opacity: 0;
		transition: opacity 0.3s;
	}
	
	.cursor.hover .cursor-dot {
		opacity: 0;
	}
	
	.cursor.hover .cursor-ring {
		opacity: 1;
		width: 70px;
		height: 70px;
		background: rgba(255, 255, 255, 0.1);
		border-color: rgba(255, 255, 255, 0.8);
	}
	
	.cursor.hover .cursor-ring span {
		opacity: 1;
	}

	/* Estilos del Cursor para Modo Claro (Garantiza visibilidad en fondo blanco) */
	html:not(.dark) .cursor-dot {
		background: #000000;
		box-shadow: 0 0 10px rgba(0, 0, 0, 0.15);
	}
	html:not(.dark) .cursor-ring {
		border-color: rgba(0, 0, 0, 0.3);
		background: rgba(0, 0, 0, 0.03);
	}
	html:not(.dark) .cursor-ring span {
		color: #000000;
	}
	html:not(.dark) .cursor.hover .cursor-ring {
		background: rgba(0, 0, 0, 0.05);
		border-color: rgba(0, 0, 0, 0.7);
	}
	
	@media (max-width: 768px) {
		.cursor {
			display: none;
		}
		
		.site-header {
			padding: 24px;
		}
		
		.header-inner {
			grid-template-columns: 1fr auto;
		}
		
		.header-left,
		.header-right {
			display: none;
		}
		
		.header-center {
			text-align: left;
		}
		
		.burger {
			display: flex;
			right: 24px;
		}
	}
	
	::-webkit-scrollbar {
		display: none;
	}
	
	html {
		-ms-overflow-style: none;  /* IE and Edge */
		scrollbar-width: none;  /* Firefox */
	}
	
	::selection {
		background: var(--black);
		color: var(--white);
	}
	
	@media (prefers-reduced-motion: reduce) {
		* {
			animation: none !important;
			transition: none !important;
		}
	}
</style>

<script>
	if (typeof window !== 'undefined' && 'scrollRestoration' in history) {
		history.scrollRestoration = 'manual';
	}

	document.addEventListener('astro:after-swap', () => {
		window.scrollTo(0, 0);
		document.documentElement.scrollTop = 0;
		document.body.scrollTop = 0;
	});

	document.addEventListener('astro:page-load', () => {
		window.scrollTo(0, 0);
		document.documentElement.scrollTop = 0;
		document.body.scrollTop = 0;
		initCursor();
		initMobileMenu();
		preventSamePageNavigation();
	});
	
	function preventSamePageNavigation() {
		document.querySelectorAll('a').forEach(link => {
			link.addEventListener('click', (e) => {
				const href = link.getAttribute('href');
				if (!href) return;
				
				// Bypass for same-page hash links
				if (href.startsWith('#') || href.includes('#')) return;
				
				// Get pathname without trailing slash for robust comparison
				const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
				const linkPath = new URL(link.href, window.location.origin).pathname.replace(/\/$/, '') || '/';
				
				if (currentPath === linkPath) {
					e.preventDefault();
				}
			});
		});
	}
	
	function initCursor() {
		const cursor = document.getElementById('cursor');
		if (!cursor || window.innerWidth < 768) return;
		
		const dot = cursor.querySelector('.cursor-dot') as HTMLElement | null;
		const ring = cursor.querySelector('.cursor-ring') as HTMLElement | null;
		
		let mx = 0, my = 0;
		let dx = 0, dy = 0;
		let rx = 0, ry = 0;
		
		function loop() {
			dx += (mx - dx) * 0.15;
			dy += (my - dy) * 0.15;
			rx += (mx - rx) * 0.08;
			ry += (my - ry) * 0.08;
			
			if (dot) {
				dot.style.left = dx + 'px';
				dot.style.top = dy + 'px';
			}
			if (ring) {
				ring.style.left = rx + 'px';
				ring.style.top = ry + 'px';
			}
			
			requestAnimationFrame(loop);
		}
		loop();
		
		document.addEventListener('mousemove', (e) => {
			mx = e.clientX;
			my = e.clientY;
		});
		
		document.querySelectorAll('a, button').forEach(el => {
			el.addEventListener('mouseenter', () => cursor.classList.add('hover'));
			el.addEventListener('mouseleave', () => cursor.classList.remove('hover'));
		});

		// Hide cursor when modal opens, show when it closes
		window.addEventListener('modal-toggle', (e: any) => {
			if (e.detail?.open) {
				cursor.style.opacity = '0';
				cursor.style.transition = 'opacity 0.15s';
			} else {
				// Sync position instantly so it doesn't "jump" on reappear
				dx = mx; dy = my;
				rx = mx; ry = my;
				cursor.style.opacity = '1';
			}
		});
	}
	
	function initMobileMenu() {
		const burger = document.getElementById('burger');
		const menu = document.getElementById('mobile-menu');
		
		burger?.addEventListener('click', () => {
			menu?.classList.toggle('active');
		});
		
		menu?.querySelectorAll('a').forEach(link => {
			link.addEventListener('click', () => {
				menu?.classList.remove('active');
			});
		});
	}
</script>
