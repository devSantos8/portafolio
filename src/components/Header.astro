---
---

<header class="fixed top-2 sm:top-4 left-1/2 -translate-x-1/2 z-50 w-[95%] sm:w-auto transition-all duration-300" id="header">
    <nav class="flex flex-row items-center justify-center w-full mx-auto py-3 px-4 sm:px-8 rounded-full backdrop-blur-md bg-black/5 dark:bg-black/5 border border-black/10 dark:border-white/10">
        <div class="flex items-center gap-x-4 sm:gap-x-6 text-[13px] sm:text-sm">
            <a href="#top" class="text-black dark:text-white hover:text-blue-300 transition-colors">Inicio</a>
            <a href="#Proyectos" class="text-black dark:text-white hover:text-blue-300 transition-colors">Proyectos</a>
            <a href="#Sobre-mi" class="text-black dark:text-white hover:text-blue-300 transition-colors">Sobre mi</a>
            <a href="#Habilidades" class="text-black dark:text-white hover:text-blue-300 transition-colors">Habilidades</a>
            <button id="theme-toggle" class="relative w-6 h-6 hover:scale-110 transition-all ml-1 sm:ml-0">
                {/* Icono del Sol */}
                <span id="sun-icon" class="absolute inset-0 transition-all duration-300 dark:opacity-100 opacity-0 text-black dark:text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
                    </svg>
                </span>
                {/* Icono de la Luna */}
                <span id="moon-icon" class="absolute inset-0 transition-all duration-300 dark:opacity-0 opacity-100 text-black dark:text-white">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
                    </svg>
                </span>
            </button>
        </div>
    </nav>
</header>

<script>
    const header = document.getElementById('header');
    const nav = header?.querySelector('nav');

    window.addEventListener('scroll', () => {
        const currentScroll = window.scrollY;
        
        if (nav) {
            // Si estamos al inicio de la página (considerando un pequeño margen)
            if (currentScroll < 100) {
                nav.classList.remove('backdrop-blur-md', 'bg-black/5', 'dark:bg-black/5', 'border');
            } else {
                nav.classList.add('backdrop-blur-md', 'bg-black/5', 'dark:bg-black/5', 'border');
            }
        }
    });

    const themeToggle = document.getElementById('theme-toggle');
    
    // Inicializar tema
    const savedTheme = localStorage.getItem('theme') || 
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    
    document.documentElement.classList.toggle('dark', savedTheme === 'dark');

    themeToggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');

        // Forzar un reflow para asegurar que las animaciones se ejecuten
        void themeToggle.offsetHeight;
    });
</script>

<style>
    #theme-toggle {
        transform-style: preserve-3d;
    }

    #theme-toggle span {
        pointer-events: none;
    }

    #theme-toggle:hover {
        color: #60A5FA;
    }
</style>

