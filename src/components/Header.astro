---
const navButtonClass = 'nav-link text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 hover:bg-neutral-100/80 dark:hover:bg-neutral-800/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary/60 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-50 dark:focus-visible:ring-offset-neutral-950 px-4 py-2.5 rounded-full transition-all duration-300';
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 -translate-y-full opacity-0" id="header">
    <div class="flex justify-center w-full px-4 pt-4">
        <nav id="main-nav" class="flex items-center gap-1 px-2 py-2 rounded-full bg-white/80 dark:bg-neutral-900/80 backdrop-blur-xl border border-neutral-200/60 dark:border-neutral-700/60 shadow-lg shadow-black/5 dark:shadow-black/20 transition-all duration-500">
            <a href="#top" class="text-sm font-bold tracking-[0.1em] text-neutral-900 dark:text-white hover:text-brand-primary dark:hover:text-brand-primary transition-colors duration-300 px-4 py-2">
                JMS
            </a>
            
            <div class="w-[1px] h-4 bg-neutral-200 dark:bg-neutral-700 mx-1 hidden md:block"></div>

            <div class="hidden md:flex items-center gap-0.5 text-[11px] font-semibold uppercase tracking-[0.15em]">
                <a href="#Experiencia" data-section-link="Experiencia" class={navButtonClass}>
                    Experiencia
                </a>
                <a href="#Proyectos" data-section-link="Proyectos" class={navButtonClass}>
                    Proyectos
                </a>
                <a href="#Sobre-mi" data-section-link="Sobre-mi" class={navButtonClass}>
                    Sobre mí
                </a>
                <a href="#Habilidades" data-section-link="Habilidades" class={navButtonClass}>
                    Habilidades
                </a>
            </div>

            <div class="w-[1px] h-4 bg-neutral-200 dark:bg-neutral-700 mx-1 hidden md:block"></div>

            <button id="theme-toggle" class="w-10 h-10 flex items-center justify-center text-neutral-600 dark:text-neutral-400 hover:text-brand-primary dark:hover:text-brand-primary hover:bg-neutral-100/80 dark:hover:bg-neutral-800/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary/60 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-50 dark:focus-visible:ring-offset-neutral-950 rounded-full transition-all duration-300">
                <span id="sun-icon" class="hidden dark:block">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="4"/>
                        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
                    </svg>
                </span>
                <span id="moon-icon" class="block dark:hidden">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                    </svg>
                </span>
            </button>
        </nav>
    </div>
</header>

<script>
    const header = document.getElementById('header');
    const nav = document.getElementById('main-nav');
    const navLinks = Array.from(document.querySelectorAll('[data-section-link]'));

    const setActiveNavLink = (id: string) => {
        navLinks.forEach((link) => {
            const isActive = link.getAttribute('data-section-link') === id;
            link.classList.toggle('bg-neutral-900', isActive);
            link.classList.toggle('text-white', isActive);
            link.classList.toggle('dark:bg-neutral-100', isActive);
            link.classList.toggle('dark:text-neutral-950', isActive);
            link.classList.toggle('shadow-sm', isActive);
            link.classList.toggle('shadow-black/10', isActive);
            link.classList.toggle('dark:shadow-neutral-100/10', isActive);
            link.setAttribute('aria-current', isActive ? 'page' : 'false');
        });
    };

    const sectionIds = ['Experiencia', 'Proyectos', 'Sobre-mi', 'Habilidades'];
    const observedSections = sectionIds
        .map((id) => document.getElementById(id))
        .filter((section): section is HTMLElement => section !== null);

    const updateActiveFromScroll = () => {
        if (observedSections.length === 0) {
            return;
        }

        let activeId = observedSections[0].id;
        const triggerPoint = window.innerHeight * 0.4; // 40% de la pantalla desde arriba

        observedSections.forEach((section) => {
            const rect = section.getBoundingClientRect();
            // Si la parte superior de la sección superó el punto de gatillo, la consideramos activa
            if (rect.top <= triggerPoint) {
                activeId = section.id;
            }
        });

        const nearBottom = window.innerHeight + window.scrollY >= document.body.offsetHeight - 10;
        if (nearBottom) {
            activeId = observedSections[observedSections.length - 1].id;
        }

        setActiveNavLink(activeId);
    };

    navLinks.forEach((link) => {
        link.addEventListener('click', (e) => {
            e.preventDefault(); // Evitamos el salto instantáneo del navegador que rompe GSAP/Lenis
            
            const id = link.getAttribute('data-section-link');
            if (id) {
                setActiveNavLink(id);
                // Si Lenis está disponible (cargado en animations.js), lo usamos para un scroll fluido perfecto
                if ((window as any).lenis) {
                    (window as any).lenis.scrollTo(`#${id}`, { offset: -50, duration: 1.2 });
                } else {
                    document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' });
                }
            }
        });
    });

    // Delegamos el volver arriba con Lenis también
    const logoLink = document.querySelector('a[href="#top"]');
    logoLink?.addEventListener('click', (e) => {
        e.preventDefault();
        if ((window as any).lenis) {
            (window as any).lenis.scrollTo(0, { duration: 1.2 });
        } else {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    });

    window.addEventListener('scroll', () => {
        const currentScroll = window.scrollY;
        
        if (header) {
            if (currentScroll > 150) {
                header.classList.remove('-translate-y-full', 'opacity-0');
                nav?.classList.add('shadow-xl', 'shadow-black/10', 'dark:shadow-black/35', 'border-neutral-300/80', 'dark:border-neutral-700/50');
            } else {
                header.classList.add('-translate-y-full', 'opacity-0');
                nav?.classList.remove('shadow-xl', 'shadow-black/10', 'dark:shadow-black/35', 'border-neutral-300/80', 'dark:border-neutral-700/50');
            }
        }
        updateActiveFromScroll();
    }, { passive: true });

    setActiveNavLink('Experiencia');
    updateActiveFromScroll();

    const themeToggle = document.getElementById('theme-toggle');
    
    const savedTheme = localStorage.getItem('theme') || 
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    
    document.documentElement.classList.toggle('dark', savedTheme === 'dark');

    themeToggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
</script>
