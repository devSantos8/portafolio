---
import Nav from './Nav.astro';
---

<header id="main-header" class="fixed top-16 left-0 w-full px-6 md:px-10 lg:px-16 z-50 pointer-events-none flex justify-between items-start transition-all duration-500 text-white opacity-100">
	<!-- Logo Izquierda -->
	<div class="pointer-events-auto">
		<a href="/" class="text-xl md:text-2xl font-bold tracking-tighter uppercase transition-opacity hover:opacity-70 flex items-center gap-2">
			Joain <span class="font-light italic font-serif">Santos</span>
		</a>
	</div>
	
	<!-- Navegación Derecha (Componente Modular) -->
	<Nav />
</header>

<script>
	function initHeaderScroll() {
		const header = document.getElementById('main-header');
		if (!header) return;

		let lastScrollY = window.scrollY;
		let ticking = false;

		const handleScroll = () => {
			if (ticking) return;
			ticking = true;

			requestAnimationFrame(() => {
				const currentScrollY = window.scrollY;
				const path = window.location.pathname;
				const isProjectsOrProfile = path.includes('/projects') || path.includes('/profile');
				const isLightProjectHero = path.includes('/projects/tuki') || 
				                           path.includes('/projects/commitflow') || 
				                           path.includes('/projects/lubricentro');
				const scrollThreshold = isProjectsOrProfile ? 50 : window.innerHeight * 0.8;

				// Calculate all state first (read phase)
				const isScrolled = currentScrollY > scrollThreshold;
				const isHidden = !isProjectsOrProfile && currentScrollY > 100 && currentScrollY > lastScrollY;

				// Apply all DOM writes together (write phase)
				header.classList.toggle('is-on-subpage', isProjectsOrProfile);
				header.classList.toggle('is-light-hero', isLightProjectHero);
				header.classList.toggle('is-scrolled', isScrolled);
				header.classList.toggle('is-hidden', isHidden);
				header.classList.toggle('opacity-0', isHidden);
				header.classList.toggle('opacity-100', !isHidden);

				lastScrollY = currentScrollY;
				ticking = false;
			});
		};

		window.addEventListener('scroll', handleScroll, { passive: true });
		handleScroll(); // Trigger inicial
	}

	// Ejecutar al cargar la página (con o sin ViewTransitions)
	document.addEventListener('astro:page-load', () => {
		initHeaderScroll();
	});
</script>

<style>
	#main-header.is-hidden,
	#main-header.is-hidden * {
		pointer-events: none !important;
	}

	/* Color por defecto del Header (en Hero): siempre Blanco */
	#main-header {
		color: #ffffff;
	}

	/* --- MODO CLARO --- */
	/* Si estamos en subpáginas (proyectos o perfil), el color de texto inicial debe ser oscuro */
	html:not(.dark) #main-header.is-on-subpage {
		color: #111827; /* text-gray-900 */
	}

	/* --- MODO OSCURO --- */
	/* Si estamos en un proyecto con Hero de fondo claro (Tuki, CommitFlow, Lubricentro), 
	   el color inicial sin scroll debe ser oscuro para ser visible sobre la marca. */
	html.dark #main-header.is-light-hero:not(.is-scrolled) {
		color: #111827; /* text-zinc-900 */
	}

	/* Al scrollear fuera del Hero del proyecto claro en Dark Mode, la página se vuelve negra,
	   por lo que el header debe volver a ser blanco para ser visible. */
	html.dark #main-header.is-light-hero.is-scrolled {
		color: #ffffff;
	}

	/* --- GENERALES DE SCROLL --- */
	/* Modo Claro al scrollear: siempre Gris Oscuro */
	html:not(.dark) #main-header.is-scrolled {
		color: #111827;
	}

	/* Modo Oscuro al scrollear: siempre Blanco */
	html.dark #main-header.is-scrolled {
		color: #ffffff;
	}
</style>
