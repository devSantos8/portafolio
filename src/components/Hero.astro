---
import MeshBackground from './react/MeshBackground.jsx';
---
<section id="hero" class="h-[calc(100vh-2rem)] w-[calc(100%-2rem)] mx-auto mt-4 rounded-[3rem] flex flex-col justify-center px-6 sm:px-12 md:px-24 relative overflow-hidden">
    <MeshBackground client:load />
    
    <div class="relative z-10 max-w-7xl mx-auto w-full">
        <p class="text-gray-200 mb-6 text-lg md:text-xl hero-element font-medium tracking-wide flex items-center gap-3">
            <span class="w-8 h-[1px] bg-white/50"></span>
            ¡Hola! Soy Joain M. Santos,
        </p>
        <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tighter leading-[1] max-w-5xl hero-element uppercase text-white drop-shadow-lg">
            Ingeniero en Informática & <span class="text-white italic font-serif font-light lowercase drop-shadow-md">FullStack</span> Developer.
        </h1>
        <p class="mt-8 text-lg sm:text-xl text-white/90 max-w-2xl hero-element drop-shadow-md leading-relaxed">
            Enfocado en el desarrollo de soluciones eficientes y la calidad de software. Desde la planificación inicial hasta la resolución de problemas reales, con pasión por el ecosistema web y la IA (vibe coding).
        </p>
        <div class="mt-12 hero-element">
            <button class="px-8 py-4 rounded-full border border-white/20 bg-black/20 backdrop-blur-sm hover:bg-white hover:text-black transition-colors duration-300 font-medium text-white shadow-xl">
                Ver Proyectos
            </button>
        </div>
    </div>
</section>
