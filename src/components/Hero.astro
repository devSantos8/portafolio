---
// Hero Component (Astro)
---

<section id="top" class="w-full p-3 md:p-4 lg:p-5">
  <div class="relative min-h-[calc(100vh-1.5rem)] md:min-h-[calc(100vh-2rem)] w-full overflow-hidden flex flex-col bg-[#0a0a0a] rounded-[2rem] md:rounded-[3rem] border border-black/10 dark:border-white/10 shadow-2xl">
    {/* Background Video */}
    <video
      autoplay
      loop
      muted
      playsinline
      class="absolute inset-0 w-full h-full object-cover object-center z-0 opacity-80"
      src="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260306_074215_04640ca7-042c-45d6-bb56-58b1e8a42489.mp4"
    ></video>
    
    {/* Overlay */}
    <div class="absolute inset-0 bg-black/50 z-0"></div>

    {/* Internal Minimal Nav */}
    <nav class="absolute top-0 left-0 right-0 w-full flex items-center justify-between px-8 md:px-12 py-8 z-20">
      <div class="text-white font-bold tracking-[0.15em] text-sm">
        JMS
      </div>
      <div class="hidden md:flex items-center gap-8 text-[11px] font-semibold uppercase tracking-[0.2em] text-gray-300">
        <a href="#Proyectos" class="hover:text-[#DC2626] transition-colors duration-300">Proyectos</a>
        <a href="#Sobre-mi" class="hover:text-[#DC2626] transition-colors duration-300">Sobre mí</a>
        <a href="#Habilidades" class="hover:text-[#DC2626] transition-colors duration-300">Habilidades</a>
        <a href="#Contacto" class="hover:text-[#DC2626] transition-colors duration-300">Contacto</a>
      </div>
      <div class="w-5 hidden md:block"></div>
    </nav>

    {/* Foreground Content */}
    <div class="relative z-10 flex flex-col items-center justify-center min-h-full grow w-full px-6 md:px-16 py-20">
      
      <div class="max-w-4xl mx-auto w-full text-center md:text-left flex flex-col items-center md:items-start">
        <p class="animate-fade-up text-[11px] font-bold uppercase tracking-[0.3em] text-[#DC2626] mb-4 md:mb-6">
          Software & DevOps.
        </p>
        <h1 class="animate-fade-up-delay-1 text-[clamp(2.5rem,7vw,4.5rem)] font-bold text-white leading-[1.05] mb-6 md:mb-8 tracking-tighter">
          Joain Monroy Santos<br/>
          <span class="text-gray-400">Full Stack Developer</span>
        </h1>
        <p class="animate-fade-up-delay-2 text-base md:text-xl text-gray-300 max-w-lg leading-relaxed mb-12 font-light">
          Ingeniero en Informática especializado en soluciones robustas, 
          escalables y de alto rendimiento. Donde otros ven problemas, yo diseño sistemas.
        </p>
        
        <nav class="animate-fade-up-delay-3 flex flex-wrap justify-center md:justify-start gap-4">
          <a href="#Proyectos" 
             class="inline-flex items-center gap-2 px-6 py-3.5 bg-white text-gray-900 text-xs font-bold uppercase tracking-widest rounded-full hover:bg-[#DC2626] hover:text-white transition-all duration-300">
            Ver Proyectos
          </a>
          <a href="https://github.com/17santo" target="_blank" rel="noopener"
             class="inline-flex items-center gap-2 px-6 py-3.5 bg-transparent border border-white/20 text-white hover:bg-white/10 hover:border-white/40 text-xs font-bold uppercase tracking-widest rounded-full transition-all duration-300">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            GitHub
          </a>
          <a href="https://www.linkedin.com/in/jmonroys17/" target="_blank" rel="noopener"
             class="inline-flex items-center gap-2 px-6 py-3.5 bg-transparent border border-white/20 text-white hover:bg-white/10 hover:border-white/40 text-xs font-bold uppercase tracking-widest rounded-full transition-all duration-300">
            LinkedIn
          </a>
        </nav>
      </div>

    </div>
  </div>
</section>
