---
interface Props {
  name: string;
  delay?: number;
}

const { name, delay = 0 } = Astro.props;
---

<div 
  class="skill-item group flex items-center gap-4 py-3 cursor-default
         border-b border-transparent hover:border-gray-100 dark:hover:border-white/5
         transition-all duration-300"
  style={`--delay: ${delay}ms`}
>
  <div class="relative w-9 h-9 flex items-center justify-center
              text-gray-400 dark:text-gray-500 
              group-hover:text-[#DC2626]
              transition-colors duration-300">
    <slot />
  </div>
  
  <span class="text-[13px] text-gray-600 dark:text-gray-400
               group-hover:text-gray-900 dark:group-hover:text-white
               transition-colors duration-300">
    {name}
  </span>
  
  <div class="ml-auto w-0 group-hover:w-4 h-px bg-[#DC2626]/50 
              transition-all duration-300 origin-left"></div>
</div>

<style>
  .skill-item {
    opacity: 0;
    transform: translateY(10px);
    animation: skillFadeIn 0.4s ease-out forwards;
    animation-delay: var(--delay);
  }

  @keyframes skillFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

