---
interface Props {
  name: string;
  level: "Básico" | "Competente" | "Intermedio" | "Avanzado" | "Experto";
  color: string;
}

const { name, level, color } = Astro.props;

const levelToPercentage = {
  Básico: "20%",
  Competente: "40%",
  Intermedio: "60%",
  Avanzado: "80%",
  Experto: "95%",
};
---

<li class="relative">
  <div class="flex justify-between mb-2">
    <span class="text-sm font-medium text-black/70 dark:text-white/70">{name}</span>
    <span class={`text-sm font-medium ${color}/90`}>{level}</span>
  </div>
  <div class="w-full bg-neutral-200 rounded-full h-1.5 dark:bg-neutral-700">
    <div 
      class={`${color} h-1.5 rounded-full transition-all duration-300`} 
      style={`width: ${levelToPercentage[level]}`}
    >
    </div>
  </div>
</li>
