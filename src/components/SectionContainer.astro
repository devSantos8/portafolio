---
const { class: className, id, bg } = Astro.props
---

{bg ? (
    <div class={bg}>
        <section id={id} class={`w-full mx-auto px-8 md:px-16 lg:px-24 xl:px-32 max-w-7xl ${className || ''}`}> 
            <slot />
        </section>
    </div>
) : (
    <section id={id} class={`w-full mx-auto px-8 md:px-16 lg:px-24 xl:px-32 max-w-7xl ${className || ''}`}> 
        <slot />
    </section>
)}