<footer
    class="bg-gray-100 dark:bg-[#111] text-gray-900 dark:text-white py-24 px-8 md:px-24 relative z-20 rounded-t-[3rem] mt-32 transition-colors duration-500"
>
    <div class="max-w-7xl mx-auto">
        <span class="text-sm uppercase tracking-widest opacity-50 mb-12 block"
            >→ Contacto</span
        >

        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-8 mb-24">
            <div>
                <h2
                    class="text-5xl md:text-7xl font-bold tracking-tighter mb-8"
                >
                    Adaptarse<br />para avanzar
                </h2>
                <a
                    href="mailto:joainmonroy12@gmail.com"
                    class="text-xl md:text-2xl hover:text-rose-500 transition-colors border-b border-white/20 pb-2"
                >
                    joainmonroy12@gmail.com
                </a>
            </div>

            <div class="flex flex-col gap-12 md:pl-20">
                <div>
                    <span
                        class="text-sm uppercase tracking-widest opacity-50 block mb-4"
