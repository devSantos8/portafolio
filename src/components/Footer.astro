                            href="https://github.com/17santo"
                            target="_blank"
                            class="text-xl hover:text-rose-500 transition-colors"
                            >Github ↗</a
                        >
                        <a
                            href="https://www.linkedin.com/in/jmonroys17"
                            target="_blank"
                            class="text-xl hover:text-rose-500 transition-colors"
                            >LinkedIn ↗</a
                        >
                    </div>
                </div>
            </div>
        </div>

        <div
            class="flex flex-col md:flex-row justify-between items-center pt-8 border-t border-white/10 text-sm opacity-50"
        >
            <span>© {new Date().getFullYear()} Joain Santos</span>
            <span>Desde Santiago, Chile</span>
        </div>
    </div>
</footer>
