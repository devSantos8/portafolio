---
const PROJECTS = [
  {
    title: "CommitFlow",
    badge: "Proyecto de Título",
    description: "Plataforma que conecta profesionales y empresas TI. Sistema de perfiles, búsqueda avanzada y gestión de ofertas laborales.",
    tags: ["Django", "Python", "JavaScript", "PostgreSQL"],
    image: "../projects/workco.webp",
    github: "",
    link: "",
    featured: true
  },
  {
    title: "Dashboard E-commerce",
    description: "Panel de control para análisis de usuarios registrados y gestión de usuarios con visualización de datos en tiempo real.",
    tags: ["Django", "Python", "JavaScript", "CSS"],
    image: "../projects/dashboard.webp",
    github: "",
    link: "",
    featured: false
  },
  {
    title: "Lubricentro La Esquina",
    description: "Sitio web Informativo para un negocio de lubricantes y repuestos automotrices ubicado en la comuna de San Joaquín, Santiago.",
    tags: ["Tailwind CSS", "JavaScript", "Astro"],
    image: "../projects/lubricentro.webp",
    github: "",
    link: "https://lubricentro-la-esquina.vercel.app",
    featured: false
  },
];

const getTagColor = (tag: string) => {
  const colorMap: Record<string, string> = {
    "Django": "from-purple-500/10 to-purple-500/5 border-purple-300 dark:border-purple-500/30 text-purple-700 dark:text-purple-300",
    "Python": "from-yellow-500/10 to-yellow-500/5 border-yellow-300 dark:border-yellow-500/30 text-yellow-700 dark:text-yellow-300",
    "JavaScript": "from-yellow-300/10 to-yellow-300/5 border-yellow-300 dark:border-yellow-500/30 text-yellow-700 dark:text-yellow-300",
    "PostgreSQL": "from-blue-500/10 to-blue-500/5 border-blue-300 dark:border-blue-500/30 text-blue-700 dark:text-blue-300",
    "CSS": "from-orange-500/10 to-orange-500/5 border-orange-300 dark:border-orange-500/30 text-orange-700 dark:text-orange-300",
    "Tailwind CSS": "from-cyan-500/10 to-cyan-500/5 border-cyan-300 dark:border-cyan-500/30 text-cyan-700 dark:text-cyan-300",
    "Astro": "from-red-500/10 to-red-500/5 border-red-300 dark:border-red-500/30 text-red-700 dark:text-red-300",
  };
  return colorMap[tag] || "from-gray-500/10 to-gray-500/5 border-gray-300 dark:border-gray-500/30 text-gray-700 dark:text-gray-300";
};
---

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  .project-item {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .project-item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .project-card {
    position: relative;
    height: 380px;
    overflow: hidden;
    border-radius: 1.5rem;
    border: 1px solid rgba(0,0,0,0.08);
    box-shadow: 0 4px 6px rgba(0,0,0,0.07), 
                0 10px 20px rgba(0,0,0,0.08);
    transition: all 0.5s cubic-bezier(0.23, 1, 0.320, 1);
    background: linear-gradient(135deg, rgba(255,255,255,0.9) 0%, rgba(250,250,250,0.5) 100%);
    cursor: pointer;
  }

  :global(.dark) .project-card {
    border-color: rgba(255,255,255,0.1);
    background: linear-gradient(135deg, rgba(25,25,25,0.95) 0%, rgba(20,20,20,0.6) 100%);
    box-shadow: 0 4px 6px rgba(0,0,0,0.3), 
                0 10px 20px rgba(0,0,0,0.4);
  }

  .project-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), 
                filter 0.6s ease;
  }

  .project-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem;
    background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.4) 60%, transparent 100%);
    transform: translateY(40px);
    transition: transform 0.5s cubic-bezier(0.23, 1, 0.320, 1);
    z-index: 10;
  }

  .project-item:hover .project-content {
    transform: translateY(0);
  }

  .project-item:hover .project-image {
    transform: scale(1.08) brightness(0.6);
  }

  .project-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 0%, rgba(0,0,0,0.1) 100%);
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
    z-index: 5;
  }

  .project-item:hover .project-card {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.12),
                0 12px 24px rgba(220,38,38,0.1);
  }

  :global(.dark) .project-item:hover .project-card {
    box-shadow: 0 20px 40px rgba(0,0,0,0.5),
                0 12px 24px rgba(220,38,38,0.15);
  }

  .project-item:hover .project-card::before {
    opacity: 1;
  }

  .tag {
    background: linear-gradient(135deg, var(--tag-bg-from) 0%, var(--tag-bg-to) 100%);
    transition: all 0.3s ease;
    display: inline-block;
  }

  .tag:hover {
    transform: translateY(-2px);
  }
</style>

<div class="projects-grid">
  {
    PROJECTS.map((project, index) => (
      <article class="project-item group">
        <div class="project-card">
          <img
            src={project.image}
            alt={project.title}
            class="project-image"
          />
          
          <div class="project-content">
            {project.featured && project.badge && (
              <div class="inline-block mb-2">
                <p class="text-[10px] font-bold uppercase tracking-[0.3em] text-red-400">
                  ★ {project.badge}
                </p>
              </div>
            )}
            
            <h3 class="text-2xl md:text-3xl font-bold text-white mb-2 leading-tight">
              {project.title}
            </h3>
            
            <p class="text-sm text-gray-300 leading-relaxed mb-4 line-clamp-2">
              {project.description}
            </p>

            <div class="flex flex-wrap gap-1.5 mb-4">
              {project.tags.slice(0, 2).map((tag) => {
                const colors = getTagColor(tag);
                return (
                  <span 
                    class={`tag text-[9px] font-semibold tracking-wider px-2 py-1 bg-gradient-to-r ${colors} rounded-full border`}
                  >
                    {tag}
                  </span>
                );
              })}
              {project.tags.length > 2 && (
                <span class="text-[9px] font-semibold text-gray-300 px-2 py-1">
                  +{project.tags.length - 2}
                </span>
              )}
            </div>

            <div class="flex gap-4 pt-3 border-t border-gray-500/30">
              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener"
                  class="text-xs font-bold uppercase tracking-wider text-gray-300 hover:text-red-400 transition-colors duration-300 flex items-center gap-1.5"
                >
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                  Código
                </a>
              )}
              {project.link && (
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener"
                  class="text-xs font-bold uppercase tracking-wider text-gray-300 hover:text-red-400 transition-colors duration-300 flex items-center gap-1.5"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.658 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                  </svg>
                  Ver
                </a>
              )}
            </div>
          </div>
        </div>
      </article>
    ))
  }
</div>

<script>
  const projectObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.project-item').forEach(item => {
    projectObserver.observe(item);
  });
</script>