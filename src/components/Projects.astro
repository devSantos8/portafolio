---
const TAGS_COLORS = {
  Django: "bg-green-500/10 text-green-400 border-green-500/20",
  Python: "bg-blue-500/10 text-blue-400 border-blue-500/20",
  JavaScript: "bg-yellow-500/10 text-yellow-400 border-yellow-500/20",
  PostgreSQL: "bg-blue-400/10 text-blue-300 border-blue-400/20",
  "Next.js": "bg-black/20 text-white/90 border-white/20",
  "Tailwind CSS": "bg-cyan-500/10 text-cyan-400 border-cyan-500/20",
  Redux: "bg-purple-500/10 text-purple-400 border-purple-500/20"
} as const;

const PROJECTS = [
  {
    title: "WorkConnect - Plataforma TI",
    description: "Plataforma que conecta profesionales y empresas TI. Sistema de perfiles, búsqueda avanzada y gestión de ofertas laborales.",
    tags: ["Django", "Python", "JavaScript", "PostgreSQL"],
    image: "../projects/workco.webp",
    github: "",
    link: ""
  },
  {
    title: "Dashboard E-commerce",
    description: "Panel de control para análisis de usuarios registrados y gestión de usuarios con visualización de datos en tiempo real.",
    tags: ["Django", "Python", "JavaScript", "CSS"],
    image: "../projects/dashboard.webp",
    github: "",
    link: ""
  },
  {
    title: "Lubricentro La Esquina",
    description: "Sitio web Informativo para un negocio de lubricantes y repuestos automotrices ubicado en la comunda de San Joaquin, santiago.",
    tags: ["Tailwind CSS", "JavaScript", "Astro"],
    image: "../projects/lubricentro.webp",
    github: "",
    link: "https://lubricentro-la-esquina.vercel.app"
  },
];
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map((project, index) => (
      <article class={`flex flex-col md:flex-row gap-8 ${index % 2 === 1 ? 'md:flex-row-reverse' : ''}`}>
        <div class="flex-1">
          <img
            src={project.image}
            alt={`Captura de pantalla del proyecto ${project.title}`}
            class="rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 object-cover w-full h-[200px] aspect-video"
          />
        </div>

        <div class="flex-1 flex flex-col justify-between py-2">
          <div>
            <h3 class="text-2xl font-bold text-black dark:text-white/90 mb-2">{project.title}</h3>
            
            <div class="flex gap-2 flex-wrap mb-4">
              {project.tags.map((tag) => (
                <span class={`text-xs font-medium border rounded-full px-2.5 py-0.5 ${TAGS_COLORS[tag as keyof typeof TAGS_COLORS] ?? "bg-gray-800 text-white/80"}`}>
                  {tag}
                </span>
              ))}
            </div>

            <p class="text-black/80 dark:text-gray-300/80 text-sm leading-relaxed">
              {project.description}
            </p>
          </div>

          <footer class="flex gap-x-4 mt-4">
            <a
              href={project.github}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 px-4 py-1 text-xs font-medium bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 rounded-full hover:bg-black/10 dark:hover:bg-white/10 hover:scale-105 transition-all duration-200"
            >
              <svg class="size-4" viewBox="0 0 24 24">
                <path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
              </svg>
              Codigo
            </a>
            <a
              href={project.link}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 px-4 py-1 text-xs font-medium bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 rounded-full hover:bg-black/10 dark:hover:bg-white/10 hover:scale-105 transition-all duration-200"
            >
              <svg class="size-4" viewBox="0 0 24 24">
                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
              Ver proyecto
            </a>
          </footer>
        </div>
      </article>
    ))
  }
</div>