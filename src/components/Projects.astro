---
const PROJECTS = [
  {
    title: "CommitFlow",
    badge: "Proyecto de Título",
    description: "Plataforma que conecta profesionales y empresas TI. Sistema de perfiles, búsqueda avanzada y gestión de ofertas laborales.",
    tags: ["Django", "Python", "JavaScript", "PostgreSQL"],
    image: "../projects/workco.webp",
    github: "",
    link: "",
    featured: true
  },
  {
    title: "Dashboard E-commerce",
    description: "Panel de control para análisis de usuarios registrados y gestión de usuarios con visualización de datos en tiempo real.",
    tags: ["Django", "Python", "JavaScript", "CSS"],
    image: "../projects/dashboard.webp",
    github: "",
    link: "",
    featured: false
  },
  {
    title: "Lubricentro La Esquina",
    description: "Sitio web Informativo para un negocio de lubricantes y repuestos automotrices ubicado en la comuna de San Joaquín, Santiago.",
    tags: ["Tailwind CSS", "JavaScript", "Astro"],
    image: "../projects/lubricentro.webp",
    github: "",
    link: "https://lubricentro-la-esquina.vercel.app",
    featured: false
  },
];
---

<style>
  .project-item {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .project-item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .project-image {
    transition: transform 0.6s ease;
  }

  .project-item:hover .project-image {
    transform: scale(1.03);
  }

  .project-card {
    background: linear-gradient(135deg, rgba(250,250,250,0.8) 0%, rgba(245,245,245,0.4) 100%);
  }

  :global(.dark) .project-card {
    background: linear-gradient(135deg, rgba(20,20,20,0.8) 0%, rgba(15,15,15,0.4) 100%);
  }
</style>

<div class="space-y-8">
  {
    PROJECTS.map((project, index) => (
      <article class="project-item group">
        <div class="project-card rounded-3xl border border-gray-200/80 dark:border-white/10 overflow-hidden hover:border-[#DC2626]/30 transition-all duration-500">
          <div class="grid grid-cols-1 lg:grid-cols-2">
            <div class={`overflow-hidden ${index % 2 === 1 ? 'lg:order-2' : ''}`}>
              <img
                src={project.image}
                alt={project.title}
                class="project-image w-full h-[260px] md:h-[320px] object-cover"
              />
            </div>

            <div class={`p-8 md:p-10 flex flex-col justify-center ${index % 2 === 1 ? 'lg:order-1' : ''}`}>
              {project.featured && project.badge && (
                <p class="text-[10px] font-bold uppercase tracking-[0.3em] text-[#DC2626] mb-4">
                  {project.badge}
                </p>
              )}
              
              <h3 class="text-2xl md:text-3xl font-medium text-gray-900 dark:text-white tracking-tight leading-tight mb-4">
                {project.title}
              </h3>
              
              <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed mb-6">
                {project.description}
              </p>

              <div class="flex flex-wrap gap-2 mb-8">
                {project.tags.map((tag) => (
                  <span class="text-[10px] font-medium tracking-wide text-gray-500 dark:text-gray-400 px-3 py-1.5 bg-gray-100 dark:bg-white/5 rounded-full border border-gray-200 dark:border-white/10">
                    {tag}
                  </span>
                ))}
              </div>

              <div class="flex gap-6 mt-auto">
                {project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener"
                    class="group/link flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.15em] text-gray-500 dark:text-gray-400 hover:text-[#DC2626] transition-colors duration-300"
                  >
                    Código
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                  </a>
                )}
                {project.link && (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener"
                    class="group/link flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.15em] text-gray-500 dark:text-gray-400 hover:text-[#DC2626] transition-colors duration-300"
                  >
                    Ver proyecto
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>
      </article>
    ))
  }
</div>

<script>
  const projectObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.project-item').forEach(item => {
    projectObserver.observe(item);
  });
</script>