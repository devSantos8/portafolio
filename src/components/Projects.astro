---
const PROJECTS = [
  {
    title: "CommitFlow",
    badge: "Proyecto de Título",
    description: "Plataforma que conecta profesionales y empresas TI. Sistema de perfiles, búsqueda avanzada y gestión de ofertas laborales.",
    tags: ["Django", "Python", "JavaScript", "PostgreSQL"],
    image: "../projects/workco.webp",
    github: "",
    link: "",
    featured: true
  },
  {
    title: "Dashboard E-commerce",
    description: "Panel de control para análisis de usuarios registrados y gestión de usuarios con visualización de datos en tiempo real.",
    tags: ["Django", "Python", "JavaScript", "CSS"],
    image: "../projects/dashboard.webp",
    github: "",
    link: "",
    featured: false
  },
  {
    title: "Lubricentro La Esquina",
    description: "Sitio web Informativo para un negocio de lubricantes y repuestos automotrices ubicado en la comuna de San Joaquín, Santiago.",
    tags: ["Tailwind CSS", "JavaScript", "Astro"],
    image: "../projects/lubricentro.webp",
    github: "",
    link: "https://lubricentro-la-esquina.vercel.app",
    featured: false
  },
];
---

<style>
  .project-item {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .project-item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .project-image {
    transition: transform 0.6s ease;
  }

  .project-item:hover .project-image {
    transform: scale(1.02);
  }
</style>

<div class="space-y-28">
  {
    PROJECTS.map((project, index) => (
      <article class="project-item group">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
          <div class={`overflow-hidden rounded-2xl ${index % 2 === 1 ? 'lg:order-2' : ''}`}>
            <img
              src={project.image}
              alt={project.title}
              class="project-image w-full h-[260px] md:h-[340px] object-cover"
            />
          </div>

          <div class={`space-y-6 ${index % 2 === 1 ? 'lg:order-1' : ''}`}>
            {project.featured && project.badge && (
              <p class="text-[11px] font-medium uppercase tracking-[0.3em] text-blue-600 dark:text-blue-400">
                {project.badge}
              </p>
            )}
            
            <h3 class="text-2xl md:text-3xl font-medium text-black dark:text-white tracking-tight leading-tight">
              {project.title}
            </h3>
            
            <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
              {project.description}
            </p>

            <div class="flex flex-wrap gap-3 pt-2">
              {project.tags.map((tag) => (
                <span class="text-[11px] font-medium tracking-wide text-gray-400 dark:text-gray-500 px-3 py-1 bg-gray-100 dark:bg-white/5 rounded-full">
                  {tag}
                </span>
              ))}
            </div>

            <div class="flex gap-8 pt-4">
              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener"
                  class="group/link flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400 hover:text-black dark:hover:text-white transition-colors duration-500"
                >
                  <span class="w-6 h-[1px] bg-current opacity-0 group-hover/link:opacity-100 transition-opacity duration-500"></span>
                  Código
                </a>
              )}
              {project.link && (
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener"
                  class="group/link flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400 hover:text-black dark:hover:text-white transition-colors duration-500"
                >
                  <span class="w-6 h-[1px] bg-current opacity-0 group-hover/link:opacity-100 transition-opacity duration-500"></span>
                  Ver proyecto
                </a>
              )}
            </div>
          </div>
        </div>
      </article>
    ))
  }
</div>

<script>
  const projectObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.project-item').forEach(item => {
    projectObserver.observe(item);
  });
</script>